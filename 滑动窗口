#include <bits/stdc++.h>

using namespace std;

int main()
{
	int n;
	int k;
	cin>>n>>k;
	vector<long long>vec(n);
	for(int i = 0;i<n;i++)
	{
		cin>>vec[i];
	}
	deque<long long>dq;
	int cnt = 0;
	
	vector<long long>ans1;
	vector<long long>ans2;
	for(int i = 0;i<n;i++)
	{
		while(!dq.empty() && dq.front() <=i-k)
		{
			dq.pop_front();
		}
		while(!dq.empty() && vec[dq.back()] <=vec[i])
		{
			dq.pop_back();	
		}	
		dq.push_back(i);
		if(i >= k-1)
		{
			ans1.push_back(vec[dq.front()]);
		}
	}
	while(!dq.empty())
	{
		dq.pop_back();
	}
	for(int i = 0;i<n;i++)
	{
		while(!dq.empty() && dq.front() <=i-k)
		{
			dq.pop_front();
		}
		while(!dq.empty() && vec[dq.back()] >=vec[i])
		{
			dq.pop_back();	
		}	
		dq.push_back(i);
		if(i >= k-1)
		{
			ans2.push_back(vec[dq.front()]);
		}
	}

	for(int i = 0;i<ans2.size();i++)
	{
		if(i == ans2.size()-1)
		{
			cout<<ans2[i]<<endl;
		}
		else
		{
			cout<<ans2[i]<<" ";
		}
	}
	for(int i = 0;i<ans1.size();i++)
	{
		if(i == ans1.size()-1)
		{
			cout<<ans1[i]<<endl;
		}
		else
		{
			cout<<ans1[i]<<" ";
		}
	}
	
	
	
	return 0;
}
