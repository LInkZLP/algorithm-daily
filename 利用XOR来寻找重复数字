#include<bits/stdc++.h>
using namespace std;

int main()
{
	// a ^ b ^ b = a;
	// 0 ^ a = a
	//100 内某个重复数字 
	vector<int>v(101);
	for(int i = 0;i<101;i++)
	{
		cin>>v[i];
	}
	int x = 0;
	for(int i = 0;i<=100;i++)
	{
		x ^= i;
	}
	//确定范围 
	for(int i = 0;i<=100;i++)
	{
		x ^= v[i];
	}
	cout<<x<<endl;
	return 0;
}
