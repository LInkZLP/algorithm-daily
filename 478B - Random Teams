#include <bits/stdc++.h>
using namespace std;

/*
 * 题目背景：将 n 个人分入 m 支队伍（每队至少 1 人），同队成员两两成为朋友。
 * 设各队人数为 x_i，朋友总数 F = sum( C(x_i, 2) ) = 1/2 * ( sum(x_i^2) - n )。
 * 
 * 一、最大值证明（让朋友对数最多）：
 *    假设存在两支队伍人数分别为 a 和 b，且 a >= b >= 2。
 *    此时我们将 b 队中的 1 人移动到 a 队，变成 a+1 和 b-1。
 *    这种“劫贫济富”导致朋友对数变化量 Δ 为：
 *    Δ = [C(a+1,2) + C(b-1,2)] - [C(a,2) + C(b,2)]
 *      = (a - b + 1) > 0 (因为 a >= b，所以 a-b+1 >= 1)。
 *    结论：只要存在两支人数 >= 2 的队伍，我们就能通过“集中”操作让总朋友数严格增加。
 *    因此，最大值状态下，最多只能有 1 支队伍人数 > 1，其余 m-1 支队伍只能有 1 人。
 *    所以唯一大队伍人数为 n - (m-1)*1 = n - m + 1，
 *    最大朋友对数 F_max = C(n-m+1, 2) = (n-m+1)*(n-m)/2。
 *
 * 二、最小值证明（让朋友对数最少）：
 *    假设存在两支队伍人数分别为 a 和 b，且 a >= b + 2（即人数差至少为 2）。
 *    此时我们将 a 队中的 1 人移动到 b 队，变成 a-1 和 b+1。
 *    这种“劫富济贫”导致朋友对数变化量 Δ 为：
 *    Δ = [C(a-1,2) + C(b+1,2)] - [C(a,2) + C(b,2)]
 *      = 1 - (a - b) < 0 (因为 a-b >= 2，所以 Δ <= -1)。
 *    结论：只要存在两队人数相差 >= 2，我们就能通过“平均”操作让总朋友数严格减少。
 *    重复此操作直到任意两支队伍人数差均 <= 1，即各队人数只能为 r 或 r+1。
 *    设 r = n / m (商)，k = n % m (余数)，
 *    则有 k 支队伍人数为 r+1，剩余 (m-k) 支队伍人数为 r。
 *    最小朋友对数 F_min = k * C(r+1, 2) + (m-k) * C(r, 2)。
 */

int main() {
    long long n;
    long long m;
    cin >> n >> m;
    
    // 虽然题目保证 m <= n，但保留此逻辑可增强代码鲁棒性
    if (n < m) {
        cout << 0 << " " << 0 << endl;
        return 0;
    }
    
    // 计算平均分配参数：r 是基础人数，k 是有 r+1 人的队伍数
    long long k = n % m; // 余数
    long long r = n / m; // 商
    
    // 最小值：平均分配
    long long minFriends = k * (r + 1) * r / 2 + (m - k) * r * (r - 1) / 2;
    
    // 最大值：一支独大
    long long maxFriends = (n - m + 1) * (n - m) / 2;
    
    cout << minFriends << " " << maxFriends << endl;
    
    return 0;
}
