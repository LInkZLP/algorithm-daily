#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 1e5 + 5;
vector<int>cl(maxn,0);
vector<int>col;
vector<int>dep(maxn);
int d;
vector<vector<int>>v(maxn);
int LOG = 23;
vector<vector<int>>up(maxn,vector<int>(LOG,0));
void dfs1(int u,int p)
{
	up[u][0] = p;
	for(int i = 1;i<LOG;i++)
	{
		up[u][i] = up[up[u][i - 1]][i - 1];
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dep[ed] = dep[u] + 1;
		dfs1(ed,u);
	}
	return;
}
int lca(int a,int b)
{
	if(dep[a] < dep[b])
	{
		swap(a,b);
	}
	int dh = dep[a] - dep[b];
	for(int i = LOG - 1;i>=0;i--)
	{
		if(dh & (1<<i))
		{
			a = up[a][i];
		}
	}
	if(a == b)
	{
		return a;
	}
	for(int i = LOG - 1;i>=0;i--)
	{
		if(up[a][i] != up[b][i])
		{
			a = up[a][i];
			b = up[b][i];
		}
	}
	return up[a][0];
}
int dist(int a,int b)
{
	return dep[a] + dep[b] - dep[lca(a,b)] * 2;
}
void solve()
{
	cin>>n>>m>>d;
	for(int i = 1;i<=m;i++)
	{
		int x;
		cin>>x;
		col.push_back(x);
	}
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	int ans = 0;
	dep[1] = 1;
	dfs1(1,0);
	if(m == 1)
	{
		for(int i = 1;i<=n;i++)
		{
			if(dist(col[0],i) <= d)
			{
				ans ++;
			}
		}
		cout<<ans<<endl;
	}
	else
	{
		int c1 = col[0];
		int c2 = col[1];
		int mxl = dist(col[0],col[1]);
		for(int i = 2;i<col.size();i++)
		{
			int nxt = col[i];
			int d1 = dist(nxt,c1);
			int d2 = dist(c2,nxt);
			if(d1 >= d2 && d1 > mxl)
			{
				mxl = d1;
				c2 = nxt;
			}
			if(d2 > d1 && d2 > mxl)
			{
				mxl = d2;
				c1 = nxt;
			}
		}
		if(mxl > 2 * d)
		{
			cout<<0<<endl;
			return;
		}
		for(int i = 1;i<=n;i++)
		{
			if(max(dist(i,c1),dist(i,c2)) <= d)
			{
				ans ++;
			}
		}
		cout<<ans<<endl;
	}
	return ;
}
int main()
{
	int t = 1;
	//cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
