#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 2e5 + 5;
#define pli pair<long long ,int>
vector<vector<pli>>v(maxn);
vector<long long >dp(maxn,LLONG_MIN);
vector<int>cnt(maxn,0);
vector<int>inq(maxn,0);
int pa = 0;
void spfa(int sta)
{
	queue<int>q;
	q.push(sta);
	inq[sta] = 1;
	dp[sta] = 0;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		inq[u] = 0;
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].second;
			if(dp[ed] < dp[u] + v[u][i].first)
			{
				dp[ed] = dp[u] + v[u][i].first;
				if(!inq[ed])
				{
					q.push(ed);
					inq[ed] = 1;
				}
				cnt[ed] ++;
				if(cnt[ed] > n + 5)
				{
					pa = 0;
					return;
				}
			}
		}
	}
	return;
}
void solve()
{
	cin>>n>>m;
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		int c;
		cin>>x>>y>>c;
		x -- ;
		//dy - dx >= x
		//dx + x <= dy;
		v[x].push_back({c,y});
	}
	for(int i = 1;i<=n;i++)
	{
		v[i - 1].push_back({0,i});
		//di - d(i - 1) >= 0
		v[i].push_back({-1,i - 1});
		//di - d(i -1) <= 1
	}
	int T = n + 1;
	for(int i = 0;i<=n;i++)
	{
		v[T].push_back({0,i});
	}
	spfa(T);
	for(int i = 1;i<=n;i++)
	{
		cout<<dp[i] - dp[i - 1]<<" ";
	}
	cout<<endl;
	return ;
}
int main()
{
	int t;
	//cin>>t;
	t = 1;
	while(t--)
	{
		solve();	
	}	
	return 0;
}
