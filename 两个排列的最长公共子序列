#include <bits/stdc++.h>
using namespace std; 
const int maxn = 1e5+5;
vector<int>v1(maxn);
vector<int>tail;
vector<int>pos(maxn);
int n;
int main()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		int x;
		cin>>x;
		v1[x] = i; 
	}
	for(int i = 1;i<=n;i++)
	{
		int x;
		cin>>x;
		pos[i] = v1[x];
	}
	for(int i = 1;i<=n;i++)
	{
		if(tail.empty())
		{
			tail.push_back(pos[i]);
		}
		else
		{
			auto p = lower_bound(tail.begin(),tail.end(),pos[i]);
			if(p == tail.end())
			{
				tail.push_back(pos[i]);
			}
			else
			{
				*p = pos[i];
			}
		}
	}
	//在Pos中，一组递增数据在v1中是它的子序列，因此只需要求pos的LIS就可以 
	cout<<tail.size()<<endl;
	return 0;
}
