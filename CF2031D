#include <bits/stdc++.h>
using namespace std;
int t;
int n;
int main()
{
	cin>>t;
	while(t--)
	{
		cin>>n;
		vector<long long>a(n+5);
		vector<long long>mx(n+5);
		vector<long long>mi(n+5);
		for(int i = 1;i<=n;i++)
		{
			cin>>a[i];
		}
		mx[0] = 0;
		mi[n+1] = 1e18;
		for(int i = 1;i<=n;i++)
		{
			mx[i] = max(mx[i-1],a[i]);
		}
		for(int i = n;i>=1;i--)
		{
			mi[i] = min(mi[i+1],a[i]);
		}
		vector<int>ans(n+5);
		ans[n] = mx[n];
		for(int i = n-1;i>=0;i--)
		{
			if(mx[i] > mi[i+1])
			{
				ans[i] = ans[i+1];
			}
			else
			{
				ans[i] = mx[i];
			}
		}
		for(int i = 1;i<=n;i++)
		{
			cout<<ans[i]<<" ";
		}
		cout<<endl;
	}
	
	
	return 0;
}
