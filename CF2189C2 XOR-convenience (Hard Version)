#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	if((n & (n - 1)) ==0)
	{
		cout<<-1<<endl;
		return ;
	}
	vector<int>ans(n + 5);
	if(n & 1)
	{
		if(n == 3)
		{
			cout<<2<<" "<<1<<" "<<3<<endl;
			return; 
		}
		ans[n] = 1;
		ans[n - 1] = n;
		ans[1] = n - 1;
		for(int i = n- 2;i>=2;i--)
		{
			if(i & 1)
			{
				ans[i] = i - 1;
			}
			else
			{
				ans[i] = i + 1;
			}
		}
	}
	else
	{
		int sta = 1;
		int temp = n;
		int tar = 1;
		while(temp)
		{
			if(temp & 1)
			{
				tar = sta;
				break;
			}
			temp >>= 1;
			sta *= 2;
		}
		ans[n] = n - 2;
		ans[n - 1] = 1;
		for(int i = n - 2;i>=2;i--)
		{
			if(i == tar)
			{
				ans[i] = n;
			}
			else
			{
				ans[i] = 1 ^ i;
			}
		}
		ans[1] = tar + 1;
	}
	for(int i = 1;i<=n;i++)
	{
		cout<<ans[i]<<" ";
	}

	cout<<endl;
	return ;
}
//奇数情况不难构造，我们先规划好三个位置的数，n,n-1,和1，保证了这些成立，剩下的数的数量为偶数，可以不重复来填充
//根据easy version
//偶数情况，我们的目标是n的二进制最低位置的数,先处理四个数，n-1,n,sta,sta + 1的，我们可以保证
//sta ^ n <= n - 2，(sta + 1) ^ 1 = sta ,(n - 1) ^ 1 = n - 2,故我们可以尝试n位置放置n - 2,
//n-1位置放1,sta,和1的位置单独处理，剩下一致 和easy version一样 
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	
	return 0;
}
