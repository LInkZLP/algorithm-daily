#include <bits/stdc++.h>
using namespace std;
int n;
int m;
vector<int>fa(2e5 + 5);
vector<int>a(2e5 + 5);
vector<vector<int>>v;
int find(int x)
{
	if(x == fa[x])
	{
		return x;
	}
	return fa[x] = find(fa[x]);
}
bool Union(int a,int b)
{
	int r1 = find(a);
	int r2 = find(b);
	if(r1 == r2)
	{
		return true;
	}
	fa[r1] = r2;
	return false;
}
int main()
{
	cin>>n;
	unordered_map<int ,int>mp;
	int mx = 0;
	for(int i = 1;i<=n;i++)
	{
		cin>>a[i];
		mp[a[i]] = i;
		mx = max(mx,a[i]);
	}
	v.assign(mx + 2,vector<int>());
	for(int i = 1;i<=n;i++)
	{
		fa[i] = i;
	}
	vector<int>need;
	for(int i = mx;i>=2;i--)
	{
		for(int j = 1;j * i <= mx;j++)
		{
			if(mp.find(i * j) != mp.end())
			{
				v[i].push_back(mp[i *j]);
			//	cout<<i<<" "<<mp[i * j]<<endl;
			}
		}
		if(v[i].size() >= 2)
		{
			need.push_back(i);
		}
	}
 	long long sum = 0;
	int cnt = 0;
	for(int i : need)
	{
		if(v[i].size() >= 2)
		{
		//	cout<<v[i].size()<<" "<<i<<endl;
			for(int j = 1;j<v[i].size();j++)
			{
			//	cout<<v[i][j]<<" "<<v[i][j - 1]<<endl;
				if(!Union(v[i][j],v[i][j-1]))
				{
					sum += i;
					cnt ++;
				//	cout<<"i"<<endl;
					if(cnt >= n - 1)
					{
						cout<<sum<<endl;
						return 0;
					}
				}
			}
		}
	}
	sum += max(0,n - 1 - cnt);
	cout<<sum<<endl;
	return 0;
} 
