#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin>>t;
	while(t--)	
	{
		int n;
		cin>>n;
		vector<long long>h(n+5);
		for(int i = 1;i<=n;i++)
		{
			cin>>h[i];
		}
		sort(h.begin() + 1,h.begin() + 1+ n);
		long long sta = 0;
		long long end1 = 0;
		long long dh = LLONG_MAX;
		int ptr = 0;
		for(int i = 2;i<=n;i++)
		{
			if(h[i] - h[i-1] < dh)
			{
				sta = h[i-1];
				end1 = h[i];
				dh = h[i] - h[i-1];	
				ptr =  i-1;
			}
		}
		int k = 1;
		cout<<sta<<" ";
		for(int i = ptr+2;i<=n;i++)
		{
			cout<<h[i]<<" ";
		}//一定要先后面段的再前面段的，这样也把第一个和最后一个考虑进去，实际更大 
		for(int i = 1;i<=ptr-1;i++)
		{
			cout<<h[i]<<" ";
		}
		cout<<end1<<endl;
	}
	return 0;
}
