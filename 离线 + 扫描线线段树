#include <bits/stdc++.h>
using namespace std;
struct st{
	int s1;
	int id;
	int e1;
};
int n;
//离线：先把所有询问按右端点排序，避免在线回答
//扫描线：从左到右扫描原序列，每次移动右端点时维护必要的信息
//维护每个位置“是否为某个颜色的最后出现位置”，支持单点修改和区间求和。
const int maxn = 1e6+5;
vector<int>s(maxn<<2);
void change(int l,int r,int i,int jobl,int jobr,int k)
{
	if(l >= jobl && r <= jobr)
	{
		s[i] += k;
		return;
	}
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		change(l,mid,i<<1,jobl,jobr,k);
	}
	if(mid + 1<=jobr)
	{
		change(mid+1,r,i<<1|1,jobl,jobr,k);
	}
	s[i] = s[i<<1] + s[i<<1|1];
	return;
}
int query(int l,int r,int i,int jobl,int jobr)
{
	if(l >= jobl && r <=jobr)
	{
		return s[i];
	}
	int mid = (l + r)>>1;
	int res = 0;
	if(mid >= jobl)
	{
		res += query(l,mid,i<<1,jobl,jobr);
	}
	if(mid +1<= jobr)
	{
		res += query(mid +1 ,r,i<<1|1,jobl,jobr);
	}
	return res;
}
bool cmp(st a,st b)
{
	return a.e1<b.e1;
}
int main()
{
	cin>>n;
	vector<int>v(maxn);
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	int m;
	cin>>m;
	vector<st>po(m+5);
	vector<int>last(maxn,0);
	for(int i = 1;i<=m;i++)
	{
		cin>>po[i].s1>>po[i].e1;
		po[i].id = i;
	}
	sort(po.begin()+1,po.begin() + m + 1,cmp);
	int k = 1;
	int tar = po[k].e1;
	vector<int>ans(m+5);
	for(int i = 1;i<=n;i++)
	{
		if(last[v[i]] != 0)
		{
			change(1, n, 1,last[v[i]],last[v[i]],-1);
		}
		last[v[i]] = i;
		change(1,n,1,i,i,1);
		while(k<=m && po[k].e1==i)
		{
			ans[po[k].id] = (query(1,n,1,po[k].s1,i));
			k++;
		}
	}
	for(int i = 1;i<=m;i++)
	{
		cout<<ans[i]<<endl;
	}
	return 0;
}
