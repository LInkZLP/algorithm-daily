#include <bits/stdc++.h>
using namespace std;

int main()
{
	int n;
	cin>>n;
	vector<long long>x(n+5);
	vector<long long>h(n + 5);
	for(int i = 1;i<=n;i++)
	{
		cin>>x[i]>>h[i];
	}
	if(n == 1)
	{
		cout<<1<<endl;
		return 0;
	}
	long long ans = 2;
	for(int i = 2;i<n;i++)
	{
		if(x[i] - x[i-1] > h[i])
		{
			ans ++;
		}
		else if(x[i + 1] - x[i] > h[i])
		{
			ans ++;
			x[i] += h[i];
		}
	}
	cout<<ans<<endl;
	return 0;
}
