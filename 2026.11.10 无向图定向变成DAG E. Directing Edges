#include <bits/stdc++.h>
using namespace std;
int timer = 0;
int n = 0;
int m;
const int maxn = 2e5 + 5;
vector<int>scc_id;
vector<vector<int>>v;
vector<int>dfn;
vector<int>low;
int scc_cnt = 0;
vector<int>instk;
stack<int>stk;
void tarjan(int u)
{
    timer ++;
    low[u] = dfn[u] = timer;
    instk[u] = 1;
    stk.push(u);
    for(int i = 0;i<v[u].size();i++)
    {
        int ed = v[u][i];
        if(!dfn[ed])
        {
            tarjan(ed);
            low[u] = min(low[u],low[ed]);
        }
        else if(instk[ed])
        {
            low[u] = min(low[u],dfn[ed]);
        }
    }
    if(low[u] == dfn[u])
    {
        scc_cnt ++;
        int nxt = 0;
        do{
            nxt = stk.top();
            stk.pop();
            instk[nxt] = 0;
            scc_id[nxt] = scc_cnt;
        }while(nxt !=  u);
    }
}
void solve()
{
    cin>>n>>m;
    v.assign(n+ 5,vector<int>());
    low.assign(n + 5,0);
    dfn.assign(n + 5,0);
    instk.assign(n + 5,0);
    scc_id.assign(n + 5,0);
    scc_cnt = 0;
    timer = 0;
    vector<int>c1;
    vector<int>c2;
    vector<int>ans1;
    vector<int>ans2;
    for(int i = 1;i<=m;i++)
    {
        int t;
        int x;
        int y;
        cin>>t>>x>>y;
        if(t)
        {
            v[x].push_back(y);
            ans1.push_back(x);
            ans2.push_back(y);
        }
        else
        {
            c1.push_back(x);
            c2.push_back(y);
        }
    }
    for(int i = 1;i<=n;i++)
    {
        if(!dfn[i])
        {
            tarjan(i);
        }
    }
    if(scc_cnt != n)
    {
        cout<<"NO"<<endl;
        return;
    }
    vector<int>jd(n + 5,0);
    for(int i = 1;i<=n;i++)
    {
        for(int j = 0;j<v[i].size();j++)
        {
            int ed = v[i][j];
            jd[ed] ++;
        }
    }
    queue<int>q;
    for(int i = 1;i<=n;i++)
    {
        if(jd[i] == 0)
        {
            q.push(i);
        }
    }
    vector<int>mp(maxn);
    vector<int>ss;

    while(!q.empty())
    {
        int u = q.front();
        q.pop();
        ss.push_back(u);
        mp[u] = ss.size();
        for(int i = 0;i<v[u].size();i++)
        {
            int ed = v[u][i];
            jd[ed] --;
            if(jd[ed] == 0)
            {
                q.push(ed);
            }
        }
    }
    for(int i = 0;i<c1.size();i++)
    {
        int x = c1[i];
        int y = c2[i];
        if(mp[x] < mp[y])
        {
            ans1.push_back(x);
            ans2.push_back(y);
        }
        else
        {
            ans1.push_back(y);
            ans2.push_back(x);
        }
    }
    cout<<"YES"<<endl;
    for(int i = 0;i<ans1.size();i++)
    {
        cout<<ans1[i]<<" "<<ans2[i]<<endl;
    }
    return;
}
int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--)
    {
        solve();
    }
    return 0;
}
