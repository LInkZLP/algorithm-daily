#include <Bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<int>v(n +5);
	vector<vector<long long>>vis(n + 5,vector<long long>(n + 5,0));
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		vis[i][i] = v[i];
	}
	for(int len = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <= n;i++)
		{
			int j = i + len - 1;
			for(int k = i;k + 1<=j;k++)
			{
				if(vis[i][k] && vis[k + 1][j] && vis[i][k] == vis[k + 1][j])
				{
					vis[i][j] = vis[i][k] + 1;
				}
			}
		}
	}
	vector<long long>dp(n + 5,n);
	dp[0] = 0;
	dp[1] = 1;
	for(int i = 2;i<=n;i++)
	{
		for(int j = 1;j<i;j++)
		{
			if(vis[j][i])
			{
				dp[i] = min(dp[i],dp[j - 1] + 1);
			}
		}
		dp[i] = min(dp[i - 1] + 1,dp[i]);
	//	cout<<dp[i]<<endl;
	}
	
	cout<<dp[n]<<endl;
	return;
}
int main()
{
	int t;
	//cin>>t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
 } 
