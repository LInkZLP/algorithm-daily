#include <bits/stdc++.h>
using namespace std;
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		int k;
		long long m;
		cin>>n>>k>>m;
		if(k> n || k > m)
		{
			cout<<"No"<<endl;
			continue;
		} 
		cout<<"yes"<<endl;
		for(int i = 1;i<=k-1;i++)
		{
			cout<<1<<" ";
		}
		cout<<m - k + 1<<" ";
		for(int i = k +1;i<=n;i++)
		{
			cout<<1<<" ";
		}
		cout<<endl;
	}
	
	
	return 0;
}
