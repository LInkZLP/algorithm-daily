#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		vector<int>v(n+5);
		int c1 = 0;
		for(int i = 1;i<=n;i++)
		{
			char x;
			cin>>x;
			v[i] = x - '0';
			c1 += v[i] ? 1 : 0;
		}
		vector<int>tar(n+5);
		for(int i = 1;i<=n;i++)
		{
			char x;
			cin>>x;
			tar[i] = x - '0';
		}
		int k = 0;
		int pass= 1;
		for(int i = n;i>=1;i--)
		{
			if(k & 1)
			{
				v[i] ^= 1;
			}
			if(tar[i] == v[i])
			{
				c1 -= v[i] ? 1 : 0;
			}
			else
			{
				if(c1 == i - c1)
				{
					k++;
					if(v[i] == 0)
					{
						c1 --;
					}
				}
				else
				{
					pass = 0;
					break;
				}
			}
		}
		if(pass)
		{
			cout<<"YES"<<endl;
		}
		else
		{
			cout<<"NO"<<endl;
		}
		
	}
	return 0;
}
