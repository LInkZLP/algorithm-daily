#include <bits/stdc++.h>
using namespace std;
int n;
int t;
const int maxn = 105;
int main()
{
	cin>>t;
	while(t--)
	{
		cin>>n;
		vector<long long>v(maxn);
		for(int i = 1;i<=n;i++)
		{
			cin>>v[i];
		}
		sort(v.begin() + 1,v.begin() + 1 + n);
		int ans = INT_MAX;
		for(int i = 1;i<=n;i++)
		{
			int l = 0;
			int r = 0;
			for(int j = 1;j<= n;j++)
			{
				if(v[i] != v[j])
				{
					if(j > i)
					{
						l ++;
					}
					else
					{
						r ++;
					}
				}
			}
			ans = min(ans,max(l,r));
		}
		cout<<ans<<endl
	}
	
	
	return 0;
}
