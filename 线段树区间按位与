#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 1e5+5;
vector<int>sum(maxn<<2);
vector<int>add(maxn<<2);
void down(int i)
{
	if(add[i])
	{
		int t = add[i];
		add[i<<1] |= t;
		add[i<<1|1] |= t;
		sum[i<<1] |= t;
		sum[i<<1|1] |= t;
		add[i] = 0;
	}
	return;
}
void change(int l,int r,int i,int jobl,int jobr,int jobv)
{
	if(l >= jobl &&r <=jobr)
	{
		sum[i] |= jobv;
		add[i] |= jobv;
		return;
	}
	int mid = (l + r)>>1;
	down(i);
	if(mid >=jobl)
	{
		change(l,mid,i<<1,jobl,jobr,jobv);
	}
	if(mid + 1<=jobr)
	{
		change(mid+1,r,i<<1|1,jobl,jobr,jobv);
	}
	sum[i] = sum[i<<1] & sum[i<<1|1];
}
int query(int l,int r,int i,int jobl,int jobr)
{
	if(l >= jobl &&r <=jobr)
	{
		return sum[i];
	}
	int mid = (l + r)>>1;
	down(i);
	int ans = (1<<30) - 1;
	if(mid >=jobl)
	{
		ans &=query(l,mid,i<<1,jobl,jobr);
	}
	if(mid + 1<=jobr)
	{
		ans &=query(mid+1,r,i<<1|1,jobl,jobr);
	}
	return ans;
}
int main()
{ 
	int n;
	int m;
	cin>>n>>m;
	vector<int>tar(m+5);
	vector<int>x(m+5);
	vector<int>y(m+5);
	for(int i = 1;i<=m;i++)
	{
		cin>>x[i]>>y[i]>>tar[i];
		change(1,n,1,x[i],y[i],tar[i]);
	}
	for(int i = 1;i<=m;i++)
	{
		if(tar[i] != query(1,n,1,x[i],y[i]))
		{
			cout<<"NO"<<endl;
			return 0;
		}
	}
	cout<<"YES"<<endl;
	for(int i = 1;i<=n;i++)
	{
		cout<<query(1,n,1,i,i)<<" ";
	}
	cout<<endl;
	return 0;
}
