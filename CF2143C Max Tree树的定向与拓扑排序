#include <bits/stdc++.h>
using namespace std;
struct st{
	int u;
	int v;
	long long x;
	long long y;
	long long h;
};
//拓扑排序是对的，原因有两个：
//1. 树的任意定向都不可能形成有向环
//2. 每条边都能独立选择贡献更大的方向
//树的任意定向都没有环，所以每条边都能独立取较大的贡献；
//拓扑排序只是把这些互不冲突的方向要求变成一个合法的大小顺序。
void solve()
{
	int n;
	cin>>n;
	vector<st>a(n + 5);
	vector<int>temp;
	vector<int>jd(n + 5);
	vector<vector<int>>g(n + 5);
	temp.push_back(0);
	for(int i = 1;i<=n - 1;i++)
	{
		int u;
		int v;
		int x;
		int y;
		cin>>u>>v>>x>>y;
		a[i] = {u,v,x,y,abs(x - y)};
		if(x > y)
		{
			g[v].push_back(u);
			jd[u] ++;
		}
		else
		{
			g[u].push_back(v);
			jd[v] ++;
		}
	}
	queue<int>q;
	for(int i = 1;i<=n;i++)
	{
		if(!jd[i])
		{
			q.push(i);
		}
	}
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		temp.push_back(u);
		for(int i = 0;i<g[u].size();i++)
		{
			jd[g[u][i]] -- ;
			if(!jd[g[u][i]])
			{
				q.push(g[u][i]);
			}
		}
	}
	vector<int>ans(n + 5);
	for(int i = 1;i<=n;i++)
	{
		ans[temp[i]] = i;
	}
	for(int i = 1;i<=n;i++)
	{
		cout<<ans[i]<<" ";
	}
	cout<<endl;
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
} 
