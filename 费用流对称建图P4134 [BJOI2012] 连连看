#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 2500;
vector<long long>dis;
vector<int>preV;
vector<int>preE;
struct st{
	int ed;
	int id;
	long long w;
	long long c;
};
vector<vector<st>>v(maxn);
vector<int>inq;
int a;
int b;
int S;
int T;
const long long INF = 1e18;
long long gcd(long long m,long long n)
{
	return n == 0?m : gcd(n,m % n);
}
bool spfa()
{
	dis.assign(maxn,INF);
	preV.assign(maxn,0);
	preE.assign(maxn,0);
	inq.assign(maxn,0);
	queue<int>q;
	q.push(S);
	inq[S] = 1;
	dis[S] = 0;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		inq[u] = 0;
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].ed;
			if(v[u][i].w && dis[ed] > dis[u] + v[u][i].c)
			{
				dis[ed] = dis[u] + v[u][i].c;
				preE[ed] = i;
				preV[ed] = u;
				if(inq[ed])
				{
					continue;
				}
				inq[ed] = 1;
				q.push(ed);
			}
		}
	}
	return dis[T] != INF;
}
void add(int u,int x,long long w,long long c)
{
	int sti = v[u].size();
	int edi = v[x].size();
	v[u].push_back({x,edi,w,c});
	v[x].push_back({u,sti,0,-c});
	return;
}
void solve()
{
	long long flow = 0;
	long long cost = 0;
	while(spfa())
	{
		long long f = INF;
		for(int u = T;u!=S;u = preV[u])
		{
			f = min(f,v[preV[u]][preE[u]].w);
		}
		for(int u = T;u != S;u = preV[u])
		{
			v[preV[u]][preE[u]].w -= f;
			v[u][v[preV[u]][preE[u]].id].w += f;
		}
		flow += f;
		cost += f * dis[T];
	//	cout<<f<<endl;
	//	cout<<dis[T]<<endl;
	}
	cout<<flow /2<< " "<<-cost/2<<endl;
}
int main()
{
	//二分匹配：一个点只演一个角色，一条容量1就管住。
	//拆点同一个数字演两个角色，两条容量1分别管两个角色，
	//管不住总数。必须用一条中间边把两个角色串起来，统一限制。 
	int a;
	int b;
	cin>>a>>b;
	S = 0;
	T = b * 2 + 1;
	for(int i = a;i<=b;i++)
	{
		add(S,i,1,0);
		add(i + b,T,1,0);
	}
	for(int i = a;i<=b;i++)
	{
		for(int j = i + 1;j<=b;j++)
		{
			int x = j;
			int y = i;
			int d = x * x - y * y;
			int p = sqrt(d);
			if(p * p == d && gcd(y,p) == 1)
			{
			//	cout<<x << " "<<y<<endl;
				add(x,y + b,1,-(x + y));
				add(y,x + b,1,-(x + y));
			}
		}
	}
	solve();
	return 0;
}
