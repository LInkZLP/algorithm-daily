#include <bits/stdc++.h>
using namespace std;
const int maxn = 3e5+5;
vector<long long> v(maxn);
vector<long long> sum(maxn * 4);
vector<long long> mx(maxn * 4);
int n, m;

void pushup(int i) {
    sum[i] = sum[i<<1] + sum[i<<1|1];
    mx[i] = max(mx[i<<1], mx[i<<1|1]);
}

void build(int l, int r, int i) {
    if (l == r) {
        sum[i] = v[l];
        mx[i] = v[l];
        return;
    }
    int mid = (l + r) >> 1;
    build(l, mid, i<<1);
    build(mid+1, r, i<<1|1);
    pushup(i);
}

void update(int l, int r, int i, int ql, int qr) {
    if (r < ql || l > qr) return;  // 区间无交集
    if (mx[i] <= 1) return;         // 最大值 <= 1 无需开方
    if (l == r) {
        sum[i] = sqrt(sum[i]);
        mx[i] = sum[i];
        return;
    }
    int mid = (l + r) >> 1;
    if (ql <= mid) update(l, mid, i<<1, ql, qr);
    if (qr > mid) update(mid+1, r, i<<1|1, ql, qr);
    pushup(i);
}

long long query(int l, int r, int i, int ql, int qr) {
    if (r < ql || l > qr) return 0;
    if (ql <= l && r <= qr) return sum[i];
    int mid = (l + r) >> 1;
    long long res = 0;
    if (ql <= mid) res += query(l, mid, i<<1, ql, qr);
    if (qr > mid) res += query(mid+1, r, i<<1|1, ql, qr);
    return res;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n;
    for (int i = 1; i <= n; i++) cin >> v[i];
    build(1, n, 1);

    cin >> m;
    while (m--) {
        int op, x, y;
        cin >> op >> x >> y;
        if (x > y) swap(x, y);
        if (op == 0) {
            update(1, n, 1, x, y);
        } else {
            cout << query(1, n, 1, x, y) << '\n';
        }
    }
    return 0;
}
