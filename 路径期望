#include <bits/stdc++.h>
using namespace std; 
#define pli pair<long long ,int>

int n, m;
const int maxn = 1e5+5;
vector<vector<pli>> v(maxn);   // 邻接表，存 (权重, 终点)
vector<int> jd(maxn);          // 入度，用于拓扑排序
vector<int> od(maxn);          // 出度
vector<double> lp(maxn);       // lp[u] = 从起点走到 u 的概率
vector<double> en(maxn);       // en[u] = 从起点走到 u 的期望路径长度（无条件期望）

int main() {
    cin >> n >> m;
    for (int i = 1; i <= m; i++) {
        int u, r, w;
        cin >> u >> r >> w;
        v[u].push_back({w, r});
        jd[r]++;
        od[u]++;
    }

    queue<int> q;
    q.push(1);
    lp[1] = 1.0;          // 起点概率为 1

    while (!q.empty()) {
        int u = q.front(); q.pop();
        // 遍历 u 的所有出边
        for (int i = 0; i < v[u].size(); i++) {
            int nxt = v[u][i].second;   // 目标节点
            int w = v[u][i].first;      // 边权
            jd[nxt]--;                  // 入度减1，拓扑排序

            // 从 u 走到 nxt 的概率 = lp[u] / od[u]
            double p_trans = lp[u] / od[u];
            lp[nxt] += p_trans;         // 累加概率

            // 期望递推公式（重要）
            en[nxt] += (en[u] + w * lp[u]) / od[u];

            // 如果 nxt 入度变为 0，入队
            if (jd[nxt] == 0) {
                q.push(nxt);
            }
        }
    }

    printf("%.2lf\n", en[n]);   // 输出到终点的期望长度
    return 0;
}
