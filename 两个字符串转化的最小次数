#include <bits/stdc++.h>
using namespace std;
const int maxn = 2e4+5;
int n;
int m;
//设 dp[i][j] 表示字符串 A 的前 i 个字符
//转换成字符串 B 的前 j 个字符所需的最少操作次数。
int main()
{
	string s1;
	string s2;
	cin>>s1>>s2;
	int n = s1.size();
	int m = s2.size();
	vector<vector<int>>dp(n+1,vector<int>(m+1,0));
	for(int i = 0;i<=n;i++)
	{
		dp[i][0] = i;//删除所有字符 
	}
	for(int j = 0;j<=m;j++)
	{
		dp[0][j] = j;//插入所有字符 
	}
	for(int i = 1;i<=n;i++) 
	{
		for(int j = 1;j<=m;j++)
		{
			if(s1[i-1] == s2[j-1])
			{
				dp[i][j] = dp[i-1][j-1];//继承上一次的 
			}
			else
			{
				dp[i][j] = min(dp[i-1][j]+1,min(dp[i-1][j-1]+1,dp[i][j-1]+1));
				//删，替，插 
			}
		}
	}
	cout<<dp[n][m]<<endl; 
	
	
	return 0;
}
