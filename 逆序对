#include <bits/stdc++.h>

using namespace std;
long long cnt = 0;

void mergecheck(int left,int mid,int right,vector<int>&arr,vector<int>&temp)
{
	int i = left;
	int j = mid+1;
	int k = left;
	while(i <= mid && j <= right)
	{
		if(arr[i] > arr[j])
		{
			cnt += mid - i+1;
			temp[k++] = arr[j++];
		}
		else
		{
			temp[k++] = arr[i++];
		}
	}
	while(i <= mid)
	{
		temp[k++] = arr[i++];
	}
	while(j <= right)
	{
		temp[k++] = arr[j++];
	}
	for(k = left;k<=right;k++)
	{
		arr[k] = temp[k];
	}
	return ;
}

void merge(int left,int right, vector<int>&arr,vector<int>&temp)
{
	if(left >= right)
	{
		return;
	}
	
	int mid = (right - left) / 2+ left;
	merge(left,mid,arr,temp);
	merge(mid+1,right,arr,temp);
	mergecheck(left,mid,right,arr,temp);
}

int main()
{
	int n;
	cin>>n;
	vector<int>arr(n);
	vector<int>temp(n);
	for(int i = 0;i<n;i++)
	{
		cin>>arr[i];
	}
	merge(0,n-1,arr,temp);
	cout<<cnt;
	
	return 0;
 } 
