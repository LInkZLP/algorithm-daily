#include <bits/stdc++.h>
using namespace std;

const int maxn = 1e5 + 5;   // 最大节点数
const int LOG = 22;         // 倍增二进制位数，2^22 > 1e5

int n, m;                   // n个节点，m个询问
vector<vector<int>> up(maxn, vector<int>(LOG, 0)); // up[u][i]: u的2^i级祖先
vector<vector<int>> v(maxn); // 邻接表
vector<int> dep(maxn);      // 节点深度（根深度为0）

// 深度优先搜索预处理深度和倍增祖先
// u: 当前节点, p: 父节点
void dfs(int u, int p) {
    up[u][0] = p;                     // 2^0 = 1级祖先就是父节点
    for (int i = 1; i <= LOG - 1; i++) {
        // u的2^i级祖先 = (u的2^(i-1)级祖先) 的 2^(i-1)级祖先
        up[u][i] = up[up[u][i-1]][i-1];
    }
    for (int i = 0; i < v[u].size(); i++) {
        int nxt = v[u][i];
        if (nxt == p) continue;       // 避免回到父节点
        dep[nxt] = dep[u] + 1;        // 子节点深度 = 父节点深度+1
        dfs(nxt, u);
    }
}

// 倍增法求最近公共祖先
int lca(int a, int b) {
    // 确保a的深度 >= b的深度
    if (dep[a] < dep[b]) swap(a, b);
    int dh = dep[a] - dep[b];         // 深度差
    // 将a上移到与b同一深度
    for (int i = LOG - 1; i >= 0; i--) {
        if (dh & (1 << i)) {          // 如果深度差的二进制第i位为1
            a = up[a][i];
        }
    }
    if (a == b) return a;             // 此时a就是LCA
    // 一起向上跳，直到父节点相同
    for (int i = LOG - 1; i >= 0; i--) {
        if (up[a][i] != up[b][i]) {   // 如果祖先不同，则跳上去
            a = up[a][i];
            b = up[b][i];
        }
    }
    return up[a][0];                  // 此时a和b的父节点就是LCA
}

// 计算树上两点之间的最短距离（边数）
int dist(int x, int y) {
    // 树上距离公式：dist(x,y) = depth[x] + depth[y] - 2*depth[lca(x,y)]
    return dep[x] + dep[y] - 2 * dep[lca(x, y)];
}

int main() {
    cin >> n >> m;
    // 读入树边（无向）
    for (int i = 1; i <= n - 1; i++) {
        int x, y;
        cin >> x >> y;
        v[x].push_back(y);
        v[y].push_back(x);
    }
    // 预处理，以1为根，父节点设为1（注意：设为1会导致根节点的父节点是自己，但后续LCA依然正确）
    // 更严谨的做法是设为0，但设为1在本题中也能AC，因为up[0][i]均为0不会越界。
    dfs(1, 1);

    // 处理每个询问
    for (int i = 1; i <= m; i++) {
        int x, y, a, b;
        cin >> x >> y >> a >> b;   // 两条路径：(x,y) 和 (a,b)

        // 计算每条路径的LCA（路径上深度最小的节点）
        int r1 = lca(x, y);         // 路径(x,y)的LCA
        int r2 = lca(a, b);         // 路径(a,b)的LCA

        // 核心判断：两条路径有公共点 <=> r1在路径(a,b)上 或 r2在路径(x,y)上
        // 判断点p是否在路径(u,v)上：dist(p,u) + dist(p,v) == dist(u,v)
        if (dist(r1, a) + dist(r1, b) == dist(a, b) ||   // r1在(a,b)上？
            dist(r2, x) + dist(r2, y) == dist(x, y)) {    // r2在(x,y)上？
            cout << "Y" << endl;
        } else {
            cout << "N" << endl;
        }
    }
    return 0;
}

/*
========== 思路与证明 ==========

【问题】
给定一棵树和两条路径 (x,y) 和 (a,b)，判断它们是否有公共节点（包括端点）。

【核心结论】
两条路径有公共点 ⇔ 其中一条路径的 LCA 落在另一条路径上。

【证明】

定义：
- 记 P1 = 路径(x,y)，其 LCA 为 l1 = lca(x,y)
- 记 P2 = 路径(a,b)，其 LCA 为 l2 = lca(a,b)

必要性（⇒）：
假设存在公共点 Q ∈ P1 ∩ P2。
由于 l1 是 P1 上深度最小的点，而 Q 在 P1 上，所以 l1 是 Q 的祖先（可能等于 Q）。
同样，l2 是 P2 上深度最小的点。
考虑 l1 与 P2 的关系：因为 Q 在 P2 上，且 l1 在 Q 的祖先方向，所以 l1 要么也在 P2 上，要么在 P2 的“上方”。
但可以证明 l1 不可能在 P2 的上方（否则 l1 到 Q 的路径会离开 P2），因此 l1 ∈ P2。同理 l2 ∈ P1。
所以必要性成立。

充分性（⇐）：
如果 l1 ∈ P2，那么 l1 本身就是一个公共点（因为 l1 ∈ P1 显然，且 l1 ∈ P2）。同理如果 l2 ∈ P1，则 l2 是公共点。因此充分性成立。

【判断点是否在路径上】
树上两点之间的路径唯一。对于点 p 和路径 (u,v)，p 在 (u,v) 上当且仅当：
    dist(p, u) + dist(p, v) == dist(u, v)
这是因为如果 p 在路径上，则从 u 到 v 的最短路径必然经过 p，因此两段距离之和等于总距离；
如果 p 不在路径上，则 u→p→v 会形成“折线”，其长度严格大于 u→v 的直线距离（三角形不等式）。

【算法步骤】
1. 预处理：DFS 计算每个节点的深度 dep[] 和倍增祖先 up[][]，复杂度 O(n log n)。
2. 对每个询问：
   - 计算 l1 = lca(x,y), l2 = lca(a,b)
   - 判断 l1 是否在路径 (a,b) 上：dist(l1,a)+dist(l1,b) == dist(a,b)
   - 判断 l2 是否在路径 (x,y) 上：dist(l2,x)+dist(l2,y) == dist(x,y)
   - 若任一成立输出 "Y"，否则 "N"。
3. 每次询问 O(log n)（LCA 和距离均为对数级）。

【边界情况】
- 如果路径退化为一个点（如 x==y），则 LCA 就是该点，判断其是否在另一条路径上依然有效。
- 根节点父节点设为 1 时，up[1][0]=1，但 up[0][i] 均为 0，LCA 计算不会出错（因为跳过头时会停留在 0，但深度比较已经保证不会跳到 0）。若改为父节点 0，代码需相应调整，但原理相同。

【复杂度】
预处理 O(n log n)，每个询问 O(log n)，总复杂度 O((n + m) log n)，空间 O(n log n)。
*/ 
