#include <bits/stdc++.h>
using namespace std;
int v[20][20];
long long ans = 0;
int n;
int T;
int m;
int tot = 0;
vector<int>team(20,0);
vector<int>cc(20); 
void dfs(int u,int nc,int cnt)
{
	if (cnt + (n - u + 1) < T) return; 
	if(u > n )
	{
		if(nc != tot)
		{
			return;
		}
		ans ++;
		return;
	}
	if(u == n)
	{
		int p = tot ^ nc;
		if((p & (p - 1) )== 0 && p != 0)
		{
			ans += 1;
			return;
		}
	}
	for(int i = 1;i<=T;i++)
	{
		bool k = false;
		for(int last = u - 1;last >= 1;last --)
		{
			if(i == team[last] && v[u][last])
			{
				k = true;
				break;
			}
		}
		if(!k)
		{
			team[u] = i;
			if((nc & (1<<(i - 1))) == 0)
			{
				dfs(u + 1,nc | (1<<(i - 1)),cnt + 1);
			}
			else
			{
				dfs(u + 1,nc | (1<<(i - 1)),cnt);
			}
			
			team[u] = 0;
		}
	}
	return;
}
void solve()
{
	cin>>n>>T>>m;
	tot = (1<<T) - 1;
	ans = 0;
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x][y] = 1;
		v[y][x] = 1;
	} 
	for(int i = 1;i<=n - 1;i++)
	{
		if(v[n][i] == 0)
		{
			cc[n] ++;
		}	
	}
	dfs(1,0,0);
	long long pt = 1;
	for(int i = 1;i<=T;i++)
	{
		pt *= i;
	}
	cout<<ans / pt<<endl;
}
int main()
{
	int t = 1;
	//cin>>t;	
	while(t--)
	{
		solve();
	}
	return 0;
}
