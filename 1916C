#include <bits/stdc++.h>
using namespace std;

int main()
{
	int n;
	int t;
	cin>>t;
	while(t--)	
	{
		cin>>n;
		int odd = 0;
		int even = 0;
		long long s1 = 0;
		long long s2 = 0;
		for(int i = 1;i<=n;i++)
		{
			long long x;
			cin>>x;
			if(x & 1)
			{
				odd++;
				s2+=x;
			}
			else
			{
				even++;
				s1+=x;
			}
			if(i == 1)
			{
				cout<<x<<" ";
				continue;
			}
			int cnt = odd / 3;
			cout<<s1 + s2 - cnt - (odd % 3 == 1)<<" ";
		}
		cout<<endl;
	}	
	return 0;
 } 
