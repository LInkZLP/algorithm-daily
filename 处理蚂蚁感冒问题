#include <bits/stdc++.h>
//2026.3.16
using namespace std;

int main()
{
	int n;
	cin>>n;
	//那么两只蚂蚁相撞就可以看作两只蚂蚁互相穿过，蚂蚁之间没有什么区别，除了感冒性质
	vector<int>x(n+1);
	for(int i = 1;i<=n;i++)
	{
		cin>>x[i];
	}
	int ans = 0;
	int l = 0;
	int r = 0;
	for(int i = 2;i<=n;i++)
	{
		if(abs(x[i]) < abs(x[1]) && x[i] > 0)//1号左侧朝右
		{
			l++;
		}
		if(abs(x[i]) > abs (x[1]) && x[i] < 0)//号右侧朝左
		{
			r++;
		}
	}
	if(x[1] < 0)
	{
		if(l == 0)
		{
			ans = 1;
		}
		else
		{
			ans=l+r+1;//1号能把r和l一起感染
		}
	}
	else
	{
		if(r == 0)
		{
			ans = 1;
		}
		else
		{
			ans = l + r + 1;//1号能把r和l一起感染
		}
	}
//总之，不能被感染的除了特殊情况l = 0,r = 0，剩下的只有和1同向
	cout<<ans<<endl;
	
	return 0;
}

