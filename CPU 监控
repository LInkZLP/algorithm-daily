const int maxn = 1e5+5;
vector<int>hcov(maxn<<2,INT_MIN);//目前最高赋值 ,一旦赋值，直接没用 
vector<int>cov(maxn<<2,INT_MIN);//当前赋值，一旦赋值，直接没用 
vector<int>add(maxn<<2);//增量 
vector<int>mx(maxn<<2);
vector<int>hadd(maxn<<2,0);//处理完当前节点之前的最高增量 
vector<int>himx(maxn<<2);
vector<int>v(maxn);
void up(int i)
{
	mx[i] = max(mx[i<<1],mx[i<<1|1]);
	himx[i] = max(himx[i<<1],himx[i<<1|1]);
	return;
}
void build(int l,int r,int i)
{
	if(l == r)
	{
		mx[i] = v[l];
		himx[i] = v[l];
		return;
	}
	int mid = (l + r)>>1;
	build(l,mid,i<<1);
	build(mid+1,r,i<<1|1);
	up(i);
	return;
}
void down(int i,int had,int va,int ad,int hva)
{
	himx[i] = max(himx[i],mx[i] + had);//先处理himx，用最大赋值和最大增量 ，最大增量一定是匹配当下的 
	himx[i] = max(himx[i],hva);
	if(va == INT_MIN)
	{
		mx[i] += ad;
	}
	else
	{
		mx[i] = va;
	}
	if(cov[i] == INT_MIN && va == INT_MIN)//上面没有下放赋值，当前节点没有赋值 
	{
		hadd[i] = max(hadd[i],add[i] + had);
		add[i] += ad;
	}
	else if(cov[i] == INT_MIN && va != INT_MIN)
	{
		hadd[i] = max(hadd[i],add[i] + had);
		hcov[i] = max(hcov[i],hva);
		add[i] += ad;
		cov[i] = va;
	}
	else if(cov[i] != INT_MIN && va == INT_MIN)
	{
		hcov[i] = max(hcov[i], cov[i] + had);
		cov[i] += ad;
	}
	else if(cov[i] != INT_MIN && va != INT_MIN)
	{
		hcov[i] = max(hcov[i],hva);
		hcov[i] = max(hcov[i],cov[i] + had);
		cov[i] = va;
	}
	return;
}
