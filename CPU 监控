		return mx[i];
	}
	push(i);
	int mid = (l + r)>>1;
	int res = INT_MIN;
	if(mid>=jobl)
	{
		res = max(res,q1(l,mid,i<<1,jobl,jobr));
	}
	if(mid + 1<=jobr)
	{
		res = max(res,q1(mid+1,r,i<<1|1,jobl,jobr));
	}
	return res;
}
