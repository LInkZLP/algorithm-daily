void change1(int l,int r,int i,int jobl,int jobr,int x)
{
	if(l >= jobl && r <= jobr)
	{
		down(i,max(0,x),INT_MIN,x,INT_MIN);
		return;
	}
	int mid = (l + r)>>1;
	push(i);
	if(mid>=jobl)
	{
		change1(l,mid,i<<1,jobl,jobr,x);
	}
	if(mid + 1<=jobr)
	{
		change1(mid+1,r,i<<1|1,jobl,jobr,x);
	}
	up(i);
	return;
}
void change2(int l,int r,int i,int jobl,int jobr,int x)
{
	if(l >= jobl && r <= jobr)
	{
		down(i,0,x,0,x);
		return;
	}
	push(i);
	int mid = (l + r)>>1;
	if(mid>=jobl)
	{
		change2(l,mid,i<<1,jobl,jobr,x);
	}
	if(mid + 1<=jobr)
	{
		change2(mid+1,r,i<<1|1,jobl,jobr,x);
	}
	up(i);
	return;
	
}
int q1(int l,int r,int i,int jobl,int jobr)
{
