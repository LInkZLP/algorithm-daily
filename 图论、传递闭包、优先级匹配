// 洛谷 P8186 [USACO22DEC] Cow College B
// 题目类型：图论、传递闭包、优先级匹配
// 思路：
//   有 n 头牛，初始时第 i 头牛拥有礼物 i。
//   每头牛对 n 个礼物有一个喜好顺序（从最喜欢到最不喜欢）。
//   牛 i 愿意交换礼物的条件是：对方手中的礼物在 i 的喜好中排名不差于自己原本的礼物 i。
//   通过一系列交换，牛 i 最终可能拿到的礼物集合就是：通过“愿意交换”关系形成的图中，能从礼物持有者节点到达 i 的所有礼物。
//   因此，先建图：如果牛 i 喜欢礼物 j 的程度 ≥ 自己的礼物 i，则连边 i -> j（表示 i 愿意把自己的礼物给 j）。
//   然后用 Floyd 算法求传递闭包，得到任意两点之间是否可达（即礼物能否从 u 传递到 v）。
//   最后，对于每头牛 i，按自己的喜好顺序（从最喜欢到最不喜欢）检查第 j 喜欢的礼物 g，
//   若 dist[g][i] == 1（即礼物 g 能从初始持有者 g 传递到 i），则输出 g 即为该牛能得到的最佳礼物。
// 方法：
//   1. 读入喜好，用 like[i][g] 记录礼物 g 在牛 i 心中的排名（1 为最喜爱）。
//   2. 用 pos[i] 记录牛 i 自己原本礼物 i 的排名。
//   3. 建图：若 like[i][j] <= pos[i] (表示牛 i 认为礼物 j 不比自己原来的差)，则 dist[i][j] = 1。
//   4. Floyd 求传递闭包：三重循环，若 i->k 且 k->j，则 i->j。
//   5. 对每头牛 i，按排名从小到大（最喜欢到最不喜欢）查找：遍历排名 j，找到该排名对应的礼物 k（like[i][k]==j），
//      若 dist[k][i]==1，则输出 k 并结束。

#include <bits/stdc++.h>
using namespace std;
int n;
const int maxn = 5e2+5;
vector<vector<int>> like(maxn, vector<int>(maxn, 0));   // like[i][g] = 牛 i 认为礼物 g 的排名（1~n）
vector<vector<int>> dist(maxn, vector<int>(maxn, 0));   // 传递闭包，dist[u][v]=1 表示礼物 u 能传递到牛 v
vector<int> pos(maxn);                                  // pos[i] = 牛 i 自己的初始礼物 i 在它心中的排名

int main()
{
    cin >> n;
    // 读入每头牛的喜好顺序
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n; j++)
        {
            int x;
            cin >> x;
            like[i][x] = j;               // 礼物 x 在牛 i 心中的排名是 j
            if (x == i)
            {
                pos[i] = j;               // 记录自己礼物的排名
            }
        }
        dist[i][i] = 1;                   // 自己到自己是可达的（初始）
    }

    // 建图：连边 i -> j 当且仅当牛 i 认为礼物 j 不比自己原来的差
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n; j++)      // j 是礼物编号
        {
            if (like[i][j] <= pos[i])     // 排名数字越小越喜欢，所以 <= 表示更喜欢或相等
            {
                dist[i][j] = 1;           // 牛 i 愿意把自己的礼物送给牛 j（即礼物 i 可以给到 j）
            }
        }
    }

    // Floyd 算法求传递闭包
    for (int k = 1; k <= n; k++)
    {
        for (int i = 1; i <= n; i++)
        {
            for (int j = 1; j <= n; j++)
            {
                if (dist[i][k] == 1 && dist[k][j] == 1)
                {
                    dist[i][j] = 1;       // 如果 i 能到 k，且 k 能到 j，则 i 能到 j
                }
            }
        }
    }

    // 为每头牛找出可能拿到的最佳礼物
    for (int i = 1; i <= n; i++)          // 枚举牛 i
    {
        for (int j = 1; j <= n; j++)      // j 表示喜好排名，从 1（最喜欢）到 n（最不喜欢）
        {
            int k1 = 1;                   // 标记是否已找到答案
            for (int k = 1; k <= n; k++)  // 枚举礼物编号 k
            {
                if (like[i][k] == j && dist[k][i] == 1) // 找到排名 j 对应的礼物 k，且礼物 k 能传递到牛 i
                {
                    cout << k << endl;    // 输出该礼物编号
                    k1 = 0;               // 标记已找到
                    break;
                }
            }
            if (k1 == 0)                  // 已经找到答案，跳过后续排名
            {
                break;
            }
        }
    }
    return 0;
}
