#include <bits/stdc++.h>
using namespace std;
int a[15];
long long dp[15][20][10][10];
long long dfs(int pos,int limit,int st,int sum,int tar)
{
	if(pos <= 0)
	{
		return sum;
	}
	if(!limit && dp[pos][sum][limit][st] != -1)
	{
		return dp[pos][sum][limit][st];
	}
	int res = limit ? a[pos] : 9;
	long long ret = 0;
	for(int i = 0;i<=res;i++)
	{
		if(st && i == 0)
		{
			ret += dfs(pos-1,limit && i == res,st,sum,tar);
		}
		else
		{
			ret += dfs(pos-1,limit && i == res ,0,sum + (i == tar),tar);
		}
	}
	if (!limit && !st) 
	{
		dp[pos][sum][limit][st] = ret;
	}
	return ret;
}

long long work(long long n,int tar)
{
	int l = 0;
	memset(a,0,sizeof(a));
	memset(dp,-1,sizeof(dp));
	while(n)
	{
		a[++l] = n % 10;
		n /=10;
	}
	return dfs(l,1,1,0,tar);
}
int main()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	cout.tie(0);
	int t1[10];
	int t2[10];
	long long x1;
	long long x2;
	cin>>x1>>x2;
	for(int i = 0;i<=9;i++)
	{
		if(i == 9)
		{
			cout<<work(x2,i) - work(x1-1,i)<<" \n";
		}
		else
		{
			cout<<work(x2,i) - work(x1-1,i)<<" ";
		}
	}
	return 0;
}
