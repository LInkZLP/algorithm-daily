#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int maxn = 1e2 + 6;
#define pli pair<long long,int>
vector<vector<pli>>v(maxn);
vector<vector<long long>>dp(maxn,vector<long long>(maxn,LLONG_MAX));
vector<vector<long long>>cnt(maxn,vector<long long>(maxn,0));
int main()
{
	cin>>n>>m;
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		long long c;
		cin>>x>>y>>c;
		if(dp[x][y] > c)
		{
			dp[x][y] = c;
			cnt[x][y] = 1;
		}
		else if(dp[x][y] == c)
		{
			cnt[x][y] ++;
		}
		swap(x,y);
		if(dp[x][y] > c)
		{
			dp[x][y] = c;
			cnt[x][y] = 1;
		}
		else if(dp[x][y] == c)
		{
			cnt[x][y] ++;
		}
	}
	for(int i = 1;i<=n;i++)
	{
		dp[i][i] = 0;
		cnt[i][i] = 1;
	}
	vector<double>ans(maxn);
	for(int k = 1;k<=n;k++)
	{
		for(int i = 1;i<=n;i++)
		{
			for(int j = 1;j<=n;j++)
			{
				if(dp[i][k] == LLONG_MAX || dp[k][j] == LLONG_MAX)
				{
					continue;
				}	
				if(dp[i][k] + dp[k][j] < dp[i][j])
				{
					dp[i][j] = dp[i][k] + dp[k][j];
					cnt[i][j] = cnt[i][k] * cnt[k][j];
			//		cout<<i<<" "<<j<<" "<<dp[i][j]<<" "<<cnt[i][j]<<endl;
				}
				else if(dp[i][j] == dp[i][k] + dp[k][j] && i != k && j != k)
				{
					cnt[i][j] += cnt[i][k] * cnt[k][j];
				}
			}
		}
	}
	for(int k = 1;k<=n;k++)
	{
		for(int i = 1;i<=n;i++)
		{
			for(int j = 1;j<=n;j++)
			{
				if(i != k && j != k && i!= j)
				{
					if(dp[i][k] == LLONG_MAX || dp[k][j] == LLONG_MAX)
					{
						continue;
					}
					if(dp[i][k] + dp[k][j] == dp[i][j])
					{
					//	cout<<i<<" "<<k<<" "<<j<<endl;
						ans[k] += 1.0 * (cnt[i][k] * cnt[k][j]) / cnt[i][j];
 					}
				}	
			}
		}
	}
	for(int i = 1;i<=n;i++)
	{
		printf("%.3lf\n",ans[i]);
	}
	return 0;
}
