#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int maxn = 2e5 + 5;
vector<vector<int>>v(maxn);
vector<int>sz(maxn);
vector<int>dep(maxn);
vector<int>col(maxn);
unordered_map<long long,int>mp;
vector<int>son(maxn);
long long sum = 0;
vector<long long>ans(maxn);
int dl = 0;
void query(int u,int p,int lca)
{
	int kt = dl + 2 * dep[lca] - dep[u];
	long long tar = kt * (n + 1) + col[u];
	if(mp.find(tar) != mp.end())
	{
		sum += mp[tar];
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		query(ed,u,lca);
	}
	return ;
}
void add(int u,int p,int lca)
{
	long long tar = dep[u] * (n + 1) + col[u];
	mp[tar] ++;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		add(ed,u,lca);
	}
	return;
}
void cancel(int u,int p)
{
	long long tar = dep[u] * (n + 1) + col[u];
	mp[tar] --;
	if(mp[tar] == 0)
	{
		mp.erase(tar);
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		cancel(ed,u);
	}
	return;
}
int dfs0(int u,int p)
{
	int d1 = 0;
	int d2 = 0;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		int l1 = dfs0(ed,u);
		if(l1 > d1)
		{
			d2 = d1;
			d1 = l1;
		}
		else if(l1 > d2)
		{
			d2 = l1;
		}
	}
	dl = max(d1 + d2,dl);
	return d1 + 1;
} 
void dfs1(int u,int p)
{
	int mxl = 0;
	int tar = 0;
	sz[u] ++;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dep[ed] = dep[u] + 1;
		dfs1(ed,u);
		sz[u] += sz[ed];
		if(mxl < sz[ed])
		{
			mxl = sz[ed];
			tar = ed;
		}
	}
	son[u] = tar;
	return;
}
void dfs2(int u,int p,int keep,int lca)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p || ed == son[u])
		{
			continue;
		}
		dfs2(ed,u,0,u);
	}
	if(son[u] != 0)//这个时候开始结算u为根节点的子树，LCA就是u了 
	{
		dfs2(son[u],u,1,u);
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p || ed == son[u])
		{
			continue;
		}
		//要先查后加 
		query(ed,u,u);//这个时候开始结算u为根节点的子树，LCA就是u了 
		//这一次要并进来的点 × 表里已经有的点 
		//这个先查后加保证了两两只用配对一次，不重不漏，比如一开始只有1，
		//加入2就1-2，再加入3就1-3,1-2,2-3，加入4就1-4,1-2,1-3,2-4,3-4， 
		add(ed,u,u);//这个时候开始结算u为根节点的子树，LCA就是u了 
		
		//先加后查：新来的 k 先挤进表，
		//表里变成 k 个点（包括它自己）→ 新增 k 对，其中 1 对是“k 跟自己”。
	}
	int kt = dl + 2 * dep[u] - dep[u];
	long long tar = kt * (n + 1) + col[u];
	if(mp.find(tar) != mp.end())
	{
		sum += mp[tar];
	}
	tar = dep[u] * (n + 1) + col[u];
	mp[tar] ++;
	if(keep == 0)
	{
		cancel(u,p);
	}
	return ;
}
//维护map<深度，颜色>个数
void solve()
{
	cin>>n;
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	for(int i = 1;i<=n;i++)
	{
		cin>>col[i];
	}
	int pl = dfs0(1,0);
	//cout<<dl<<endl;
	dfs1(1,0);
	dfs2(1,1,0,1);
	cout<<sum<<endl;
	return;
}
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
	int t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
} 
