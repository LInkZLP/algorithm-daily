#include <bits/stdc++.h>
using namespace std;
vector<vector<int>>v;
int ans = 0;
vector<int>sz;
void dfs(int u,int fa)
{
	long long mx = 0;
	long long sec = 0;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == fa)
		{
			continue;
		}
		dfs(ed,u);
		if(sz[ed] > mx)
		{
			sec = mx;
			mx = sz[ed];
		}
		else if(sz[ed] > sec)
		{
			sec = sz[ed];
		}
	}
	ans += sec + 1;
	sz[u] = mx + 1;
	//需要两条长度至少为次长链的长度才能产生新答案,最长链比次长链多的那部分没有用 
	return;
}
void solve()
{
	int n;
	cin>>n;
	v.assign(n+5,vector<int>());
	sz.assign(n+5,0);
	ans = 0;
	for(int i = 2;i<=n;i++)
	{
		int x;
		cin>>x;
		v[i].push_back(x);
		v[x].push_back(i);
	}
	dfs(1,0);
	cout<<ans<<endl;
}

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
