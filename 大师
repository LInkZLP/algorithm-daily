#include <bits/stdc++.h>
using namespace std;

int n;
// dp[i][k]：以第 i 个电塔结尾，公差映射后为 k 的等差数列方案数（长度 >= 2）
// 第二维大小 40005，意图将公差范围 [-20000, 20000] 映射到 [0, 40000]
vector<vector<long long>> dp(1e3 + 5, vector<long long>(4e4 + 5, 0));
vector<long long> v(1e3 + 5);  // 电塔高度，下标从 1 开始
const long long mod = 998244353;

int main() {
    cin >> n;
    for (int i = 1; i <= n; i++) {
        cin >> v[i];
    }

    // ans 初始化为 n，表示所有长度为 1 的子序列（单个电塔）
    long long ans = n % mod;

    // 枚举子序列的最后一个电塔 i
    for (int i = 2; i <= n; i++) {
        // 枚举子序列的倒数第二个电塔 j
        for (int j = 1; j < i; j++) {
            // 计算公差 diff = h[i] - h[j]
            int k = v[i] - v[j];

            // 【问题点】将负公差映射到非负下标
            // 意图：负公差 + 40000 映射到 [20000, 40000)
            //       正公差保持 [0, 20000]
            // 但这里逻辑错误：当 k < 0 时，k += 40000，会导致正公差也被错误处理
            // 例如 k = 10000（正数），不会进入 if，保持 10000，正确
            // 但正数最大可能到 20000，而负数加 40000 后范围是 [20000, 40000)
            // 这样正公差最大值 20000 和负公差最小值 -20000+40000=20000 冲突了！
            if (k < 0) {
                k += 40000;  // 负公差映射到 [20000, 40000)
            }
            // 正确做法应该是：k = v[i] - v[j] + 20000，让公差范围 [-20000,20000] 整体平移到 [0,40000]

            // 状态转移：
            // 以 j 结尾、公差为 k 的每个方案后面加上 i，形成新方案
            // 再加上新形成的长度为 2 的方案 (j, i) 本身（对应 +1）
            dp[i][k] = (dp[i][k] + dp[j][k] + 1) % mod;

            // ans 累加新增的方案数（即 dp[j][k] + 1）
            ans = (ans + dp[j][k] + 1) % mod;
        }
    }

    cout << ans << endl;
    return 0;
}
