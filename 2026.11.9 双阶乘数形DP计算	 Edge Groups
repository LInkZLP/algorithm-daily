#include<bits/stdc++.h>
using namespace std;
int n;
const int maxn = 1e5 + 5;
vector<vector<int>>v(maxn);
vector<int>sz(maxn);
long long ans = 1;
long long mod = 998244353;
vector<long long>fac(maxn);
vector<long long>infa(maxn);
vector<long long> df(maxn);
long long qpow(long long a,long long b)
{
    long long res = 1;
    a %= mod;
    while(b)
    {
        if(b & 1)
        {
            res = res * a % mod;
        }
        a = a * a % mod;
        b >>= 1;
    }
    return res;
}
void init()
{
    fac[0] = 1;
    for(int i = 1;i<=n;i++)
    {
        fac[i] = fac[i - 1] * i % mod;
    }
    infa[n] = qpow(fac[n],mod - 2);
    for(int i = n;i>=1;i--)
    {
        infa[i - 1] = infa[i] * i % mod;
    }
    
    df[0] = 1;
    df[1] = 1;
    for(int i = 2;i<=n;i++)
    {
        df[i] = df[i - 2] * i % mod;
    }
    return;
}
long long C(int a,int b)
{
    if(b < 0 || b > a)
    {
        return 0;
    }
    return fac[a] * infa[b] % mod * infa[a - b];
}

long long cc(int a)
{    
    if(a == 0)
    {
        return 1;
    }
    if(a & 1)
    {
        return df[a];
    }
    else
    {
        return df[a - 1];
    }
}
void dfs0(int u,int p)
{
    for(int i = 0;i<v[u].size();i++)
    {
        int ed = v[u][i];
        if(ed == p)
        {
            continue;
        }
        sz[u] ++;
        dfs0(ed,u);
    }
    return;
}
void dfs(int u,int p)
{
    for(int i = 0;i<v[u].size();i++)
    {
        int ed = v[u][i];
        if(ed == p)
        {
            continue;
        }
        dfs(ed,u);
    }
    ans = ans * cc(sz[u]) % mod;
    if(sz[u] & 1)
    {
        sz[p] --;
    }
    return;
}
void solve()
{
    cin>>n;
    for(int i = 1;i<= n - 1;i++)
    {
        int x;
        int y;
        cin>>x>>y;
        v[x].push_back(y);
        v[y].push_back(x);
    }
    if(n % 2 == 0)
    {
        cout<<0<<endl;
        return;
    }
    init();
    dfs0(1,0);
    dfs(1,0);
    cout<<ans<<endl;
    return ;
}
int main() 
{
    int t = 1;
    while(t--)
    {
        solve();
    }
    return 0;
}
