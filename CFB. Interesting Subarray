#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		vector<long long>v(n+5);
		//若前后之差为1，对Kd的减少两边等价，不会影响结果 
		//先看最简单的子数组：长度 2 ，一定要从最简单的开始分析 
		int l = 1;
		int r = 1;
		for(int i = 1;i<=n;i++)
		{
			cin>>v[i];
			if(i != 1 && abs(v[i] - v[i-1]) >= 2)
			{
				l = i-1;
				r = i;
			}
		}
		if(l != r)
		{
			cout<<"YES"<<endl<<l<<" "<<r<<endl;
		}
		else
		{
			cout<<"NO"<<endl;
		}
	}
	return 0;
 } 
