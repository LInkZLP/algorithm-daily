#include <bits/stdc++.h>
using namespace std;
//如果某个项目带来的收益不足以弥补它带来的成本，
//我们宁愿放弃这个收益，也不去承担巨大的成本
int n;
int m;
int S;
int T;
struct st{
	int ed;
	int id;
	long long w;
};
vector<int>dep;
vector<int>cur;
const int maxn = 105;
vector<vector<st>>v(maxn);
const long long INF = 1e12;
long long tot;
bool bfs()
{
	dep.assign(maxn,-1);
	dep[S] = 0;
	queue<int>q;
	q.push(S);
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)	
		{
			int nxt = v[u][i].ed;
			if(dep[nxt] == -1 && v[u][i].w)
			{
				dep[nxt] = dep[u] + 1;
				q.push(nxt);		
			}
		}
	}
	cur.assign(maxn,0);
	return dep[T] != -1;
}
long long dfs(int st,long long lim)
{
	if(st == T)
	{
		return lim;
	}
	int u = st;
	for(int i  =cur[u];i<v[u].size();i++)
	{
		cur[u] = i;
		int nxt = v[u][i].ed;
		if(dep[nxt] == dep[u] + 1 && v[u][i].w)
		{
			long long res = dfs(nxt,min(v[u][i].w,lim));
			if(res)
			{
				v[u][i].w -= res;
				v[nxt][v[u][i].id].w += res;
				return res;
			}
			else
			{
				dep[nxt] = -1;
			}
		}
	}
	return 0;
}
long long dinic()
{
	long long res =0 ;
	long long flow = 0;
	while(bfs())
	{
		while(flow = dfs(S,INF))
		{
			res += flow;
		}
	}
	return tot - res;
}
int main()
{
	scanf("%d %d",&m,&n);
	S = 0;
	T = m + n + 1;
	getchar();
	for(int i = 1;i<=m;i++)
	{
	
		string line;
		getline(cin,line);
		stringstream ss(line);
		long long x;
		ss>>x;
		tot += x;
		int sti = v[0].size();
		int edi = v[i].size();
		v[0].push_back({i,edi,x});
		v[i].push_back({0,sti,0});
		int po;
		while(ss >> po)
		{
			int ed = po + m;
			sti = v[i].size();
			edi = v[ed].size();
			v[i].push_back({ed,edi,INF});
			v[ed].push_back({i,sti,0});
		}
	}
	for(int i = m+1;i<=m+n;i++)
	{
		long long w;
		scanf("%lld",&w);
		int sti = v[i].size();
		int edi = v[T].size();
		v[i].push_back({T,edi,w});
		v[T].push_back({i,sti,0});
	}
	long long ans = dinic();
	queue<int>q;
	q.push(S);
	vector<int>vis(maxn,-1);
	vector<int>rea(maxn,0);
	q.push(S);
	vis[S] = 0;
	vector<int>l1;
	vector<int>l2;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int nxt = v[u][i].ed;
			if(vis[nxt] == - 1 && v[u][i].w)
			{
				vis[nxt] = 0;
				rea[v[u][i].ed] = 1;
				if(nxt <= m)
				{
					l1.push_back(nxt);
				}
				else
				{
					l2.push_back(nxt);
				}
				q.push(nxt);
			}
		}
	}
	if(l1.empty())
	{
		printf("0\n");
	}
	else
	{
		for(int k : l1)
		{
			cout<<k<<" ";
		}
		printf("\n");
	}
	if(l2.empty())
	{
		printf("0\n");
	}
	else
	{
		for(int k : l2)
		{
			cout<<k-m<<" ";
		}
		printf("\n");
	}
	printf("%lld\n",ans);
	return 0;
}
