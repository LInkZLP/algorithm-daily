#include <bits/stdc++.h>
using namespace std;
struct st{
	int cnt;
	int va;
};
long long cc(int x)
{
	long long res = 0;
	for(int i = 1;i<=x;i++)
	{
		res += i * (x / i);
	}
	return res;
}
void solve()
{
	int n;
	cin>>n;
	vector<st>ans;
	int sta = 0;
	while(cc(sta) < n)//枚举1最大上界 
	{
		sta ++;
	}
//	cout<<sta<<" ss"<<" "<<sta<<endl; 
	int sum = 0;
	for(int i = sta;i>=2;i--)
	{
		//cout<<i<<" "<<sta/ i<<endl;
		if(sum + i * ( sta / i) > n)
		{
			break;
		}
		ans.push_back({i,sta / i});
		sum += i * (sta/ i);
	//	cout<<i*(sta/i)<<endl;
	}
	ans.push_back({1,n - sum});
	int ptr = 0;
	vector<int>pl(n + 5);
	int yy = 0;
	for(auto i : ans)
	{	
		for(int k = 1;k<=i.va;k++)
		{
			yy ++;
			int p = i.cnt;
			while(p--)
			{
				ptr ++;
				pl[ptr] = yy;
			//	cout<<"ppp"<<endl;
			}
		}
	}
	cout<<sta<<endl;
	for(int i = 1;i<=n;i++)
	{
		cout<<pl[i]<<" ";
	}
	cout<<endl;
	return ;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
 } 
