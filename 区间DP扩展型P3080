#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 1e3+5;
vector<long long>v(maxn,0);
vector<vector<long long>>dp0(maxn,vector<long long>(maxn,LLONG_MAX));
vector<vector<long long>>dp1(maxn,vector<long long>(maxn,LLONG_MAX));
//左右扩展，边界扩展，边界方向 
void solve()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	sort(v.begin() + 1,v.begin() + 1 + n);
	for(int i = 1;i<=n;i++)
	{
		dp0[i][i] = dp1[i][i] = abs(v[i]) * n;
	} 
	for(int len = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1<=n;i ++)
		{
			int j = i + len - 1;
			dp0[i][j] = min(dp0[i+1][j] + (n - j + i) * (v[i+1] - v[i]),dp1[i+1][j] +(n - j + i) * (v[j] - v[i]) );
			dp1[i][j] = min(dp1[i][j-1] + (n - j + i) * (v[j] - v[j-1]),dp0[i][j-1] + (n - j + i) *(v[j] - v[i]));
		}
	}
	cout<<min(dp1[1][n],dp0[1][n])<<endl;
}
int main()
{
	int t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
} 
