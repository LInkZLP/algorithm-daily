#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<long long>val(n + 5);
	for(int i = 1;i<=n;i++)
	{
		cin>>val[i];
	}
	vector<vector<int>>d(n + 5,vector<int>(65,0));
	vector<vector<int>>pre(n + 5,vector<int>(65,0));
	for(int i = 1;i<=n;i++)
	{
		for(int j = 0;j<=60;j++)
		{
			long long sta = 1;
			if(val[i] & (sta << j))
			{
				d[i][j] = 1;
			}
			pre[i][j] = pre[i - 1][j] + d[i][j];
		}
	}
	long long ans = 0;
	long long mod = 1e9 + 7;
	for(int i = 1;i<=n - 1;i++)
	{
		long long sta = 1;
		for(int j = 0;j<=60;j++)
		{
			long long p1 = 1;
			if((val[i] & (p1 << j)) == 0)
			{
				ans = (ans + sta * (pre[n][j] - pre[i][j]) % mod) % mod;;
			}
			else
			{
				int len = n - i;
				ans = (ans + sta * (len - pre[n][j] + pre[i][j]) % mod) % mod;;
			}
			sta = sta * 2 % mod;
		}
	}
	cout<<ans<<endl;
	return ;
}
int main()
{
	int t;
	//cin>>t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
}
