using namespace std;
struct wv{
	int w;
	int v;
};
int n;
const int maxn = 1e4+5;
vector<wv>item(maxn);
//对于满足顺序的i，i+1
//w1 + w2 + w3 +...+wi <= v(i+1)
//交换后不符合条件 
//w1 + w2 +  w3 + w4 + ... + w(i-1) + w ( i + 1) >= vi
//整理得到 vi + wi <= v(i+1) + w(i+1) 
vector<long long>dp(200001,0);
bool cmp(wv a, wv b)
{
	return a.w + a.v< b.w + b.v;
}
int main()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>item[i].w >> item[i].v;
	}
	sort(item.begin()+1,item.begin() + 1 + n,cmp);
	long long ans =0 ;
	for(int i = 1;i<=n;i++)
	{
		for(int j =item[i].w + item[i].v;j>=item[i].w;j-- ) //item[i].v >= w1 + w2 +...+w(i-1)则背包总量为item[i].w+item[i].v 
		{
			dp[j] = max(dp[j],dp[j - item[i].w] + item[i].v);
			ans = max(ans,dp[j]);
		}
		
	}
	cout<<ans<<endl;
	return 0;
}
