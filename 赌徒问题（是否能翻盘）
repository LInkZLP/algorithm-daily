#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int k, x;
        long long a;
        cin >> k >> x >> a;

        // 特殊情况：初始只有1枚硬币，无法下注（必须正整数且≤当前硬币数），肯定不行
        if (a == 1) {
            cout << "no" << endl;
            continue;
        } else {
            long long sum = 0; // 累计已投入的总额（用于计算下一注需要多少才能回本）
            // 最坏情况：连续输 x 次，所以我们必须保证能支撑 x+1 次下注
            for (int i = 1; i <= x + 1; i++) {
                // 第 i 次下注额：要使本次赢时，赢的钱 > 之前所有亏损的总和
                // 赢钱 = 下注额 * (k-1)，因此需要 下注额 * (k-1) > sum
                // 取最小正整数：下注额 = sum / (k-1) + 1
                sum += (sum / (k - 1)) + 1;
                // 如果累计需要的资金已经超过初始本金，则后续无需再算
                if (sum > a) {
                    break;
                }
            }
            // 如果撑过 x+1 次下注所需的总资金超过了 a，则无法保证
            if (sum > a) {
                cout << "no" << endl;
            } else {
                cout << "Yes" << endl;
            }
        }
    }
    return 0;
}

/*
 * ============== 倍投法（Martingale）策略详解 ==============
 * 
 * 经典赌徒问题：
 *   有初始金币，每次下注 y，赢则获得 y*k（即净赚 y*(k-1)），输则失去 y。
 *   不能连续输超过 x 次。
 *   问：是否存在一种下注方式，使得无论想赢多少都能保证达到目标？
 *
 * 核心思想 —— 倍投法（Martingale）：
 *   1. 第一次下注 1 枚，若赢则重新开始（下次仍下注 1）。
 *   2. 若输，则下次下注额翻倍（2, 4, 8, ...）。
 *   3. 这样，只要出现一次胜利，就能把之前所有亏损全部赢回，并且还净赚 1。
 *
 * 数学原理：
 *   假设前 n-1 次全输，累计亏损 S = 1+2+4+...+2^(n-1) = 2^n - 1。
 *   第 n 次下注 2^(n-1)，若赢，则盈利 = 2^(n-1) * (k-1)，
 *   当 k=2 时，盈利 = 2^(n-1)，而累计亏损 = 2^(n-1) - 1，净赚 1。
 *   所以只要本金足够支撑到第 n 次，就必赚。
 *
 * 本题推广：
 *   本题目中赢钱倍数为 (k-1) 而非 1，因此第 i 次下注额 c_i 需满足：
 *       c_i * (k-1) > 前 i-1 次下注总额 sum
 *   即：c_i = sum / (k-1) + 1
 *   这样一旦赢了，不仅覆盖所有亏损，还能净赚至少 1。
 *
 * 连续输不超过 x 次 ⇒ 最坏情况连续输 x 次，则我们需要准备 x+1 次的下注资金。
 * 因此，模拟计算连续 x+1 次下注所需的总资金，若 ≤ 初始资金 a，则必胜，否则不可能。
 *
 * 注意：实际下注金额必须为正整数且不超过当前持有金币数，递推式已保证为正整数，
 *       且我们模拟的是最坏情况下的资金需求，若总需求 ≤ a，则过程中每一步所需金额
 *       也必然 ≤ 当时剩余资金（因为每一步累计不超过总需求）。
 */
