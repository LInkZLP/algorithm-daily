#include <bits/stdc++.h>
using namespace std;
const int maxn = 4e4+5;
bitset<maxn>arr[maxn];
vector<int>v(maxn);
vector<int>ans(maxn);
int main()
{
	int n;
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		arr[i][v[i]] = 1;
	}
	int r = 0;
	for(int i = n;i>=1;i--)
	{
		if(i * 2 <= n)
		{
			arr[i] |= arr[i*2];
		}
		if(i + v[i] <=n)
		{
			arr[i] |= arr[i+v[i]];
		}
		r = max((int)arr[i].count(),r);
	}
	cout<<r<<endl;
	return 0;
}
