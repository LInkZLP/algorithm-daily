#include <bits/stdc++.h>
using namespace std;
int n;
int S;
int m;
int T;
struct st{
	int ed;
	int id;
	int w;
	long long rs;
};
const int maxn = 268;
vector<int>cur;
vector<int>dep;
vector<vector<st>>v(maxn);
const int INF = 1e6;
bool bfs()
{
	queue<int>q;
	q.push(S);
	dep.assign(maxn,-1);
	dep[S] = 0;
	while(!q.empty()) 
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].ed;
			if(dep[ed] == -1 && v[u][i].w)
			{
				dep[ed] = dep[u] + 1;
				q.push(ed);
			}
		}
	}
	cur.assign(maxn,0);
	return dep[T] != -1;
}
int dfs(int u,int lim)
{
	if(u == T)
	{
		return lim;
	}
	for(int i = cur[u];i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		if(dep[ed] == dep[u] + 1 && v[u][i].w)
		{
			int res = dfs(ed,min(v[u][i].w,lim));
			if(res)
			{
				v[u][i].w -= res;
				v[ed][v[u][i].id].w += res;
				return res;
			}
			else
			{
				dep[ed] = -1;
			}
		}
	}
	return 0;
}
int dinic()
{
	int r = 0;
	int f = 0;
	while(bfs())
	{
		while(f = dfs(S,INF))
		{
			r += f;
		}
	}
	return r;
}
void add(int u,int x,int w)
{
	int sti = v[u].size();
	int edi = v[x].size();
	v[u].push_back({x,edi,w,w});
	v[x].push_back({u,sti,0,0});
	return;
}
int main()
{
	cin>>n>>m;
	S = 0;
	T = n * 2 + 1;
	int ut = 0;
	for(int i = 1;i<=n;i++)
	{
		int x;
		cin>>x;
		ut += x;
		add(S,i,x);
		add(i,i+n,x);
	}
	int tot = 0;
	for(int i = 1;i<=n;i++)
	{
		int x;
		cin>>x;
		tot += x;
		add(i + n,T,x);
	}
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		add(x,y + n,INF);
		add(y,x + n,INF);
	}
	int res = dinic();
	if(tot != ut)
	{
		cout<<"NO"<<endl;
		return 0;
	}
	if(res != tot)
	{
		cout<<"NO"<<endl;
		return 0;
	}
	cout<<"YES"<<endl;
	//// 正向边 i -> e.ed 的流量 = 反向边的剩余容量
	for(int i = 1;i<=n;i++)
	{
		vector<int>row(n+5,0);
		for(int j = 0;j<v[i].size();j++)
		{
			int ed = v[i][j].ed;
			if(ed > n && ed <= 2*n)
			{
				int f = v[ed][v[i][j].id].w;
				row[ed- n] = f;
			}
		}
		for(int j = 1;j<=n;j++)
		{
			cout<<row[j]<<" ";
		}
		cout<<endl;
	}
	return 0;
} 
