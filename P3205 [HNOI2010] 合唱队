#include <bits/stdc++.h>
using namespace std;
int t;
int n;
int main()
{
	cin>>n;
	vector<long long>v(n+5);
	vector<vector<long long>>dp0(n+5,vector<long long>(n+5));
	vector<vector<long long>>dp1(n+5,vector<long long>(n+5));
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		dp0[i][i] = 1;
	}
	for(int len = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <=n;i++)
		{
			int j = i + len - 1;
			if(v[i+1] > v[i])
			{
				dp0[i][j] += dp0[i+1][j];
			}
			if(v[j] > v[i])
			{
				dp0[i][j] += dp1[i+1][j];
				dp1[i][j] += dp0[i][j-1];
			}
			if(v[j] > v[j-1])
			{
				dp1[i][j] += dp1[i][j-1];
			}
			dp0[i][j] %= 19650827;
			dp1[i][j] %= 19650827;
		}
	}
	cout<<(dp0[1][n] + dp1[1][n]) % 19650827<<endl;
	return 0;
}
