#include <bits/stdc++.h>
using namespace std;
int n;
int k;
int main()
{
	cin>>n;
	vector<char>v(n+5);
	vector<vector<int>>dp(n+5,vector<int>(n+5,0));
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		dp[i][i] = 1;
	}
	int ans = 1;
	for(int len = 2;len<= n;len ++)
	{
		for(int i = 1;i + len - 1 <= n;i++)
		{
			int j = i + len - 1;
			if(v[i] == v[j])
			{
				if(len == 2)
				{
					dp[i][j] = 2;
				}
				else
				{
					dp[i][j] = max(dp[i + 1][j-1] + 2,dp[i][j]);
				}
			}
			else
			{
				dp[i][j] = max(dp[i + 1][j],max(dp[i][j],dp[i][j-1]));
			}
			ans = max(ans,dp[i][j]);
		}
	}
	cout<<ans<<endl;
	return 0;
}
