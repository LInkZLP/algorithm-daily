#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int S;
int T;
struct st{
	int ed;
	int id;
	long long w;
};
long long INF = 1e5;
const int maxn = 1e3 + 5;
vector<vector<st>>v(maxn<<2);
vector<int>cur;
vector<int>dep;
vector<int>a(maxn);
vector<int>b(maxn);
bool bfs()
{
	dep.assign(maxn<<2,-1);
	dep[S] = 0;
	queue<int>q;
	q.push(S);
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int nxt = v[u][i].ed;
			if(dep[nxt] == -1 && v[u][i].w)
			{
				dep[nxt] = dep[u] + 1;
				q.push(nxt);
			}
		}
	}
	cur.assign(maxn<<2,0);
	return dep[T] != -1;
}
long long dfs(int u,long long lim)
{
	if(u == T)
	{
		return lim;
	}
	for(int i = cur[u];i<v[u].size();i++)
	{
		cur[u] = i;
		int nxt = v[u][i].ed;
		if(dep[nxt] == dep[u] + 1 && v[u][i].w)
		{
			long long res = dfs(nxt,min(lim,v[u][i].w));
			if(res)
			{
				v[u][i].w -= res;
				v[nxt][v[u][i].id].w += res;
				return res;	
			} 
			else
			{
				dep[nxt] = -1;
			}
		}
	}
	return 0;
}
long long dinic()
{
	long long r = 0;
	long long f = 0;
	while(bfs())
	{
		while(f = dfs(S,INF))
		{
			r += f;
		}
	}
	return r;
}
int main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	cout.tie(nullptr);
	cin>>n;
	S = 0;
	long long tot = 0;
	for(int i = 1;i<=n;i++)
	{
		long long w;
		cin>>w;
		int sti = v[S].size();
		int edi = v[i].size();
		tot += w;
		v[S].push_back({i,edi,w});
		v[i].push_back({S,sti,0});
	}
	for(int i = 1;i<=n;i++)
	{
		long long w;
		cin>>b[i];
	}
	cin>>m;
	T = m * 2+ n + 1;
	for(int i = 1;i<=n;i++)
	{
		long long w;
		w = b[i];
		tot += w;
		int sti = v[i].size();
		int edi = v[T].size();
		v[i].push_back({T,edi,w});
		v[T].push_back({i,sti,0});
	}
	int sta = n;
	for(int i = 1;i<=m;i++)
	{
		int k;
		long long c1;
		long long c2;
		cin>>k>>c1>>c2;
		sta++;
		tot += c1 + c2;
		int sti = v[S].size();
		int edi = v[sta].size();
		v[S].push_back({sta,edi,c1});
		v[sta].push_back({S,sti,0});
		int nt = sta + 1;
		sti = v[nt].size();
		edi = v[T].size();
		v[nt].push_back({T,edi,c2});
		v[T].push_back({nt,sti,0});
		for(int j = 1;j<=k;j++)
		{
			int x;
			cin>>x;
			sti = v[sta].size();
			edi = v[x].size();
			v[sta].push_back({x,edi,INF});
			v[x].push_back({sta,sti,0});
			
			sti = v[x].size();
			edi = v[nt].size();
			v[x].push_back({nt,edi,INF});
			v[nt].push_back({x,sti,0});
		}
		sta +=2;
	}
	cout<<tot - dinic()<<endl;
	return 0;
}
