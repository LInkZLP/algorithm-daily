#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	long long k;
	cin>>n>>k;
	vector<long long>a(n + 5);
	for(int i = 1;i<=n;i++)
	{
		cin>>a[i];
	}
	vector<long long>d(k * 2 + 5);
	for(int i = 1;i<=n / 2;i++)
	{
		long long mx = max(a[i],a[n - i + 1]);
		long long mi = min(a[i],a[n - i + 1]);
		d[2] += 2;
		d[mi + 1] -= 2; 
		d[mi + 1] ++;
		d[a[i] + a[n - i + 1]] --;
		d[a[i] + a[n - i + 1] + 1] ++;
		d[mx + k + 1] --;
		d[mx + k + 1] += 2;
		d[k * 2 + 1] -= 2; 
	}
	long long ans = LLONG_MAX;
	for(int i = 2;i<=2*k;i++)
	{
		d[i] += d[i - 1];
		ans = min(ans,d[i]);
	}
	cout<<ans<<endl;
	return ;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
