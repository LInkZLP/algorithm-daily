#include <bits/stdc++.h>
using namespace std;
int n;
int k;
//一种剪枝思路，n的复杂度一定根据前面的影响，并且取数唯一确定，我们要避免遍历可取范围，直接用是否整除判断
void dfs(int pos,int sum,int tar,vector<int>ans)
{
	if(pos == n + 1)
	{
		if(sum != tar)
		{
			return;
		}
		for(int i = 1;i<=n;i++)
		{
			cout<<ans[i]<<" ";
		}
		cout<<'\n';
		return;
	}
	else if(pos == n)
	{
		int re = tar - sum;
		if(re % n == 0)
		{
			ans[n] = re / n;
			dfs(pos + 1,tar,tar,ans);
		}
		return;
	}
	else
	{
		for(int i = 0;i<=(tar - sum)/pos;i++)
		{
			int ns = sum + i * pos;
			ans[pos] = i;
			if(ns > tar)
			{
				return;
			}
			if(tar - ns != 0 && tar - ns < pos + 1)
			{
				continue;
			}
			dfs(pos + 1,ns,tar,ans);
		}
	}
	return;
}
void solve()
{
	cin>>n>>k;
	vector<int>ans(13);
	dfs(1,0,k,ans);
	return;
}
int main()
{
	int t;
	//cin>>t;
	t = 1;
	while(t--)
	{
		solve(); 
	}
	return 0;
}
