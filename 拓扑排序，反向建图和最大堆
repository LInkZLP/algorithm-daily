#include <bits/stdc++.h>
using namespace std;

/*
 * 题目类型：拓扑排序 + 优先队列（最大堆） + 逆向思维
 *
 * 核心技巧：
 *   1. 反图建边：将原问题“编号小的尽量靠前”转化为反图上“编号大的尽量靠前”。
 *   2. 最大堆拓扑排序：在反图上每次取出编号最大的入度为0的节点，保证反图拓扑序中编号大的优先。
 *   3. 结果反转：反图的拓扑序反转后，即得到原图满足条件的最优顺序。
 *
 * 算法思路：
 *   - 原题要求：在满足所有偏序关系 (x 先于 y) 的前提下，让编号 1 尽量靠前，然后 2，3...
 *   - 等价转化：建立反图，原边 x->y 变成反边 y->x。在反图中，原图的“小号优先”变成“大号优先”。
 *     因为反图拓扑序中 y 出现在 x 之前，反转后 x 就在 y 之前，且大号先出保证了小号在后反转时靠前。
 *   - 具体步骤：
 *       1. 读入 n, m，建立反图邻接表 rev，计算反图入度 indeg。
 *       2. 使用 priority_queue<int>（最大堆）存储所有入度为 0 的节点。
 *       3. 循环弹出堆顶（当前最大编号节点），加入 ans，并遍历其出边，将后继入度减 1，若变为 0 则入堆。
 *       4. 若 ans.size() == n，则无环；否则有环（输出 Impossible!）。
 *       5. 将 ans 反转，输出即为原图的最优顺序。
 *
 * 时间复杂度：O((n + m) log n)，使用堆优化，适用于 n, m ≤ 1e5。
 * 空间复杂度：O(n + m)。
 */

const int maxn = 1e5+5;
int n;      // 菜肴数量（节点数）
int m;      // 边数（但在代码中被复用为标志位，注意变量冲突，实际含义见注释）
int t;      // 测试组数

/**
 * 拓扑排序函数（在反图上使用最大堆）
 * @param v  邻接表（反图，即原图边 (x,y) 变为 v[y].push_back(x)）
 * @param jd 入度数组（对应反图的入度）
 * @param ans 输出答案序列（仅在 m==0 时记录）
 * @return true 表示无环（排序成功），false 表示有环
 *
 * 知识点：
 *   - 拓扑排序：对有向无环图（DAG）的所有顶点进行线性排序，使得对每条边 u->v，u 都出现在 v 之前。
 *   - 最大堆（优先队列）：每次取最大元素，时间复杂度 O(log n)。
 *   - 临时入度数组：模拟删除节点过程，不破坏原入度数据。
 *   - 环检测：若最终处理的节点数 cnt != n，说明存在环（即有向图中存在循环依赖）。
 *
 * 注意：这里的全局变量 m 被复用为标志位：
 *       当 m == 0 时记录答案，当 m == 1 时只检测环不记录。
 *       这种写法不推荐，但为了保留原风格，此处注释说明。
 */
bool work(vector<vector<int>>& v, vector<int>& jd, vector<int>& ans)
{
    priority_queue<int> q;          // 最大堆，每次取出编号最大的入度为0的节点
    vector<int> temp = jd;          // 临时入度数组，用于模拟删除节点

    // 初始将所有入度为0的节点加入最大堆
    for(int i = 1; i <= n; i++)
    {
        if(jd[i] == 0)
        {
            q.push(i);
        }
    }

    int cnt = 0;                    // 已处理的节点数
    while(!q.empty())
    {
        int now = q.top();          // 取出当前最大编号节点（反图视角）
        q.pop();
        cnt++;

        // 只有当 m == 0 时才记录答案（第二次调用 work 时）
        // 这样可以通过修改全局 m 来控制是否生成结果序列
        if(m == 0)
        {
            ans.push_back(now);
        }

        // 遍历当前节点的所有后继（在反图中，这些是原图的前驱）
        for(int i = 0; i < v[now].size(); i++)
        {
            int next = v[now][i];
            temp[next]--;           // 删除边 now->next，后继入度减1
            if(temp[next] == 0)     // 若入度变为0，则加入堆
            {
                q.push(next);
            }
        }
    }

    // 如果处理的节点数不等于 n，说明存在环（有向图中存在循环依赖）
    if(cnt != n)
        return false;
    return true;
}

int main()
{
    cin >> t;
    while(t--)
    {
        cin >> n >> m;

        // 邻接表（反图），大小固定为 maxn，节点编号从 1 开始
        vector<vector<int>> v(maxn);
        vector<int> jd(maxn, 0);    // 入度数组（反图的入度）
        bool check = true;          // 标记是否有解（无环）
        vector<int> ans;            // 存储拓扑排序的结果（反图顺序）

        // 读入所有边，建立反图
        // 原题限制：x 号菜肴必须先于 y 号菜肴制作，即原图有向边 x -> y
        // 反图建边：y -> x，表示在反图中 y 必须先于 x
        while(m--)
        {
            int x, y;
            cin >> x >> y;
            v[y].push_back(x);      // 反图加边
            jd[x]++;                // 反图中 x 的入度增加
        }

        // 第一次调用 work，只检查是否有环（不记录答案）
        // 将全局 m 临时赋为 1，使得 work 中的 if(m==0) 不成立，ans 不变
        m = 1;
        if(check)
        {
            if(!work(v, jd, ans))
            {
                check = false;      // 有环，标记无解
            }
        }

        // 第二次调用 work，记录答案（m == 0）
        m = 0;
        if(check)
        {
            // 对每个节点的邻接表排序（其实不是必须的，最大堆不依赖邻接表顺序）
            // 但排序后可能使遍历顺序确定，对调试有帮助，不影响正确性
            for(int i = 1; i <= n; i++)
            {
                sort(v[i].begin(), v[i].end());
            }

            // 此时图已经无环，work 一定返回 true
            bool p = work(v, jd, ans);   // p 一定为 true

            // ans 中存储的是反图的拓扑序（最大堆得到的是编号递减顺序）
            // 反转后得到原图的最优顺序（编号小的尽量靠前）
            // 知识点：反转操作是“反图拓扑序”转“原图最优序”的关键步骤
            for(int i = ans.size() - 1; i >= 0; i--)
            {
                cout << ans[i] << " ";
            }
            cout << endl;
        }
        else
        {
            cout << "Impossible!" << endl;
        }
    }
    return 0;
}
