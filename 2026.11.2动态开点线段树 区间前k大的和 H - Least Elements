#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int k;
const int maxn = 6e6 + 5;
vector<long long>sum(maxn);
vector<int>cnt(maxn);
vector<int>ls(maxn);
vector<int>rs(maxn);
int tot = 1;
struct st{
	long long ss;
	int c;
};
void up(int i)
{
	sum[i] = sum[ls[i]] + sum[rs[i]];
	cnt[i] = cnt[ls[i]] + cnt[rs[i]];
	return; 
}
void change(int l,int r,int i,int jobl,int jobr,int jobv,int k)
{
	if(l >= jobl && r <= jobr)
	{
		sum[i] += jobv;
		cnt[i] += k;
		return;
	}
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		if(!ls[i])
		{
			tot ++;
			ls[i] = tot;
		}
		change(l,mid,ls[i],jobl,jobr,jobv,k);
	}
	if(mid + 1 <= jobr)
	{
		if(!rs[i])
		{
			tot ++;
			rs[i] = tot;
		}
		change(mid + 1,r,rs[i],jobl,jobr,jobv,k);
	}
	up(i);
}
st query(int l,int r,int i,int jobl,int jobr)
{
	if(l >= jobl && r <= jobr)
	{
		return {sum[i],cnt[i]};
	}
	long long s = 0;
	int c = 0;
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		if(!ls[i])
		{
			tot ++;
			ls[i] = tot;
		}
		st res = query(l,mid,ls[i],jobl,jobr);
		s += res.ss;
		c += res.c;
	}
	if(mid + 1 <= jobr)
	{
		if(!rs[i])
		{
			tot ++;
			rs[i] = tot;
		}
		st res = query(mid + 1,r,rs[i],jobl,jobr);
		s += res.ss;
		c += res.c;
	}
	return {s,c};
}
void solve()
{
	cin>>n>>m>>k;
	vector<long long>val(maxn);
	for(int i = 1;i<=n;i++)
	{
		cin>>val[i];
	}
	for(int i = 1;i<=m - 1;i++)
	{
		change(1,1e9,1,val[i],val[i],val[i],1);
	}
	for(int i = m;i<=n;i++)
	{
		change(1,1e9,1,val[i],val[i],val[i],1);
	//	cout<<"sum "<<i<<" "<<query(1,1e9,1,1,1e9).ss<<" "<<query(1,1e9,1,1,1e9).c<<endl;
		long long r = 1e9;
		int ac = 0;
		long long ans = 0;
		long long ed = 0;
		long long l = 1;
		while(r >= l)
		{
			long long mid = (l + r)>>1;
			st res = query(1,1e9,1,1,mid);
			int rc = res.c;
			long long rs = res.ss;
			if(rc <= k)
			{
				ac = rc;
				ans = rs;
				l = mid + 1;
				ed = mid;
			}
			else
			{
				r = mid - 1;
			}
		}
		//解决0头
		long long tv = 0;
		//cout<<ans<<endl;
		if(k > ac)
		{
			tv = (k - ac) * (ed + 1);
		}
		cout<<ans + tv<<" ";
		change(1,1e9,1,val[i - m + 1],val[i - m + 1],-val[i- m + 1],-1);
	}
	return;
}
int main()
{	
	int t = 1;
	//cin>>t;
	while(t--)
	{
		solve();
	}
	
	return 0;
} 
