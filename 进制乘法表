#include <bits/stdc++.h>
using namespace std;

int n;  // 全局变量，表示进制数

/**
 * 将十进制数x转换为y进制字符串
 * @param x 要转换的十进制数
 * @param y 目标进制
 * @return y进制表示的字符串
 */
string work(int x, int y) {
    string now;  // 临时存储转换结果（从低位到高位）
    
    // 核心算法：除y取余法
    // 从最低位开始，依次取出每一位
    while(x > 0) {
        int add = x % y;  // 取余数，得到当前最低位
        
        // 将数字转换为对应的字符
        if(add >= 10) {
            // 10以上用大写字母表示：10→A, 11→B, 12→C, ...
            // add-10得到0-25的偏移量，加上'A'得到对应字母
            now += add - 10 + 'A';
        } else {
            // 0-9直接用数字字符表示
            // add + '0' 将数字转换为字符，如 5→'5'
            now += add + '0';
        }
        
        x /= y;  // 去掉最低位，继续处理高位
    }
    
    // 由于上面得到的是从低位到高位的顺序
    // 需要反转才能得到正确的高位到低位顺序
    reverse(now.begin(), now.end());  // 反转字符串
    
    return now;  // 返回y进制字符串
}

int main() {
    cin >> n;  // 输入进制数
    int r = n - 1;  // 乘法表的最大数字
    
    // 输出n进制下的下三角乘法表
    // i是被乘数，j是乘数，且j≤i
    for(int i = 1; i <= r; i++) {
        for(int j = 1; j <= i; j++) {
            // 注意：i和j本身是十进制数，需要先转换成n进制再输出
            // 乘积i*j也需要转换成n进制
            cout << work(i, n) << "*" << work(j, n) << "=" << work(i * j, n);
            
            // 控制空格：每个算式后跟一个空格，行末无空格
            if(j < i) cout << " ";
        }
        cout << endl;  // 每行结束后换行
    }
    
    return 0;
}
