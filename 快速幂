#include <bits/stdc++.h>

using namespace std;
//使用了mod的运算 ： （a * b） mod m = ((a)modm * (b)modm) mod m
//任何数都可以用若干个唯一的二进制表示，这个可以应用到多物品背包问题
long long dh(long long a,int p,int m)
{
	long long res = 1%m;
	a %= m;
	while(p)
	{
		if(p & 1)
		{
			res = (res * a) % m;
		}
		a = (a * a) % m;
		p>>=1;
	}
	
	return res;
}


int main()
{
	long long a;
	int p;
	int m;
	cin>>a>>p>>m;
	cout<<a<<"^"<<p<<" "<<"mod"<<" "<<m<<"="<<dh(a,p,m);
	
	return 0;
	
	
}
