#include <bits/stdc++.h>
using namespace std;

vector<long long> tail1; // 用于贪心维护“最长不上升子序列”的末尾值数组（非递增）
vector<long long> tail2; // 用于贪心维护“最长严格上升子序列”的末尾值数组（严格递增）
//Dilworth 定理:
//最少的不上升子序列的个数就是最长上升子序列的长度。
int main() {
    vector<long long> a;
    long long x;
    while (cin >> x) {
        a.push_back(x);
    }
    int n = a.size();
    if (n == 0) {
        cout << 0 << endl << 0 << endl;
        return 0;
    }

    // ========= 第一问：最长不上升子序列（允许相等） =========
    // 贪心策略：维护数组 tail1，其中 tail1[k] 表示长度为 k+1 的不上升子序列的末尾元素的**最大值**。
    // tail1 是非递增的（即 tail1[0] >= tail1[1] >= ...）。
    // 对于新元素 u，我们要在 tail1 中找到第一个 **小于 u** 的位置 p。
    //   - 若 p 存在，则用 u 替换 tail1[p]（因为 u 更大，使该长度的末尾更大，有利于后续接更多数）。
    //   - 若 p 不存在（即所有 tail1 元素都 >= u），则 u 可以追加到末尾，形成更长的子序列。
    // 为什么找“第一个 < u”而不是“<= u”？
    //   因为允许相等，当 tail1[mid] == u 时，u 可以接在末尾为 u 的子序列后面（形成长度+1），
    //   但若我们在这里替换掉，就会错过延长序列的机会。所以必须跳过相等，只替换严格小于的。
    for (long long u : a) {
        int l = 0, r = tail1.size() - 1;
        int p = -1; // 记录第一个小于 u 的位置
        while (l <= r) {
            int mid = (l + r) >> 1;
            if (tail1[mid] < u) {
                p = mid;
                r = mid - 1; // 继续向左找更靠前的小于 u 的位置（因为要第一个）
            } else {
                l = mid + 1; // tail1[mid] >= u，向右找
            }
        }
        if (p == -1) {
            tail1.push_back(u); // 所有都 >= u，追加
        } else {
            tail1[p] = u;       // 替换第一个小于 u 的位置
        }
    }

    // ========= 第二问：最长严格上升子序列 =========
    // 贪心策略：维护数组 tail2，其中 tail2[k] 表示长度为 k+1 的严格上升子序列的末尾元素的**最小值**。
    // tail2 是严格递增的（tail2[0] < tail2[1] < ...）。
    // 对于新元素 u，我们要在 tail2 中找到第一个 **大于等于 u** 的位置 p。
    //   - 若 p 存在，则用 u 替换 tail2[p]（因为 u 更小，使该长度的末尾更小，有利于后续）。
    //   - 若 p 不存在（即所有 tail2 元素都 < u），则 u 可以追加到末尾，形成更长的子序列。
    // 为什么找“第一个 >= u”而不是“> u”？
    //   因为严格上升不允许相等，当 tail2[mid] == u 时，不能将 u 接在后面形成更长序列，
    //   但可以用 u 替换掉这个相等的位置（保持长度不变，末尾值不变，但维持严格递增）。
    //   若用“> u”，则相等时会被跳过，导致 u 被误认为可以追加，从而破坏严格递增性（出现相等元素）。
    for (long long u : a) {
        int l = 0, r = tail2.size() - 1;
        int p = -1; // 记录第一个大于等于 u 的位置
        while (l <= r) {
            int mid = (l + r) >> 1;
            if (tail2[mid] >= u) {
                p = mid;
                r = mid - 1; // 继续向左找更靠前的 >= u 的位置
            } else {
                l = mid + 1; // tail2[mid] < u，向右找
            }
        }
        if (p == -1) {
            tail2.push_back(u); // 所有都 < u，追加
        } else {
            tail2[p] = u;       // 替换第一个 >= u 的位置
        }
    }

    // 输出结果
    // tail1.size() 是最长不上升子序列的长度，即一套系统最多拦截的导弹数。
    // tail2.size() 是最长严格上升子序列的长度，根据 Dilworth 定理，
    // 它等于将原序列划分成最少的不上升子序列的个数，即最少需要的系统数。
    cout << tail1.size() << endl << tail2.size() << endl;
    return 0;
}
