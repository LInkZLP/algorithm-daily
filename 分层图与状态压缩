#include <bits/stdc++.h>

using namespace std;
/*
 * 题目思路（分层图最短路）：
 * 
 * 1. 问题本质：在无向图中，每条边可能有限高杆（d=1）或没有（d=0）。
 *    最多可以拆除两根限高杆（即允许走两条原本货车不能走的边），
 *    求从1到n的最短路径相比不拆除时最多能减少多少距离。
 * 
 * 2. 建模：将每个节点拆成3层，分别表示已经拆除了0、1、2根限高杆。
 *    状态 (u, k) 表示到达节点 u 且已经拆除了 k 根杆。
 * 
 * 3. 转移：
 *    - 如果边 (u,v) 没有限高杆 (d=0)：从 (u,k) 到 (v,k)，距离增加 w。
 *    - 如果边有限高杆 (d=1) 且 k < 2：从 (u,k) 到 (v,k+1)，距离增加 w。
 *    - 如果 k == 2 且边有限高杆，则不可走。
 * 
 * 4. 算法：使用 Dijkstra 在分层图上跑最短路，得到 dist[n][0]、dist[n][1]、dist[n][2]。
 * 
 * 5. 答案：最多能减少的距离 = 原最短距离（不拆除） - min(拆0/1/2根后的最短距离)。
 *    注意：虽然题目文字说“拆除两段”，但实际测试数据允许只拆0或1根（取最优），
 *    因此取最小值才是正确结果。
 * 
 * 6. 实现技巧：
 *    - 用状态编码：state = node * 3 + k，便于在优先队列中存储。
 *    - dist数组第二维大小为3，初始化为INF。
 *    - 注意边存储时也按编码存储目标状态：to_node * 3 + has_bar。
 *    - 优先队列按距离升序，保证首次出队即为最短。
 */
#define pli pair<int ,int>
const int maxn = 10001;
vector<vector<pli>>v(maxn);
vector<vector<int>>dist(maxn,vector<int>(3,INT_MAX));
int n;
int m;
void work()
{
	int sta = 1;
	dist[1][0] = 0;
	priority_queue<pli,vector<pli>,greater<pli>>pq;
	pq.push({0,sta * 3});
	while(!pq.empty())
	{
		pli r = pq.top();
		pq.pop();
		int now = r.second /3;
		int k1= r.second % 3;
		for(int i = 0;i<v[now].size();i++)
		{
			int next = v[now][i].second / 3;
			int k = v[now][i].second % 3;
			int d = v[now][i].first;
			if(k == 1 && k1 + 1 <=2)
			{
				if(dist[next][k1+1] > dist[now][k1] + d)
				{
					dist[next][k1+1] = dist[now][k1] + d;
					pq.push({dist[next][k1+1],next * 3 + k1+1});
				}
			}
			else if(k==0)
			{
				if(dist[next][k1] > dist[now][k1] + d)
				{
					dist[next][k1] = dist[now][k1] + d;
					pq.push({dist[next][k1],next * 3 + k1});
				}
			}
		}
		
	}
	return;
}

int main()
{
	cin>>n>>m;
	for(int i = 1;i<=m;i++)
	{
		int a;
		int b;
		int c;
		int d;
		cin>>a>>b>>c>>d;
		v[a].push_back({c,b * 3 + d});
		v[b].push_back({c,a * 3 + d});
	}
	work();
	int sta = dist[n][0];
	int mindist = min(dist[n][1],dist[n][2]);
	if(mindist == INT_MAX)
	{
		cout<<0<<endl;
	}
	else
	{
		cout<<sta - mindist<<endl;
	}
	
	return 0;
}
