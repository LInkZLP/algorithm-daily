#include <bits/stdc++.h>
using namespace std;

void solve()
{
	int n;
	int k; 
	cin>>n>>k;
	vector<long long>a(n+5);
	vector<long long>b(n+5);
	for(int i = 1;i<=n;i++)
	{
		cin>>a[i];
	}
	for(int i = 1;i<=n;i++)
	{
		cin>>b[i];
	}
	vector<long long>dp1(n+5,-1e9);
	vector<long long>dp2(n+5,-1e9);
	vector<long long>dp3(n+5,-1e9);
	long long ans1 = LLONG_MIN;
	long long ans2 = LLONG_MIN;
	for(int i = 1;i<=n;i++)
	{
		dp1[i] = max(dp1[i-1] + a[i],a[i]);
	}
	for(int i = n;i>=1;i--)
	{
		dp2[i] = max(dp2[i+1] + a[i],a[i]);
	}
	for(int i = 1;i<=n;i++)
	{
		long long res = max(dp1[i-1],0LL) + a[i] + max(dp2[i+1],0LL);
		ans1 = max(res,ans1);
		ans2 = max(ans2,res + b[i]);
	//	cout<<res<<endl;
	}
	if(k & 1)
	{
		cout<<ans2<<endl;
	}
	else
	{
		cout<<ans1<<endl;
	}
	return;
}

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
