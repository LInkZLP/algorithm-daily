#include <bits/stdc++.h>
using namespace std;

/*
 * 【题意】
 * 用恰好 p 根单位线段和 q 个 L 型拼块（可以旋转）拼成一个 n×m 的网格。
 * 求任意一组合法的正整数 n, m；无解输出 -1。
 *
 * 【核心思路：边数守恒】
 * 1. n×m 网格中共有多少条单位边？
 *    - 水平边：每行有 m 条，共 (n+1) 行  → (n+1)*m
 *    - 垂直边：每列有 n 条，共 (m+1) 列  → n*(m+1)
 *    总边数 = (n+1)m + n(m+1) = 2nm + n + m
 *
 * 2. 我们拥有的“边”数：
 *    - p 根单位线段，每根是一条边
 *    - q 个 L 型拼块，每个由 2 条边组成
 *    总共能提供的边数 = p + 2q
 *
 *    所以必须满足：2nm + n + m = p + 2q
 *
 * 3. 把等式变形为乘积形式：
 *    两边同时乘 2 再加 1：
 *    4nm + 2n + 2m + 1 = 2p + 4q + 1
 *    左边恰好是 (2n+1)(2m+1)
 *    所以 (2n+1)(2m+1) = 2p + 4q + 1 = T
 *
 * 4. 于是问题转化为：把 T 分解成两个 ≥3 的奇数因子 a, b
 *    a = 2n+1, b = 2m+1
 *    得到 n = (a-1)/2, m = (b-1)/2
 *
 * 【第二个必要条件：L 型拼块要放得下】
 * 仅仅满足边数守恒还不够，还需要保证 q 个 L 型拼块真的能摆进网格。
 * 一个 L 型拼块会消耗一条水平边和一条垂直边，所以：
 *    - 需要 q 条水平边，网格有 nm + m 条  → q ≤ nm + m
 *    - 需要 q 条垂直边，网格有 nm + n 条  → q ≤ nm + n
 * 两个不等式同时成立，等价于：
 *    q ≤ nm + min(n, m)
 * 如果不满足这个条件，即使边数守恒，也无法放下所有拼块。
 *
 * 【样例 5 验证】
 * p=2, q=10 → T = 45
 * 因子 3×15 → n=1, m=7：nm+min(n,m) = 7+1 = 8 < 10，不合法
 * 因子 5×9  → n=2, m=4：nm+min(n,m) = 8+2 = 10 ≥ 10，合法 ✓
 * 所以要继续找下一个因子，不能遇到第一个就输出。
 */

void solve()
{
    long long p, q;
    cin >> p >> q;

    // T = (2n+1)(2m+1)
    long long T = 2 * p + 4 * q + 1;

    // 枚举 T 的一个奇数因子 i（从 3 开始，因为 2n+1 ≥ 3）
    for(long long i = 3; i * i <= T; i += 2)
    {
        if(T % i == 0)
        {
            long long a = i;          // a = 2n+1
            long long b = T / i;      // b = 2m+1
            long long n = (a - 1) / 2;
            long long m = (b - 1) / 2;

            // 检查 L 型拼块是否放得下
            if(q <= n * m + min(n, m))
            {
                cout << n << " " << m << endl;
                return;
            }
            // 放不下就继续找下一个因子
        }
    }
    cout << -1 << endl;
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while(t--) solve();
    return 0;
}
