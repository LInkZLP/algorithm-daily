#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int S;
int T;
const int maxn = 400;
struct st{
	int ed;
	int id;
	int w;
	int c;
};
vector<vector<st>>v(maxn);
vector<int>dis;
vector<int>inq;
vector<int>preV;
vector<int>preE;
int INF = 1e8;
bool spfa()
{
	queue<int>q;
	inq.assign(maxn,0);
	preV.assign(maxn,0);
	dis.assign(maxn, INF);
	preE.assign(maxn,0);
	q.push(S);
	dis[S] = 0;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		inq[u] = 0;
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].ed;
			if(v[u][i].w && dis[ed] > dis[u] + v[u][i].c)
			{
				dis[ed] = dis[u] + v[u][i].c;
				preV[ed] = u;
				preE[ed] = i;
				if(inq[ed])
				{
					continue;
				}
				q.push(ed);
				inq[ed] = 1;
			}
		}
	}
	return dis[T] != INF;
}
void add(int u,int x,int w,int c)
{
	int sti = v[u].size();
	int edi = v[x].size();
	v[u].push_back({x,edi,w,c});
	v[x].push_back({u,sti,0,-c});
	return;
}
int work()
{
	long long flow = 0;
	long long cost = 0;
	while(spfa())
	{
		int f = INF;
		for(int u = T;u!= S; u = preV[u])
		{
			f= min(f,v[preV[u]][preE[u]].w);		
		}
		for(int u = T; u!= S;u = preV[u])
		{
			v[preV[u]][preE[u]].w -= f;
			v[u][v[preV[u]][preE[u]].id].w += f;
		}
		flow += f;
		cost += f *dis[T];
	}
	return cost;
}
int main()
{
	cin>>n;
	S = 0;
	T = n*2 + 1;
	vector<vector<int>>mp(maxn,vector<int>(maxn,0));
	for(int i = 1;i<=n;i++)
	{
		add(S,i,1,0);
	}
	for(int i = 1;i<=n;i++)
	{
		add(i + n,T,1,0);
	}
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=n;j++)
		{
			int x;
			cin>>x;
			add(i,j + n,1,x);
			mp[i][j + n] = x;
		}
	}
	vector<vector<st>>g = v;
	int ans1 = work();
	v.clear();
	v.assign(maxn,vector<st>());
	for(int i = 1;i<=n;i++)
	{
		add(S,i,1,0);
	}
	for(int i = 1;i<=n;i++)
	{
		add(i + n,T,1,0);
	}
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1 + n;j<=2 * n;j++)
		{
			add(i,j,1,-mp[i][j]);
		}
	}
	cout<<ans1<<endl<<-work()<<endl;
	return 0;
}
