#include <bits/stdc++.h>
using namespace std;
int n;
int q;
int m;
int tot = 1;
const int maxn = 7e6 + 5;
vector<long long>sum(maxn<<2);
vector<long long>ls(maxn<<2);
vector<long long>rs(maxn<<2);
vector<long long>cc(maxn<<2,0);
void up(int i)
{
	sum[i] = sum[ls[i]] + sum[rs[i]];
	if(!sum[ls[i]] && !sum[rs[i]])
	{
		cc[i] = 1;
	}
}
void down(int i,long long l,long long mid,long long r)
{
	if(!ls[i])
	{
		tot ++;
		ls[i] = tot;
		sum[ls[i]] = mid - l + 1;
	}
	if(!rs[i])
	{
		tot ++;
		rs[i] = tot;
		sum[rs[i]] = r - mid;
	}
	return;
}
void change(long long l,long long r,int i,long long jobl,long long jobr)
{
	if(cc[i])
	{
		return;
	}
	if(l >= jobl && r <= jobr)
	{
		sum[i] = 0;
		cc[i] = 1;
		return;
	}
	long long mid = (l + r)>>1;
	down(i,l,mid,r);
	if(mid >= jobl)
	{
		change(l,mid,ls[i],jobl,jobr);
	}
	if(mid + 1 <= jobr)
	{
		change(mid + 1,r,rs[i],jobl,jobr);
	}
	up(i);
	return;
}
long long query(long long l,long long r,int i,long long jobl,long long jobr)
{
	if(cc[i])
	{
		return 0;
	}
	if(l >= jobl && r <= jobr)
	{
		return sum[i];
	}
	long long mid = (l + r)>>1;
	down(i,l,mid,r);
	long long ans = 0;
	if(mid >= jobl)
	{
		ans += query(l,mid,ls[i],jobl,jobr);
	}
	if(mid + 1 <= jobr)
	{
		ans += query(mid + 1,r,rs[i],jobl,jobr);	
	}
	return ans;
}
int main()
{
	cin>>n>>q;
	sum[1] = n;
	//for
	while(q--)
	{
		long long l;
		long long r;
		cin>>l>>r;
		change(1,n,1,l,r);
		cout<<sum[1]<<endl;
	}
	return 0;
}
