#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	if(n == 1)
	{
		cout<<"Yes"<<endl;
		cout<<1<<endl;
		return ;
	}
	if(n == 2)
	{
		cout<<"No"<<endl;
		return;
	}
	long long temp = 2;
	vector<long long>ans;
	int pl = sqrt(n);
	if(pl * (pl + 1) == n)
	{
		
		long long u = 2;
		for(int i = 1;i<=n - 2;i++)
		{
			ans.push_back(temp);
			temp = u * (u + 1);
			u ++;
			if(temp > 1e9)
			{
				cout<<"No"<<endl;
				return;
			}
		}
		ans.push_back(u - 1);
		ans.push_back(2);
		cout<<"Yes"<<endl;
		for(int i = 0;i<n;i++)
		{
			if(i == n - 1)
			{
				cout<<ans[i]<<" ";
			}
			else
			{
				cout<<ans[i] * 2<<" ";
			}
			
		}
		cout<<endl;
	}
	else
	{
		long long u = 2;
		for(int i = 1;i<=n - 1;i++)
		{
			ans.push_back(temp);
			temp = u * (u + 1);
			u ++;
			if(temp > 1e9)
			{
				cout<<"No"<<endl;
				return;
			}
		}
		ans.push_back(u - 1);
		cout<<"Yes"<<endl;
		for(int i = 0;i<n;i++)
		{
			cout<<ans[i]<<" ";
		}
		cout<<endl;
		}
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
