#include <bits/stdc++.h>
using namespace std;
const int maxn = 2e5+5;
vector<long long>v(maxn);
vector<long long>p(maxn);
int n;
int main()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	long long sum = 0;
	for(int i = 2;i<=n;i++)
	{
		double r =1.0* v[i] / v[i-1];
		if(log2(r) >= p[i-1])
		{
			continue;
		}
		double g = p[i-1] - log2(r);
		int g2 = int(g);
		if(g - g2 ==0)
		{
			p[i] += g2;
		}
		else
		{
			p[i] += g2+1;
		}
		sum+=p[i];
		//cout<<p[i]<<endl;
	}
	cout<<sum<<endl;
	return 0;
 } 
