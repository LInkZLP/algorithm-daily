#include <bits/stdc++.h>
using namespace std;
int t;
int n;
int main()
{
	cin>>n;
	vector<long long>v(n+5);
	vector<long long>pre(n+5);
	vector<vector<long long>>dp(n+5,vector<long long>(n+5));
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		pre[i] = pre[i-1] + v[i];
	}
	//当一个选max,另外一个就有max 
	for(int len = 1;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <=n;i++)
		{
			int j = i + len - 1;
			dp[i][j] = max(v[i] + pre[j] - pre[i] - dp[i+1][j],v[j] + pre[j-1] - pre[i - 1] - dp[i][j-1]);
		}
	}
	cout<<dp[1][n]<<" "<<pre[n] - dp[1][n]<<endl;
	return 0;
}
