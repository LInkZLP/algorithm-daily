#include <bits/stdc++.h>
using namespace std;
int main()
{
	
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		vector<int>v(n+5);
		int sum = 0;
		int c1 = 0;
		int c2 = 0;
		for(int i = 1;i<=n;i++)
		{
			cin>>v[i];
			sum += v[i];
			if(v[i] >0 )
			{
				c1++;
			}
			else
			{
				c2++;
			}
		}
//最关键的是，我们总能通过若干种变化，让-1和1分开
		if(sum == 0)
		{
			cout<<"yes"<<endl;
		}
		else if(n & 1)
		{
			cout<<"No"<<endl;
		}
		else
		{
			if((abs(c1 - c2) / 2) %2== 0)
			{
				cout<<"yes"<<endl;
			}
			else
			{
				cout<<"no"<<endl;
			}
		}
	}
	
	return 0;
}
