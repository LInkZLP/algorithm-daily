#include <bits/stdc++.h>
using namespace std;
void solve()
{
	//dp[i] = max(dp[[i-1],dp[i-1] + (for s) * c)
	int n;
	cin>>n;
	vector<int>p(n+5);
	vector<int>c(n+5);
	for(int i = 1;i<=n;i++)
	{
		cin>>c[i]>>p[i];
		p[i] = 100- p[i];
	}
	//当前的，只会影响后面的，于是当前的就有选和不选两种选择
	double ans = 0.0;
	for(int i = n;i>=1;i--)
	{
		double g = ans * (p[i]) * 1.0 / 100 + c[i];
		if(g > ans)
		{
			ans = g;
		}
	}
	printf("%.10lf\n",ans);
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;	
}
