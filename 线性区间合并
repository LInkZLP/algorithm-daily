#include <bits/stdc++.h>
using namespace std;
struct st{
	int l;
	int r;
};
bool cmp(st a,st b)
{
	return a.l < b.l;
}
int main()
{
	int n;
	int m;
	cin>>n>>m;
	vector<vector<st>>p(2e5 + 5);
	vector<int>cnt(n + 5);
	for(int i = 1;i<=m;i++)
	{
		int l;
		int r;
		int c;
		cin>>l>>r>>c;
		p[c].push_back({l,r});
	}
	for(int i = 1;i<=m;i++)
	{
		sort(p[i].begin(),p[i].end(),cmp);
	}
	for(int i = 1;i<=m;i++)
	{
		if(p[i].size() == 0)
		{
			continue;
		}
		vector<st>nv;
		int ll = p[i][0].l;
		int lr = p[i][0].r;
		for(int j = 1;j<p[i].size();j++)
		{
			int nl = p[i][j].l;
			int nr = p[i][j].r;
			if(nl <= lr)
			{
				lr = max(lr,nr); 
			}
			else
			{
				nv.push_back({ll,lr});
				ll = nl;
				lr = nr;
			}
		}
		nv.push_back({ll,lr});
		for(int j = 0;j<nv.size();j++)
		{
			int nl = nv[j].l;
			int nr = nv[j].r;
			cnt[nl] ++;
			cnt[nr + 1]--;
		}
	}
	for(int i = 1;i<=n;i++)
	{
		cnt[i] += cnt[i - 1];
		cout<<cnt[i]<<" ";
	}
	cout<<endl;
	return 0;
}
