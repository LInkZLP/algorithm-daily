#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	long long h;
	long long k;
	cin>>n>>h>>k;
	vector<long long>v(n+5);
	vector<long long>pre(n+5);
	vector<long long>pmi(n+5,LLONG_MAX);
	vector<long long>smx(n+5,0);
	long long ss = 0;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		pre[i] = pre[i-1] + v[i];
		ss += v[i];
	}
	long long sum = ss;
	long long q = h / sum;
	long long r = h %sum;
	if(r == 0)
	{
		cout<<(q-1) *(n + k) + n<<endl;
		return;
	}
	for(int i = 1;i<=n;i++)
	{
		pmi[i] = min(pmi[i-1],v[i]);
	}
	for(int i = n;i>=1;i--)
	{
		smx[i] = max(smx[i+1],v[i]);
	}
	int need = n;
	for(int i = 1;i<=n;i++)
	{
		if(pre[i] >= r)
		{
			need = i;
			break;
		}
		if(pre[i] - pmi[i] + smx[i+1] >= r)
		{
			need = i;
			break;
		}
	}
	if(r == 0)
	{
		cout<<(q-1) * (n + k) + need<<endl;
	}
	else
	{
		cout<<(q) * (n + k) + need<<endl;
	}
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
