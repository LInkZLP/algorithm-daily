#include <bits/stdc++.h>

using namespace std;
//原数组为 a[1..n]，定义差分数组 d[i] = a[i] - a[i-1]（d[1]=a[1]）。
对区间 [l, r] 加上 val 等价于 d[l] += val，d[r+1] -= val。
最后通过求 d 的前缀和即可得到更新后的 a。
int main()
{
	int n;
	cin>>n;
	vector<long long>vec(n);
	vector<long long>d(n);
	for(int i = 0;i<n;i++)
	{
		cin>>vec[i];
		if(i == 0)
		{
			d[i] = vec[i];
		}
		else
		{
			d[i] = vec[i] - vec[i-1];
		}
	}
//p是记录差分正数和,q是记录有负数和,正数和和负数之间能抵消，剩下的正数or负数就要让他和差分数组首项配对（初始值为0，不是通过原数组想减得到的）
/*要使整个数组所有元素相等，等价于让差分数组从 i=1 到 n-1 全部变为 0（因为相邻元素差为 0 意味着所有元素相等），而 d[0] 可以自由变化（它决定了最终相等值的大小）。
区间加减操作在差分上的体现是：每次可以选择两个位置（可以是虚拟的 0 位置或 n 位置）分别加 1 和减 1。正差分需要被减少，负差分需要被增加，
因此正负可以配对抵消，剩下的只能与边界（d[0] 或 d[n]，这里 d[n] 不存在，但可以理解为边界外）配对。(假想开头有一个满足的数和结尾有一个满足数存在于数组边界)
*/
	long long p = 0;
	long long q = 0;
	for(int i = 1;i<n;i++)
	{
		if(d[i] > 0)
		{
			p+=d[i];
		}
		else {
			q -= d[i];
		}
		
	}
	//剩余未配对的差分（|p - q|）需要与 d[0] 互动，d[0] 可以取一系列连续的值，从而得到不同的最终相等值。具体地，最终值可能的取值范围有 |p - q| + 1 种。
  //比如说剩下abs(q- p),开头取值有0,1,2...abs(q-p),结尾和开头的和是abs(p-q)
	cout<<max(q,p)<<endl<<abs(p - q) + 1;
	
	
}
