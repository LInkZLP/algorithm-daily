#include <bits/stdc++.h>
using namespace std;
const int maxn = 3e5 + 5;
vector<long long>dv(maxn);
vector<int>dep(maxn);
int n;
vector<vector<int>>v(maxn);
vector<long long>ans(maxn);
struct st{
	int k;
	long long val;
};
vector<vector<st>>qv(maxn); 
void dfs0(int u,int p)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dep[ed] = dep[u] + 1;
		dfs0(ed,u);
		
	}
	return;
}
void dfs1(int u,int p)
{
	dv[dep[u]] += dv[dep[p]];
	for(int i = 0;i<qv[u].size();i++)
	{
		int k = qv[u][i].k;
		long long val = qv[u][i].val;
		dv[dep[u]] += val;
		if(k + dep[u] > n)
		{
			continue;
		}
		dv[dep[u] + k + 1] -= val;
	} 
	//cout<<"ppp"<<endl;
//	cout<<u<<" "<<dv[dep[u]]<<endl;
	ans[u] = dv[dep[u]];
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dfs1(ed,u);
	}
	dv[dep[u]] -= dv[dep[p]];//记得撤销当前积累上面的 
	for(int i = 0;i<qv[u].size();i++)//撤销对深度的贡献 
	{
		int k = qv[u][i].k;
		long long val = qv[u][i].val;
		dv[dep[u]] -= val;
		if(k + dep[u] > n)
		{
			continue;
		}
		dv[dep[u] + k + 1] += val;
	} 
	return;
}
void solve()
{
	cin>>n;
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	dep[1] = 1;
	int q;
	cin>>q;
	for(int i = 1;i<=q;i++)
	{
		int x;
		int k;
		long long val;
		cin>>x>>k>>val;
		qv[x].push_back({k,val});
	} 
	dfs0(1,0);
	dfs1(1,0);
	for(int i = 1;i<=n;i++)
	{
		cout<<ans[i]<<" ";
	}
	cout<<endl;
	return;
}
int main()
{
	ios::sync_with_stdio(false); cin.tie(nullptr);
	int t = 1;
	//cin>>t;
	while(t--)
	{
		solve();
	}
	
	return 0;
}
