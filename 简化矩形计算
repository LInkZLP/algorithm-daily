#include <bits/stdc++.h>

using namespace std;
//这里我们考虑上下边界，左右边界进行扫描，左右边界使用了双指针
int main()
{
	int n;
	int m;
	int p;
	cin>>n>>m>>p;
	vector<vector<int>>v(n+1,vector<int>(m+1,0));
	vector<vector<long long>>pre(n+1,vector<long long>(m+1,0));
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			cin>>v[i][j];
			pre[i][j] = pre[i-1][j] + pre[i][j-1] - pre[i-1][j-1] + v[i][j];
			// pre[i][j] = pre[i-1][j] + pre[i][j-1] - pre[i-1][j-1] + v[i][j];
			//long long s = pre[k][l] - pre[i-1][l] - pre[k][j-1] + pre[i-1][j-1];
		}
	}
	long long ans = 0;
	for(int i = 1;i<=n;i++)//上边界 
	{
		for(int k = i;k<=n;k++)//下边界 
		{
			int j = 1;//左边界 
			for(int l = 1;l<=m;l++)//右边界
			{
				long long s = pre[k][l] - pre[i-1][l] - pre[k][j-1] + pre[i-1][j-1];
				while(s > p && j<=l)
				{
					j++;
					s = pre[k][l] - pre[i-1][l] - pre[k][j-1] + pre[i-1][j-1];
				}
				if(j <=l)
				{
					ans+=(l - j + 1);
				}
			}
			
		}
	}
	cout<<ans<<endl;
	
	return 0;
}
