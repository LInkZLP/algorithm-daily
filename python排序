Python排序大全
一、基础排序
1. sort() - 原地排序（修改原列表）
python
arr = [3, 1, 4, 1, 5]
arr.sort()
print(arr)  # [1, 1, 3, 4, 5]

# 降序
arr.sort(reverse=True)
print(arr)  # [5, 4, 3, 1, 1]
2. sorted() - 返回新列表（原列表不变）
python
arr = [3, 1, 4, 1, 5]
new_arr = sorted(arr)
print(new_arr)  # [1, 1, 3, 4, 5]
print(arr)      # [3, 1, 4, 1, 5] 原列表没变

# 降序
new_arr = sorted(arr, reverse=True)
二、字符串排序
python
# 字符串列表
words = ["banana", "apple", "cherry"]
words.sort()
print(words)  # ['apple', 'banana', 'cherry']

# 按长度排序
words.sort(key=len)
print(words)  # ['apple', 'banana', 'cherry'] 按字母长度

# 字符串排序（区分大小写）
words = ["Banana", "apple", "Cherry"]
words.sort()
print(words)  # ['Banana', 'Cherry', 'apple'] 大写排前面

# 忽略大小写排序
words.sort(key=str.lower)
print(words)  # ['apple', 'Banana', 'Cherry']
三、复杂排序（key参数）
1. 按元组/列表的某个元素排序
python
# 学生信息 [(名字, 年龄, 分数)]
students = [
    ("Alice", 20, 85),
    ("Bob", 19, 92),
    ("Charlie", 20, 78),
    ("David", 19, 85)
]

# 按年龄排序
students.sort(key=lambda x: x[1])
print(students)
# [('Bob', 19, 92), ('David', 19, 85), ('Alice', 20, 85), ('Charlie', 20, 78)]

# 按分数降序
students.sort(key=lambda x: x[2], reverse=True)
# [('Bob', 19, 92), ('Alice', 20, 85), ('David', 19, 85), ('Charlie', 20, 78)]
2. 多级排序
python
# 先按年龄，再按分数
students.sort(key=lambda x: (x[1], -x[2]))  # 年龄升序，分数降序
print(students)
# [('Bob', 19, 92), ('David', 19, 85), ('Alice', 20, 85), ('Charlie', 20, 78)]

# 或者用多个key（Python 3.11+）
from functools import cmp_to_key
3. 按字典的值排序
python
scores = {"Alice": 85, "Bob": 92, "Charlie": 78}

# 按键排序
sorted_names = sorted(scores.keys())
print(sorted_names)  # ['Alice', 'Bob', 'Charlie']

# 按值排序（升序）
sorted_by_score = sorted(scores.items(), key=lambda x: x[1])
print(sorted_by_score)  # [('Charlie', 78), ('Alice', 85), ('Bob', 92)]

# 按值排序（降序）
sorted_by_score_desc = sorted(scores.items(), key=lambda x: x[1], reverse=True)
print(sorted_by_score_desc)  # [('Bob', 92), ('Alice', 85), ('Charlie', 78)]
四、自定义排序规则
1. 使用 key 函数
python
# 按绝对值排序
arr = [-5, 3, -2, 1, -4]
arr.sort(key=abs)
print(arr)  # [1, -2, 3, -4, -5]

# 按数字的个位排序
arr = [15, 23, 41, 32, 54]
arr.sort(key=lambda x: x % 10)
print(arr)  # [41, 32, 23, 54, 15]

# 按字符串中数字排序
files = ["file10.txt", "file2.txt", "file1.txt"]
files.sort(key=lambda x: int(''.join(filter(str.isdigit, x))))
print(files)  # ['file1.txt', 'file2.txt', 'file10.txt']
2. 使用 cmp_to_key（复杂比较）
python
from functools import cmp_to_key

# 自定义比较函数
def compare(a, b):
    if a % 10 < b % 10:  # 先按个位
        return -1
    elif a % 10 > b % 10:
        return 1
    else:  # 个位相同，按本身大小
        return a - b

arr = [15, 23, 41, 32, 54]
arr.sort(key=cmp_to_key(compare))
print(arr)  # [41, 32, 23, 54, 15]
五、排序稳定性
python
# Python排序是稳定的（相同值的元素保持原顺序）
pairs = [(1, 'a'), (2, 'b'), (1, 'c'), (2, 'd')]

# 先按第二个元素排序
pairs.sort(key=lambda x: x[1])
print(pairs)  # [(1, 'a'), (2, 'b'), (1, 'c'), (2, 'd')]

# 再按第一个元素排序（稳定排序保持第二个元素的顺序）
pairs.sort(key=lambda x: x[0])
print(pairs)  # [(1, 'a'), (1, 'c'), (2, 'b'), (2, 'd')]
六、实际算法题常用
1. 排序后去重
python
arr = [3, 1, 4, 1, 5, 9, 2, 6, 5]
arr.sort()
unique = []
for i in range(len(arr)):
    if i == 0 or arr[i] != arr[i-1]:
        unique.append(arr[i])
print(unique)  # [1, 2, 3, 4, 5, 6, 9]
2. 找最大/最小的k个数
python
arr = [3, 1, 4, 1, 5, 9, 2, 6]

# 方法1：排序后取前k个
k = 3
smallest_k = sorted(arr)[:k]      # [1, 1, 2]
largest_k = sorted(arr, reverse=True)[:k]  # [9, 6, 5]

# 方法2：使用heapq（大数据时更快）
import heapq
smallest_k = heapq.nsmallest(k, arr)  # [1, 1, 2]
largest_k = heapq.nlargest(k, arr)    # [9, 6, 5]
3. 自定义对象排序
python
class Student:
    def __init__(self, name, age, score):
        self.name = name
        self.age = age
        self.score = score
    
    def __repr__(self):
        return f"{self.name}({self.age},{self.score})"

students = [
    Student("Alice", 20, 85),
    Student("Bob", 19, 92),
    Student("Charlie", 20, 78)
]

# 按分数排序
students.sort(key=lambda s: s.score)
print(students)  # [Charlie(20,78), Alice(20,85), Bob(19,92)]

# 或者定义 __lt__ 方法
class Student:
    def __init__(self, name, age, score):
        self.name = name
        self.age = age
        self.score = score
    
    def __lt__(self, other):
        return self.score < other.score  # 定义小于的比较规则
