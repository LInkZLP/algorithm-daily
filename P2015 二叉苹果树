#include <bits/stdc++.h>
using namespace std;
int n;
int m;
struct st{
	int nxt;
	int w;
};

vector<vector<st>>v(105);
vector<vector<int>>dp(105,vector<int>(105,0));
//dp[now][x] = max(dp[nxt][x-1] + w,dp[now][x])
void dfs(int u,int fa)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i].nxt;
		if(nxt == fa)
		{
			continue;
		}
		dfs(nxt,u);
		for(int j = m;j>=1;j--)
		{
			for(int k = 0;k<=j-1;k++)
			{
				dp[u][j] = max(dp[u][j],dp[u][j-k-1] + dp[nxt][k]  +v[u][i].w);
			}
		}
	}
	return;
}
int main()
{
	cin>>n>>m;
	for(int i = 1;i<=n-1;i++)
	{
		int x;
		int y;
		int w;
		cin>>x>>y>>w;
		v[x].push_back({y,w});
		v[y].push_back({x,w});
	}
	dfs(1,1);
	cout<<dp[1][m]<<endl;
	return 0;
 } 
