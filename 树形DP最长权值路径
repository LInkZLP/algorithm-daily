#include <bits/stdc++.h>
using namespace std;
long long ans = 0;
const int maxn = 3e5 + 5;
struct st{
	int ed;
	long long va;
};
int n;
vector<long long>w(maxn);
vector<vector<st>>v(maxn);
vector<long long>dp(maxn);
void dfs(int u,int p)
{
	dp[u] = w[u];
	long long d1 = LLONG_MIN;
	long long d2 = LLONG_MIN;
	if(v[u].size() == 1 && u != 1)
	{
		return;
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		if(ed == p)
		{
			continue;
		}
		dfs(ed,u);
		if(d1 < dp[ed] - v[u][i].va)
		{
			d2 = d1;
			d1 = dp[ed] - v[u][i].va;
		}
		else if(d2 < dp[ed] - v[u][i].va)
		{
			d2 = dp[ed] - v[u][i].va;
		}
	}
	if(d2 == LLONG_MIN)
	{
		ans = max(d1 + w[u],ans);
	}
	else
	{
		ans = max(d1 + d2 + w[u],ans);
		ans = max(d1 + w[u],ans);//最长值的路径可能只需要最长链 
	}
	dp[u] = max(d1 + w[u],w[u]);//最长值的路径可能只包含自己 
	return;
}
int main()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>w[i];
		ans = max(ans,w[i]);
	}
	for(int i = 1;i<=n-1;i++)
	{
		int x;
		int y;
		long long d;
		cin>>x>>y>>d;
		v[x].push_back({y,d});
		v[y].push_back({x,d});
	}
	dfs(1,0);
	cout<<ans<<endl;
	return 0;
}
