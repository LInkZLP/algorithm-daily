#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 1e5+5;
vector<vector<int>>sum(maxn<<2,vector<int>(30,-1));
vector<vector<int>>add(maxn<<2,vector<int>(30,-1));
vector<vector<int>>v(maxn,vector<int>(30,0));
void up(int i,int idx)
{
	sum[i][idx] = sum[i<<1][idx] + sum[i<<1|1][idx];
	return;
}
void build(int l,int r,int i,int idx)
{
	if(l == r)
	{
		sum[i][idx] = v[l][idx];
		return;
	}
	int mid = (l + r)>>1;
	build(l,mid,i<<1,idx);
	build(mid+1,r,i<<1|1,idx);
	up(i,idx);
	return;
}
void down(int i,int idx,int ln,int rn)
{
	if(add[i][idx] != -1)
	{
		int t = add[i][idx];
		add[i][idx] = -1;
		add[i<<1|1][idx] = t;
		add[i<<1][idx] = t;
		sum[i<<1][idx] = ln*t;
		sum[i<<1|1][idx] = rn*t;
	}
	return;
}
void update(int l,int r,int i,int idx,int jobl,int jobr,int jobv)
{
	if(l >= jobl && r <=jobr)
	{
		sum[i][idx] = (r-  l + 1) * jobv;
		add[i][idx] = jobv;
		return;
	}
	int mid = (l + r)>>1;
	down(i,idx,mid - l + 1,r - mid);
	if(mid >=jobl)
	{
		update(l,mid,i<<1,idx,jobl,jobr,jobv);
	}
	if(mid+1<=jobr)
	{
		update(mid+1,r,i<<1|1,idx,jobl,jobr,jobv);
	}
	up(i,idx);
	return;
}
int query(int l,int r,int i,int idx,int jobl,int jobr)
{
	if(l >= jobl && r <=jobr)
	{
		return sum[i][idx];
	}
	int mid = (l + r)>>1;
	down(i,idx,mid - l + 1,r - mid);
	int ans = 0;
	if(mid >=jobl)
	{
		ans += query(l,mid,i<<1,idx,jobl,jobr);
	}
	if(mid+1<=jobr)
	{
		ans += query(mid+1,r,i<<1|1,idx,jobl,jobr);
	}
	return ans;
}
int main()
{
	cin>>n>>m;
	string s;
	cin>>s;
	for(int i = 0;i<s.size();i++)
	{
		v[i+1][s[i] - 'a'] = 1;
	}
	for(int i = 0;i<26;i++)
	{
		build(1,n,1,i);
	}
	while(m--)
	{
		int x;
		int y;
		int op;
		cin>>x>>y>>op;
		vector<int>cnt(30);
		if(op == 1)
		{
			for(int i = 0;i<26;i++)
			{
				cnt[i] = query(1,n,1,i,x,y);
				update(1,n,1,i,x,y,0);
			}
			int sta = x;
			for(int i = 0;i<26;i++)
			{
				int tar = cnt[i];
				if(tar != 0)
				{
					update(1,n,1,i,sta,sta+tar-1,1);
					sta = sta + tar;
				}
			}
		}
		else
		{
			for(int i = 0;i<26;i++)
			{
				cnt[i] = query(1,n,1,i,x,y);
				update(1,n,1,i,x,y,0);
			}
			int sta = x;
			for(int i = 25;i>=0;i--)
			{
				int tar = cnt[i];
				if(tar != 0)
				{
					update(1,n,1,i,sta,sta+tar-1,1);
					sta = sta + tar;
				}
			}
		}
	}
	string res ="";
	for(int i = 1;i<=n;i++)
	{
		for(int j = 0;j<26;j++)
		{
			int tar = query(1,n,1,j,i,i);
			if(tar != 0)
			{
				res += ('a' + j);
				break;
			}
		}
	}
	cout<<res<<endl;
	return 0;
 } 
