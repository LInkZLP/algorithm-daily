#include <bits/stdc++.h>
using namespace std;
int n;
int k;
int main()
{
	cin>>n>>k;
	vector<int>v(n+5);
	long long dp[n+5][n+5][k+4];
	memset(dp,0,sizeof(dp));
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		dp[i][i][0] = v[i];
	}
	for(int len = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <=n;i++)
		{
			int j = len + i - 1;
			for(int l = i ;l < j;l++)
			{
				for(int cl = 0;cl <= k;cl++)
				{
					if(cl > l - i)
					{
						continue;
					}
					for(int cr = 0;cr <= k;cr ++)
					{
						if(cr > j - (l + 1))//注意一定要加上这个，一个区间使用加法乘法的次数是有限的！！！！！！
						{
							continue;
						}
						if(cr + cl <= k-1)
						{
							dp[i][j][cr + cl + 1] = max(dp[i][j][cr + cl + 1],dp[i][l][cl]  * dp[l+1][j][cr]);
							//dp[i][j][cr + cl] = max(dp[i][j][cr + cl],dp[i][l][cl]  + dp[l+1][j][cr]);
						}
						if(cr + cl <= k)
						{
							dp[i][j][cr + cl] = max(dp[i][j][cr + cl],dp[i][l][cl]  + dp[l+1][j][cr]);
						}
					}
				}
			}
		}
	}
	long long ans =dp[1][n][k];
	cout<<ans<<endl;
	return 0;
}
