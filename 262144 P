#include <bits/stdc++.h>
using namespace std;
vector<vector<int>>f(60,vector<int>(262149,0));//从位置 i 开始（包含 i），
//能否通过若干次合并得到一个数值为 val 的连续区间。
int n;
//我们的目标是合并区间，第一个是表示能合并的值，第二个数表示从j开始到结束的下一个； 
int main()
{
	cin>>n;
	int ans = 0;
	for(int i = 1;i<=n;i++)
	{
		int x;
		cin>>x;
		f[x][i] = i+1;
	}
	for(int i = 2;i<=58;i++)
	{
		for(int j = 1;j<=n;j++)
		{
			if(!f[i][j])
			{
				f[i][j] = f[i-1][f[i-1][j]];
			}
			if(f[i][j])
			{
				ans = i;
			}
		}
	}
	cout<<ans<<endl;
	return 0;
}
