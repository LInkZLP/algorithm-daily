#include <bits/stdc++.h>
using namespace std;
struct st{
	int id;
	int sum;
};
void solve()
{
	int n;
	int m;
	cin>>n>>m;
	vector<int>val(n + 5);
	vector<vector<vector<int>>>dp(n + 5,vector<vector<int>>(m + 5,vector<int>(2,n + 5))); 
	for(int i = 1;i<=n;i++)
	{
		cin>>val[i];		
	}	
	dp[1][0][1] = 1;
	if (val[1] <= m)
	{
		dp[1][val[1]][0] = 0;
	}
	for(int i = 2;i<=n;i++)
	{
		for(int j = 0;j + val[i] <=m;j++)
		{
			dp[i][j + val[i]][0] = min(dp[i - 1][j][0] ,dp[i - 1][j][1]);
		}
		for(int j = 0; j<= m;j++)
		{
			dp[i][j][1] = min(dp[i - 1][j][1],dp[i - 1][j][0] + 1);
		}
	}
	vector<int>ans(m + 5,INT_MAX);
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			ans[j] = min(ans[j],dp[i][j][1]);
			ans[j] = min(ans[j],dp[i][j][0] + (i != n));
		}
	}
	for(int i = 1;i<=m;i++)
	{
		if(ans[i] >= n)
		{
			cout<<-1<<endl;
			continue;
		}
		cout<<ans[i]<<endl;
	}
	return ;
}
int main()
{
	int t;
	//cin>>t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
}
