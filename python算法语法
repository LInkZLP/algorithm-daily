三、字符串操作
python
s = "hello world"

# 分割
words = s.split()        # ['hello', 'world']
parts = s.split('o')     # ['hell', ' w', 'rld']

# 连接
s2 = '-'.join(['a','b','c'])  # 'a-b-c'

# 查找
s.find('o')        # 4 返回位置
s.count('l')       # 3 出现次数
'hello' in s       # True

# 修改
s.upper()          # 'HELLO WORLD'
s.lower()          # 'hello world'
s.replace('o', '0')  # 'hell0 w0rld'

# 判断
s.isdigit()        # 是否全是数字
s.isalpha()        # 是否全是字母
s.startswith('he') # True
四、字典（最重要！）
python
# 创建
d = {}
d = {'a':1, 'b':2}
d = dict(a=1, b=2)

# 增删改查
d['c'] = 3          # 添加/修改
d.get('a', 0)       # 取'a'的值，没有返回0
d.pop('a')          # 删除并返回值
d.keys()            # 所有键
d.values()          # 所有值
d.items()           # 所有(键,值)对

# 遍历
for k in d:
    print(k, d[k])

for k, v in d.items():
    print(k, v)

# 默认字典（超好用）
from collections import defaultdict
d = defaultdict(int)    # 默认值是0
d = defaultdict(list)   # 默认值是[]
五、集合
python
# 创建
s = set()
s = {1,2,3}
s = set([1,2,2,3])  # {1,2,3} 自动去重

# 操作
s.add(4)            # 添加
s.remove(2)         # 删除（没有会报错）
s.discard(2)        # 删除（没有也不报错）
1 in s              # True/False

# 集合运算
a = {1,2,3}
b = {2,3,4}
a & b  # {2,3} 交集
a | b  # {1,2,3,4} 并集
a - b  # {1} 差集
六、常用库函数
python
# 数学
max(arr)            # 最大值
min(arr)            # 最小值
sum(arr)            # 求和
abs(x)              # 绝对值
pow(x, y)           # x的y次方

# 枚举（带索引）
for i, v in enumerate(arr):
    print(i, v)

# 压缩（同时遍历多个列表）
for a, b in zip(list1, list2):
    print(a, b)

# 排序（复杂情况）
arr.sort(key=lambda x: x[1])  # 按第二个元素排序
sorted(arr, key=lambda x: -x) # 降序
七、队列和栈
python
# 栈（用列表）
stack = []
stack.append(1)     # 入栈
stack.append(2)
top = stack[-1]     # 看栈顶
stack.pop()         # 出栈

# 队列（用deque）
from collections import deque
q = deque()
q.append(1)         # 入队
q.append(2)
front = q[0]        # 看队首
q.popleft()         # 出队
八、常用技巧
python
# 交换变量
a, b = b, a

# 条件表达式
x = a if condition else b

# 列表推导式
squares = [x*x for x in range(10)]
even = [x for x in arr if x % 2 == 0]

# 三目运算
max_val = a if a > b else b

# 多重赋值
a, b, *rest = [1,2,3,4,5]  # a=1, b=2, rest=[3,4,5]
九、算法常用模板
python
# 前缀和
pre = [0] * (n + 1)
for i in range(n):
    pre[i+1] = pre[i] + arr[i]
# 区间[l,r]和 = pre[r+1] - pre[l]

# 计数
from collections import Counter
cnt = Counter(arr)
most_common = cnt.most_common(1)[0]

# 排序加索引
arr = [(val, idx) for idx, val in enumerate(arr)]
arr.sort()
