2. 多行输入
python
# 读取n行
n = int(input())
grid = []
for _ in range(n):
    row = list(map(int, input().split()))
    grid.append(row)

# 或者一行搞定
grid = [list(map(int, input().split())) for _ in range(n)]

# 读取直到文件结尾
import sys
data = sys.stdin.read().split()
# 或者
for line in sys.stdin:
    arr = list(map(int, line.split()))
