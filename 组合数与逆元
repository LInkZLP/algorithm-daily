#include <bits/stdc++.h>
using namespace std;
vector<long long>inv(1e6 + 5);
long long mod = 1e9 + 7;
vector<long long>f(1e6);
vector<long long>fi(1e6);
int n;
int k;
int m;	
long long qpow(long long a,long long b)
{
	long long res = 1;
	while(b)
	{
		if(b & 1)
		{
			res = res * a % mod;
		}
		a = a *a % mod;
		b >>=1;
	}
	return res;
}
void ic()
{
	f[0] = 1;
	for(int i = 1;i<=m;i++)
	{
		f[i] = f[i - 1] * i % mod;
	}
	fi[m] = qpow(f[m],mod - 2);
	for(int i = m;i>=1;i--)
	{
		fi[i - 1] = fi[i] * i % mod;
	}
}
long long C(long long n,long long a)
{
	if(a < 0 || a > n)
	{
		return 0;
	}
	return f[n] * fi[a] % mod * fi[n - a] % mod;
}
int main()
{
	cin>>n>>k;
	m = n + k;
	inv[1] = 1;
	ic();
	for(int i = 2;i<=1e6;i++)
	{
		inv[i] = (mod - mod / i) * inv[mod % i] % mod;
	}
	cout<<C(n + k,k)<<endl;
	return 0;
} 
