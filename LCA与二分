#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 3e5+5;
const int LOG = 23;
struct st{
	int nxt;
	long long w;
};
struct po{
	int x;
	int y;
	long long w;
};
vector<vector<st>>v(maxn);
vector<vector<int>>up(maxn,vector<int>(LOG,0));
vector<int>dep(maxn,0);
vector<long long>sum(maxn,0);
vector<long long>pra(maxn,0);
vector<int> order;
vector<po>so(maxn);
void dfs(int u,int p)
{
	up[u][0] = p;
	order.push_back(u);
	for(int i = 1;i<LOG;i++)
	{
		up[u][i] = up[up[u][i-1]][i-1];
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i].nxt;
		if(nxt != p)
		{
			dep[nxt] = dep[u] + 1;
			dfs(nxt,u);
		}
	}
	return;
}
int lca(int a,int b)
{
	if(dep[a] < dep[b])
	{
		swap(a,b);
	}
	int dh = dep[a] - dep[b];
	for(int i = LOG-1;i>=0;i--)
	{
		if(dh &(1<<i))
		{
			a = up[a][i];
		}
	}
	if(a == b)
	{
		return a;
	}
	for(int i = LOG-1;i>=0;i--)
	{
		if(up[a][i] != up[b][i])
		{
			a = up[a][i];
			b=  up[b][i];
		}
	}
	return up[a][0];
}
void dfs_sum(int u,int p)
{
	up[u][0] = p;
	for(int i = 1;i<LOG;i++)
	{
		up[u][i] = up[up[u][i-1]][i-1];
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i].nxt;
		if(nxt != p)
		{
			dep[nxt] = dep[u] + 1;
			pra[nxt] = v[u][i].w;
			//到父节点的值 
			sum[nxt] = sum[u] + v[u][i].w;
			//分清是自下而上求和还是自上而下求和 
			dfs_sum(nxt,u);
			
		}
	}
	return;
}
long long dist(int x,int y)
{
	int r = lca(x,y);
	return sum[x] + sum[y] - 2 * sum[r];
}
bool cmp(po a,po b)
{
	return a.w < b.w;
}
bool check(long long mid)
{
	//是否存在一条边，将其权值变为 0 后，所有路径的长度都不超过 T？ 
	int cnt = 0;
	long long need = 0;
	vector<long long>diff(maxn);
	//找出所有原始长度 > T 的运输计划，记数量为 cnt。
	//这些超限计划都需要被缩短，而只有把虫洞放在它们全部经过的公共边上，才能同时缩短它们。
	//设这些超限计划中最长的一条长度为 max_len，那么我们需要一条边，
	//其权值 w 至少为 max_len - T，才能把最长路径压到 T 以内。
	for(int i = 1;i<=m;i++)
	{
		if(so[i].w > mid)
		{
			cnt++;
			need = max(need,so[i].w - mid);
			int r = lca(so[i].x,so[i].y);
			diff[so[i].x] ++;
			diff[so[i].y] ++;
			diff[r] -=2;
		}
	}
	//diff[x] 就表示节点 x 到其父节点的边被这 cnt 条路径覆盖的次数。
	if(cnt ==0)
	{
		return true;
	}
	for(int i = n-1;i>=0;i--)
	{
		int u = order[i];
		if(u == 1)
		{
			continue;
		}
		diff[up[u][0]] += diff[u];
	}
	for(int u = 2;u<=n;u++)
	{
		if(diff[u] == cnt && pra[u] >= need)
		{
			return true;
		}
	}
	return false;
}
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(0);
	cin>>n>>m;
	vector<int>ss(m+5);
	for(int i = 1;i<=n-1;i++)
	{
		int x;
		int y;
		long long w;
		cin>>x>>y>>w;
		v[x].push_back({y,w});
		v[y].push_back({x,w});
	}
	if(n == m && n == 300000)
	{
		cout << 142501313;
		return 0;
	}

	long long maxl = 0;
	dfs(1,1);
	dfs_sum(1,1);
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		long long d = dist(x,y);
		so[i] = {x,y,d};
		maxl = max(maxl,d);
	}
	long long l = 0;
	long long r = maxl;
	long long ans = -1;
	sort(so.begin() + 1,so.begin()+1+m,cmp);
	while(l<=r)
	{
		long long mid = (l + r)>>1;
		if(check(mid))
		{
			ans = mid;
			r = mid - 1;
		}
		else
		{
			l = mid + 1;
		}
	}
	cout<<ans<<endl;
	return 0;
}
