#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		vector<int>a(n+5);
		vector<int>b(n+5);
		int s1 = 0;
		int s2 = 0;
		bool p = false;
		for(int i = 1;i<=n;i++)
		{
			cin>>a[i];
			s1+=a[i];
		}
		for(int i = 1;i<=n;i++)
		{
			cin>>b[i];
			s2+=b[i];
			if(b[i] != a[i])
			{
				p = true;
			}
		}
		if(!p)
		{
			cout<<0<<endl;
			continue;
		}
		if(s2==n || s1 == 0)
		{
			cout<<-1<<endl;
			continue;
		}
		int cnt = 0;
		for(int i = 1;i<=n;i++)
		{
			if(a[i] != b[i])
			{
				cnt+=a[i];
			}
		}
		cout<< ((cnt % 2 ==1)? 1 : 2)<<endl;
	}
	
	return 0;
}
