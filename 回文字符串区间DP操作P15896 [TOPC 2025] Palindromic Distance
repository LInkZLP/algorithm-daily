#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 3e3+5;
void solve()
{
	string s;
	cin>>s;
	n = s.size();
	vector<char>v(n+5);
	vector<vector<int>>dp(n+5,vector<int>(n+5,INT_MAX));
	for(int i = 1;i<=n;i++)
	{
		v[i] = s[i-1];
		dp[i][i] = 0;
		dp[i][i-1] = 0;
	}
	for(int len = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <= n;i++)
		{
			int j = i + len - 1;
			if(v[i] == v[j])
			{
				dp[i][j] = dp[i+1][j-1];
			}
			else
			{
				dp[i][j] = min(dp[i+1][j] + 1,min(dp[i][j-1] + 1 ,dp[i+1][j-1] + 1));
			}
		}
	}
	cout<<dp[1][n]<<endl;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
} 
