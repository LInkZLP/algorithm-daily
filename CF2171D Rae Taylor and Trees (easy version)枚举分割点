#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<int>v(n + 5);
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	vector<int>mi(n + 5);
	vector<int>mx(n + 5);
	mx[n] = v[n];
	mi[1] = v[1];
	for(int i = 2;i<=n;i++)
	{
		mi[i] = min(v[i],mi[i-1]);
	}
	for(int i = n - 1;i>=1;i--)
	{
		mx[i] = max(mx[i + 1],v[i]);
	}
	for(int i = 1;i<=n-1;i++)
	{
		if(mi[i] > mx[i + 1])
		{
			cout<<"No"<<endl;
			return;			
		}
	}
	cout<<"Yes"<<endl;
	return ;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	
	return 0;
}
