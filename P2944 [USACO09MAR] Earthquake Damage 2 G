#include <bits/stdc++.h>
using namespace std;
struct st{
	int ed;
	int id;
	int w;
};
int n;
int m;
const int maxn =  7001;
int S;
int T;
int c;
vector<int>dep;
vector<vector<st>>v(maxn);
vector<int>jd(maxn);
vector<int>od(maxn);
vector<int>cur;
const int INF = 1e5;
bool bfs()
{
	queue<int>q;
	q.push(S);
	dep.assign(maxn,-1);
	dep[S] = 0;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].ed;
			if(dep[ed] == - 1 && v[u][i].w)
			{
				dep[ed] = dep[u] + 1;
				q.push(ed);
			}
		}
	}
	cur.assign(maxn,0);
	return dep[T] != -1;
}
int dfs(int u,int lim)
{
	if(u == T)
	{
		return lim;
	}
	for(int i = cur[u];i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		cur[u] = i;
		if(dep[ed] == dep[u] + 1 && v[u][i].w)
		{
			int res = dfs(ed,min(lim,v[u][i].w));
			if(res)
			{
				v[u][i].w -= res;
				v[ed][v[u][i].id].w += res;
				return res;
			}
			else
			{
				dep[ed] = -1;
			}
		}
	}
	return 0;
}
int dinic()
{
	int r = 0;
	int f = 0;
	while(bfs())
	{
		while(f = dfs(S,INF))
		{
			r += f;
		}
	}
	return r;
}
void add(int u,int x,int w)
{
	int sti = v[u].size();
	int edi = v[x].size();
	v[u].push_back({x,edi,w});
	v[x].push_back({u,sti,0});
	return;
}
int main()
{
	cin>>n>>c>>m;
	S = 1;
	T = n * 2 + 1;
	int ptr = 0;
	jd[1] = 1;
	od[1] = 2;
	add(jd[1],od[1],INF);
	ptr +=2;
	vector<int>xi(maxn);
	for(int i = 2;i<=n;i++)
	{
		ptr ++;
		jd[i] = ptr;
	//	add(S,jd[i],INF);
		ptr ++;
		od[i] = ptr;	
	}
	for(int i = 1;i<=c;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		add(od[x],jd[y],INF);
		add(od[y],jd[x],INF);
	}
	for(int i = 1;i<=m;i++)
	{
		int x;
		cin>>x;
		xi[x] = 1;
		add(od[x],T,INF);
	}
	for(int i = 2;i<=n;i++)
	{
		if(xi[i])
		{
			add(jd[i],od[i],INF);
		}
		else
		{
			add(jd[i],od[i],1);
		}
	}
	cout<<dinic()<<endl;
	return 0;
}
