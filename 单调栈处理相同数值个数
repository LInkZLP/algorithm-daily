#include <bits/stdc++.h>
using namespace std;
struct st{
	long long h1;
	int c;
};

int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
	int n;;
	cin>>n;
	vector<long long>v(n+5);
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	stack<st>s;
	s.push({v[1],1});
	long long ans = 0;
	for(int i = 2;i<=n;i++)
	{
		int cnt = 1;
		while(!s.empty() && v[i] > s.top().h1)
		{
			ans+= s.top().c;
			s.pop();
		}
		if(!s.empty() && s.top().h1 == v[i])
		{
			ans+=s.top().c;
			cnt += s.top().c;
			s.pop();
		}
		if(!s.empty())
		{
			ans++;
		}
		s.push({v[i],cnt});
	}
	cout<<ans<<endl;
	return 0;
}
