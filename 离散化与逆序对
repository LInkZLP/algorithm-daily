	}
	for(int i = 1;i<=n;i++)
	{
		int a = id[v1[i]];
		int b = id[v2[i]];
		swap(val[a],val[b]);
	}
	vector<long long>temp(v.size());
	vector<long long>tmp = val;
	mergesort(0,val.size()-1,tmp,temp);
	long long ans = cnt;
	for(int i = 0;i<v.size();i++)
	{
		long long p = v[i];
		long long cur = val[i];
		if(cur + 1 <= p-1)
