			long long r = cur- 1;
			int cnt1 = upper_bound(v.begin(),v.end(),r) - lower_bound(v.begin(),v.end(),l);
			ans+=(r - l+ 1) - cnt1;
		}
	}
	cout<<ans<<endl;
