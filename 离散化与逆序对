const int maxn = 1e5+5;
int n;
long long cnt = 0;
void merge(int l,int r,int mid,vector<long long>&v,vector<long long>&temp)
{
	if(l >= r)
	{
		return;
	}
	int i = l;
	int j = mid + 1;
	int k = l;
	while(i <= mid && j <= r)
	{
		if(v[i] > v[j])
		{
			cnt += mid - i + 1;
			temp[k++] = v[j++];
		}
		else
		{
			temp[k++] = v[i++];
		}
	}
	while(i <= mid)
	{
		temp[k++] = v[i++];
	}
	while(j <=r )
	{
		temp[k++] = v[j++];
	}
	for(int i = l;i<=r;i++)
	{
		v[i] = temp[i];
	}
	return;
}
void mergesort(int l,int r,vector<long long>&v,vector<long long>&temp)
{
	int mid = (l + r)>>1;
	if(l >= r)
	{
		return;
	}
	mergesort(l,mid,v,temp);
	mergesort(mid+1,r,v,temp);
	merge(l,r,mid,v,temp);
	return;
}
