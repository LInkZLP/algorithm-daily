#include <bits/stdc++.h>
using namespace std;
vector<vector<long long>>dp(1<<13,vector<long long>(13,0));
int n;
int m;
int g[13][1<<13];
long long ans = 0;
vector<bool>c(1<<13);
vector<long long>sp(13);
vector<long long>v(14);
const long long mod = 1e8;
int main()
{
	cin>>n>>m;
	sp[0] = (1<<m)-1;
	long long f = (1<<m) - 1;//最终状态 
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			int x;
			cin>>x;
			if(x)
			{
				sp[i] |= (1<<(j-1));
			}
		}
	}
	for(int i = 0;i<=f;i++)
	{
		c[i] = (((i<<1) & i) == 0);//有相邻项 ，这样可以遍历每一行可能出现的所有情况。 
	}
	dp[0][0] = 1;
	for(int i = 1;i<=n;i++)
	{
		for(int j = 0;j<=f;j++)//第i行状态 
		{
			if((sp[i] & j) == j &&c[j]) // j包含i的情况 
			{
				for(int k = 0;k<=f;k++)//上一行状态 
				{
					if((k & j) == 0) // 上下没有相邻 
					{
						dp[j][i] = (dp[j][i] + dp[k][i-1]) % mod;
					}
				}
			}
		}
	}//每行的状态只与它直接相邻的上一行有关。只需要枚举上下两行就可以不重不漏 
	for(int i = 0;i<=f;i++)
	{
		ans = (ans + dp[i][n]) % mod;
	}
	cout<<ans<<endl;	
	return 0;
}
