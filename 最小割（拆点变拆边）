#include <bits/stdc++.h>
using namespace std;
int n;
int m;
struct st{
	int ed;
	int id;
	int w;
};
vector<int>dep;
vector<int>cur;
const int maxn = 2e2+5;
vector<vector<st>>v(maxn<<2);
int S;
int T;
int INF = 100;
bool bfs()
{
	dep.assign(maxn,-1);
	queue<int>q;
	dep[S] = 0;
	q.push(S);
	while(!q.empty()) 
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int nxt = v[u][i].ed;
			if(dep[nxt] == -1 && v[u][i].w)
			{
				dep[nxt] = dep[u] + 1;
				q.push(nxt);
			}
		}
	}
	cur.assign(maxn,0);
	return dep[T] != -1;
}
int dfs(int st,int lim)
{
	if(st == T)
	{
		return lim;
	}
	int u = st;
	for(int i = cur[u];i<v[u].size();i++)
	{
		cur[u] = i;
		int nxt = v[u][i].ed;
		if(dep[nxt] == dep[u] + 1 && v[u][i].w)
		{
			int res = dfs(nxt,min(lim,v[u][i].w));
			if(res)
			{
				v[u][i].w -= res;
				v[nxt][v[u][i].id].w += res;
				return res;
			}
			else
			{
				dep[nxt] = -1;
			}
		}
	}
	return 0;
}
int dinic()
{
	int res = 0;
	int flow = 0;
	while(bfs())
	{
		while(flow = dfs(S,INF))
		{
			res += flow;
		}
	}
	return res;
}
int main()
{
	ios::sync_with_stdio(false); cin.tie(nullptr);
	cin>>n>>m>>S>>T;
	for(int i = 1;i<=n;i++)
	{
		int sti = v[i].size();
		int edi = v[i+n].size();
		if(i == S || i == T)
		{
			v[i].push_back({i+n,edi,INF});
			v[i+n].push_back({i,sti,0});
		}
		else
		{
			v[i].push_back({i+n,edi,1});
			v[i+n].push_back({i,sti,0});
		}
	}
	
	for(int i = 1;i<=m;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		int sti = v[x+n].size();
		int edi = v[y].size();
		v[x+n].push_back({y, edi, INF});
		v[y].push_back({x+n, sti, 0});
		sti = v[y+n].size();
		edi = v[x].size();
		v[y+n].push_back({x, edi, INF});
		v[x].push_back({y+n, sti, 0});
	}
	T = T + n;
	cout<<dinic()<<endl;
	return 0;
}
