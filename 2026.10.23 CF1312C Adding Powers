#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	int k;
	cin>>n>>k;
	vector<long long>a(n + 5);
	int po = 0;
	for(int i = 1;i<=n;i++)
	{
		cin>>a[i];
		if(a[i] % k > 1)
		{
			po = 1;
		}
	}
	if(k == 1)
	{
		cout<<"YES"<<endl;
		return;
	}
	if(po)
	{
		cout<<"NO"<<endl;
		return;
	}
	vector<int>ki;
	vector<int>cc;
	for(int i = 1;i<=n;i++)
	{
		long long temp = a[i];
		if(a[i] == 0)
		{
			continue;
		}
		int cnt = 0;
		while(temp > 0)
		{
			long long r = temp % k;
			if(r > 1)//k 进制某一位数>=2
			{
				cout<<"NO"<<endl;
				return;
			}
			else if(r == 1) //只有余数是1才要 比如9^2(9 + 1)余数是1 
			{
				cc.push_back(cnt);
			}
			//a^1 + a^2 + a ^ 3 + a ^ 4 == a(1 + a ^ 1 + a^2 + a^3 +  )余数是1，那a要留下
			//之后变成1 + a + a ^ 2 + a ^ 3 
			temp /= k;
			cnt ++;
		}
	}
	sort(cc.begin(),cc.end());
	for(int i = 1;i<cc.size();i++)
	{
		if(cc[i] == cc[i - 1])
		{
			cout<<"NO"<<endl;
			return;
		}
	}
	cout<<"YES"<<endl;
	return;
}
 
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
