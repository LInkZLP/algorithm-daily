#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 1e6+6;
vector<vector<int>>v(maxn);
vector<long long>dep(maxn);
vector<long long>dp(maxn);
vector<long long>sz(maxn);
vector<int>sum(maxn);
int ans = 1;
long long tar = 1;
void dfs(int u,int fa)
{
	sz[u] = 1;
	for(int i = 0;i<v[u].size();i++)	
	{
		int nxt = v[u][i];
		if(nxt == fa)
		{
			continue;
		}
		dfs(nxt,u);
		sz[u] += sz[nxt];
		dp[1] +=sz[nxt];
	}
	return;
}

void dfs2(int u,int fa)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i];
		if(nxt == fa)
		{
			continue;
		}
		//新根 v 下，只有两个节点的子树大小会变
		//v 的子树：从 sz_old[v] 变成 n（因为 v 成了整棵树的根）
		//u 的子树：从 n 变成 n - sz_old[v]（因为 u 现在在 v 的“上方”，
		//它的子树变成了除 v 子树外的所有节点）
		//其他节点的子树大小不变。
		dp[nxt] = dp[u] + n - 2 * sz[nxt];
		dfs2(nxt,u);
	}
}

int main()
{
	ios::sync_with_stdio(false); cin.tie(nullptr);
	cin>>n;
	for(int i = 1;i<=n-1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x); 
	}
	dfs(1,0);
	dfs2(1,0);
	for(int i = 1;i<=n;i++)
	{
		if(tar < dp[i])
		{
			ans = i;
			tar = dp[i];
		}
	}
	cout<<ans<<endl;
	return 0;
}
