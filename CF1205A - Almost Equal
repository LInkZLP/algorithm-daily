#include <bits/stdc++.h>
using namespace std;
int main()
{
	int t;
	t = 1;
	while(t--)
	{
		int n;
		cin>>n;
		if(n&1)
		{
			int k = 1;
			int p = 1;
			cout<<"YES"<<endl;
			vector<int>v(n*2+5);
			//分析前2n项和，只有n为奇数时候才可能形成1堆减去1堆为1的情况，那么可以排除偶数情况，其次，
			//分析可以知道，环对面与自身差值绝对值为1，那么可以设数列a1,a2,a3...an,b1,b2,b3...bn
			//继续分析，根据环的条件，可以得到a1 = b1+1,a2 +1 = b2... 
			for(int i = 1;i<=n;i++)
			{
				if(k & 1)
				{
					v[i] = p;
					p++;
					v[i + n] = p;
				
				}
				else
				{
					v[i + n] = p;
					p++;
					v[i] = p;
				} 
				k++;
				p++;
			}
			for(int i = 1;i<=2*n;i++)
			{
				cout<<v[i]<<" ";
			}
			cout<<endl;
		}
		else
		{
			cout<<"NO"<<endl;
		}
	}
	return 0;
 } 
