#include <bits/stdc++.h> 
using namespace std;
long long mod = 998244353;
const int maxn = 2e5 + 5;
vector<long long>l(maxn);
vector<long long>r(maxn);
vector<long long>da(maxn);
vector<long long>db(maxn);
vector<long long>dm(maxn);
vector<long long>inv(maxn);
vector<long long>f(maxn);
vector<long long>fi(maxn);
long long qpow(long long a,long long b)
{
	long long res = 1;
	while(b)
	{
		if(b & 1)
		{
			res = res * a % mod;
		}
		a = a *a % mod;
		b >>=1;
	}
	return res;
}
void ic()
{
	f[0] = 1;
	for(int i = 1;i<=2e5;i++)
	{
		f[i] = f[i - 1] * i% mod;
	}
	fi[200000] = qpow(f[200000], mod - 2);
	for(int i = 2e5;i>=1;i--)
	{
		fi[i - 1] = fi[i] * i % mod;
	}
	return;
}
long long C(long long a,long long b)
{
	if(b < 0 || b > a)
	{
		return 0;
	}
	return f[a] * fi[b] % mod * fi[a - b] % mod;
}
void solve()
{
	int n;
	cin>>n;
	inv[1] = 1;
	for(int i = 2;i<=2e5;i++)
	{
		inv[i] = (mod - mod / i) * inv[mod % i] % mod;
	}
	ic();
	for(int i = 1;i<=n;i++)
	{
		cin>>l[i]>>r[i];
		da[l[i]] ++;
		da[r[i] + 1] --;
		//li <= n - x <= ri
		//n - ri <= x <= n - li
		db[n - r[i]] ++;
		db[n - l[i] + 1] --;
		
		int la = l[i];
		int ra = r[i];
		int lb = n - r[i];
		int rb = n - l[i];
		if(lb >= la && lb <= ra && ra <= rb)
		{
			dm[lb] ++;
			dm[ra + 1] --;
		}
		else if(la >= lb && la <= rb && rb <= ra)
		{
			dm[la] ++;
			dm[rb + 1]--;
		}
		else if(la >= lb && ra <= rb)
		{
			dm[la] ++;
			dm[ra + 1]--;
		}
		else if(lb >= la && rb <= ra)
		{
			dm[lb] ++;
			dm[rb + 1]--;
		}
	}
	long long ans = 0;
	int cnta = 0;
	int cntb = 0;
	int mo = 0;
	for(int x = 1;x <= n - 1;x ++)
	{
		cnta += da[x];
		cntb += db[x];
		mo += dm[x];
		if(n - (cnta + cntb - mo) != 0)
		{
			continue;
		}
		int msa = cnta - mo;
		int msb = cntb - mo;
		if(msa > x || msb > n - x)
		{
			continue;
		}
		ans = (ans + C(mo,x - msa)) % mod;
	}
	cout<<ans<<endl;
	return;
}
int main()
{
	int t;
	//cin>>t;
	t = 1; 
	while(t--)	
	{
		solve();
	}
	return 0;
}
