#include <bits/stdc++.h>
using namespace std;

/*
 * 问题：给定 n 个玩家，m 场比赛，每场有两个玩家。每场必须决出一个胜者。
 * 求最小的 k，使得存在一种胜负分配，所有玩家获胜场数都不超过 k。
 * 并输出每场比赛的胜者。
 *
 * 建模：二分答案 + 最大流
 *
 * 为什么这样建模？
 * 我们把“每场比赛的胜利”看作一个流量单位。
 * - 源点 S 给每场比赛提供 1 个流量，表示这场比赛要产生一个胜者。
 * - 每场比赛节点只能将流量传给两个参赛玩家之一（容量为1），表示胜者唯一。
 * - 玩家节点到汇点 T 的容量限制为 k，表示该玩家最多能赢 k 场。
 * 如果最大流等于总比赛数 m，说明所有比赛都能分配胜者且不超过限制，当前 k 可行。
 *
 * 为什么这样建模是对的？
 * 因为任何一组满足“每场唯一胜者、每人最多 k 胜”的比赛结果，都对应一个满流；
 * 反之，任意一个满流也对应这样一组结果。网络流的容量限制完美匹配题目约束。
 *
 * 如何找方案？
 * 用最优 k 重新建图跑最大流后，每场比赛节点到两个玩家的边中，
 * 只有一条边会满流（剩余容量为0），该边指向的玩家就是胜者。
 */
	//我们是在寻找一个最小的 k，使得存在一种比赛结果，
	//使得赢最多的人恰好赢 k 场（或者不超过 k 场）
	//一次比赛都要决出胜负,这样最多赢次的确定 
	/*
	k的意义，就是为了确保每一场比赛都有胜利者，如果k过小，
	那么有些比赛无法决出胜利者，那么最多的那几个人是不确定的，
	如果k过大，那么全部的比赛都能决出胜利者，
	但并不是赢最多的人都赢了k场，也就是为了确保赢最多的那些人的赢的场次数值是k
	*/ 
int n, m;
struct st{
    int ed;   // 边终点
    int id;   // 反向边在终点邻接表中的位置
    int w;    // 剩余容量
};
const int maxn = 2e4 + 5;
vector<vector<st>> v(maxn);   // 基础图：S->比赛，比赛->玩家
vector<int> dep, cur;
int S, T;
const int INF = 1e5 + 5;

// 保存每场比赛的参赛者，用于输出
struct ma{
    int x, y;
};
vector<ma> mp(maxn);

// BFS 分层
bool bfs(vector<vector<st>> &g) {
    queue<int> q;
    q.push(S);
    dep.assign(maxn, -1);
    dep[S] = 0;
    while (!q.empty()) {
        int u = q.front(); q.pop();
        for (auto &e : g[u]) {
            if (e.w > 0 && dep[e.ed] == -1) {
                dep[e.ed] = dep[u] + 1;
                q.push(e.ed);
            }
        }
    }
    cur.assign(maxn, 0);
    return dep[T] != -1;
}

// DFS 增广
int dfs(int u, int lim, vector<vector<st>> &g) {
    if (u == T) return lim;
    for (int i = cur[u]; i < g[u].size(); i++) {
        cur[u] = i;
        st &e = g[u][i];
        if (e.w > 0 && dep[e.ed] == dep[u] + 1) {
            int ret = dfs(e.ed, min(lim, e.w), g);
            if (ret > 0) {
                e.w -= ret;
                g[e.ed][e.id].w += ret;
                return ret;
            }
        }
    }
    return 0;
}

// Dinic 最大流
int dinic(vector<vector<st>> &g) {
    int flow = 0, f;
    while (bfs(g)) {
        while ((f = dfs(S, INF, g)) > 0) flow += f;
    }
    return flow;
}

// 在基础图 v 上添加边
void add(int u, int x, int w) {
    v[u].push_back({x, (int)v[x].size(), w});
    v[x].push_back({u, (int)v[u].size() - 1, 0});
}

// 在临时图 g 上添加边
void add2(int u, int x, int w, vector<vector<st>> &g) {
    g[u].push_back({x, (int)g[x].size(), w});
    g[x].push_back({u, (int)g[u].size() - 1, 0});
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n >> m;
    S = 0;
    T = n + m + 1;

    // 读入每场比赛，建立基础图
    for (int i = 1; i <= m; i++) {
        int x, y;
        cin >> x >> y;
        mp[i] = {x, y};
        int matchNode = i;            // 比赛节点编号 1..m
        int playerX = m + x;          // 玩家 x 节点编号
        int playerY = m + y;          // 玩家 y 节点编号
        add(S, matchNode, 1);         // 源点->比赛，容量1
        add(matchNode, playerX, 1);   // 比赛->玩家x，容量1
        add(matchNode, playerY, 1);   // 比赛->玩家y，容量1
    }

    // 二分查找最小可行 k
    int l = 0, r = m, ans = 0;
    while (l <= r) {
        int mid = (l + r) / 2;
        vector<vector<st>> g = v;
        for (int i = 1; i <= n; i++) {
            add2(m + i, T, mid, g);   // 玩家i到汇点容量为 mid
        }
        if (dinic(g) == m) {          // 所有比赛都能分配
            ans = mid;
            r = mid - 1;
        } else {
            l = mid + 1;
        }
    }

    cout << ans << '\n';

    // 用最优 ans 重新建图，跑最大流以获取方案
    vector<vector<st>> g = v;
    for (int i = 1; i <= n; i++) add2(m + i, T, ans, g);
    dinic(g);

    // 输出每场比赛胜者
    for (int i = 1; i <= m; i++) {
        int winner = -1;
        for (auto &e : g[i]) {
            // 如果边的终点是玩家节点且剩余容量为0，说明这条边有流量
            if (e.ed >= m + 1 && e.ed <= m + n && e.w == 0) {
                winner = e.ed - m;
                break;
            }
        }
        if (winner == mp[i].x) cout << 1 << '\n';
        else cout << 0 << '\n';
    }

    return 0;
}
