#include <bits/stdc++.h>

using namespace std;
char to_char(int x)
{
	if(x >= 10)
	{
		return 'A'+(x - 10);
	}
	return '0'+x;
}

int to_int(char c)
{
	if(c >= '0' && c <= '9')
	{
		return c - '0'; 
	}	
	return c - 'A'+ 10;
}
int main()
{
	int n;
	string s;
	cin>>n>>s;
	int m;
	cin>>m;
	long long sum = 0;
	for(char x : s)//char x : 从 0索引开始 ,但字符串最左边的是0索引 
	{
		sum =sum*n+ to_int(x) ;
	}
	string ans = "";
	if(sum==0)
	{
		cout<<"0";
		return 0;
	 } 
	while(sum > 0)
	{
		int mod = sum % m;
		ans += to_char(mod);
		sum /= m;
	}
	for(int i = ans.size()-1;i>=0;i--)
	{
		cout<<ans[i];
	}
	return 0;
 } 
