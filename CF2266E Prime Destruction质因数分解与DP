#include <bits/stdc++.h>
using namespace std;
vector<int>p(2e5 + 5,1);
vector<int>pl;
void init()
{
	p[1] = 0;
	for(int i = 2;i<=2e5;i++)
	{
		if(p[i])
		{
			pl.push_back(i);
			for(int j = 2;j *i <= 2e5;j++)
			{
				p[i * j] = 0;
			}
		}
	}
	return;
}
void solve()
{
	int n;
	int k;
	cin>>n>>k;
	vector<int>dp(n + 5,INT_MAX);
	vector<int>v(n + 5);
	for(int i = 1;i<=k;i++)
	{
		dp[i] = 0;
	}
	for(int i : pl)
	{
		if(i > n)
		{
			break;
		}
		if(i > k)
		{
			dp[i] = 1;
		}
	//	cout<<i<<" "<<dp[i]<<endl;
	}
	for(int i = k + 1;i<=n;i++)
	{
		vector<int>nv;
		int temp = i;
		for(int x : pl)
		{
			if(x > temp)
			{
				break;
			}
			if(temp % x  == 0)
			{
				nv.push_back(x);
				while(temp % x == 0)
				{
					temp /= x;
				}
			}
		}
		if(temp > 1)
		{
			nv.push_back(temp);
		}
		int u = i;
		for(int x : nv)
		{
			dp[u] = min(dp[u / x] * x+ 1,dp[u]);
		}
	}
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	long long sum = 0;
	for(int i = 1;i<=n;i++)
	{
		sum += dp[v[i]];
	}
	cout<<sum<<endl;
	return;
}
int main()
{
	int t;
	cin>>t;
	init();
	while(t--)
	{
		solve();
	}
	return 0;
} 
