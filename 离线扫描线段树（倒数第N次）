#include <bits/stdc++.h>
using namespace std;
int n;
int m;
struct st{
	int s1;
	int id;
	int e1;
};
const int maxn = 2e6+5;
int c;
vector<int>s(maxn<<2);
vector<st>v(maxn);
vector<int>ans(maxn);
vector<int>po(maxn);
vector<int>last1(maxn);
vector<int>last2(maxn);
void change(int l,int r,int i,int jobl,int jobr,int k)
{
	if(l >= jobl && r <= jobr)
	{
		s[i] += k;
		return;
	}
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		change(l,mid,i<<1,jobl,jobr,k);
	}
	if(mid + 1 <= jobr)
	{
		change(mid+1,r,i<<1|1,jobl,jobr,k);
	}
	s[i] = s[i<<1] + s[i<<1|1];
	return;
}
int query(int l,int r,int i,int jobl,int jobr)
{
	if(l>=jobl && r <= jobr)
	{
		return s[i];
	}
	int res = 0;
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		res += query(l,mid,i<<1,jobl,jobr);
	}
	if(mid + 1 <=jobr)
	{
		res += query(mid + 1,r,i<<1|1,jobl,jobr);
	}
	return res;
}
bool cmp(st a,st b)
{
	return a.e1<b.e1;
}
int main()
{
	ios::sync_with_stdio(false);
	cin.tie(0);
	cin>>n>>c>>m;
	for(int i = 1;i<=n;i++)
	{
		cin>>po[i];
	}
	for(int i = 1;i<=m;i++)
	{
		cin>>v[i].s1>>v[i].e1;
		v[i].id = i;
	}
	sort(v.begin() + 1,v.begin() + 1+ m,cmp);
	int k = 1;
	for(int i = 1;i<=n;i++)
	{
		if(last1[po[i]] != 0)//只有两次以上才+1 
		{
			if(last2[po[i]] != 0)//两次以上往前的去掉 
			{
				change(1,n,1,last2[po[i]],last2[po[i]],-1);
			}
			change(1,n,1,last1[po[i]],last1[po[i]],1);
			last2[po[i]] = last1[po[i]];
		}
		last1[po[i]] = i;
		while(k <= m && v[k].e1== i)
		{
			ans[v[k].id] = query(1,n,1,v[k].s1,v[k].e1);
			k++;
		}
	} 
	for(int i = 1;i<=m;i++)
	{
		cout<<ans[i]<<"\n";
	}
	return 0;
}
