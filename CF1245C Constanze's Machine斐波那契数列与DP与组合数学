#include <bits/stdc++.h>
using namespace std;
void solve()
{
	string a;
	cin>>a;
	int p = 1;
	int n = a.size();
	vector<char>s(n + 5);
	long long MOD = 1e9 + 7;
	for(int i = 1;i<=n;i++)
	{
		s[i] = a[i-1];
		if(s[i] == 'w' || s[i] == 'm')
		{
			p = 0;
		}
	}
	if(!p)
	{
		cout<<0<<endl;
		return;
	}
	vector<long long> fib(n + 2);
	fib[0] = 1; fib[1] = 1;
	for (int i = 2; i <= n + 1; i++)
	    fib[i] = (fib[i-1] + fib[i-2]) % MOD;
	
	long long ans = 1;
	for (int i = 0; i < n; ) {
	    int j = i;
	    while (j < n && s[j] == s[i]) j++;
	    int len = j - i;
	    if (s[i] == 'u' || s[i] == 'n')
	        ans = ans * fib[len] % MOD;
	    i = j;
	}
	cout << ans << endl;
}
int main()
{
	int t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
}
