#include <bits/stdc++.h>
using namespace std;
const int maxn = 2e5+5;
vector<long long>v(maxn*2);
int n;
int m;
long long k;
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
	cin>>n>>m>>k;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
		v[i+n] = v[i];
	}
	long long sta = 1;
	long long l = 1;
	long long r = sta+1;
	long long ans =1;
	int cnt = 0;
	while(r<=2 * n)
	{
		if(abs(v[r] - v[r-1]) >  k)
		{	
			cnt++;
		}
		while(r - l + 1 > n || cnt > m)
		{
			if(abs(v[l+1] - v[l]) > k)
			{
				cnt--;
			}
			l++;
		}
		ans = max(ans,r - l + 1);
		r++;
	}
	cout<<ans<<endl;
	
	
	return 0;
}
