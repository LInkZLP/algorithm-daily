#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<int>v(n + 5);
	vector<int>l(n+5);
	vector<int>r(n+5);
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	for(int i = 1;i<=n;i++)
	{
		cin>>l[i]>>r[i];
	}
	for(int i = n;i>1;i--)
	{
		l[i - 1] = max(l[i - 1],l[i] - (v[i] != 0));
		r[i - 1] = min(r[i - 1],r[i] - (v[i] == 1));
	}
	int h = 0;
	for(int i = 1;i<=n;i++)
	{
		if(v[i] != -1)
		{
			h += v[i];
			if( h < l[i] || h > r[i])
			{	//	cout<<"ppp"<<i<<" "<<h<<endl;
				cout<<-1<<endl;
				return;
			}
		}
		else
		{
			if(h < l[i])
			{
				v[i] = 1;
			}
			if(h + 1 > r[i])
			{
				v[i] = 0;
			}
			if(v[i] < 0)
			{
				v[i] = 0;
			}
			h += v[i];
			if(h < l[i] || h > r[i])
			{
				cout<<-1<<endl;
				return ;
			}
		}
	}
	for(int i = 1;i<=n;i++)
	{
		cout<<v[i]<<" ";
	}
	cout<<endl;
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
