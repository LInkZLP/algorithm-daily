#include <bits/stdc++.h>
using namespace std;
int n;
long long w;
int main()
{
	cin>>n>>w;
	long long ans = LLONG_MAX;
	long long total = 1<<n;
	vector<vector<long long>>dp(20,vector<long long>(total,LLONG_MAX));
	vector<vector<long long>>rem(total,vector<long long>(20,w));
	vector<int>v(20);
	for(int i = 0;i<n;i++)
	{
		cin>>v[i];
		if(v[i] <= w)
		{
			dp[i][1<<i] = 1;
			rem[1<<i][i] = w - v[i];
		}
	}
	for(long long mask = 0;mask<total;mask++)
	{
		for(int i = 0;i<n;i++)
		{
			if((mask & (1<<i)) == 0)
			{
				continue;
			}
			for(int j = 0;j<n;j++)
			{
				if((mask & (1<<j)) == 0)
				{
					continue;
				}
				long long prev = mask ^ (1<<i);
				if(((1<<j) & prev) == 0)
				{
					continue;
				}
				if(rem[prev][j] - v[i] >=0)
				{
					if(dp[i][mask] > dp[j][prev])
					{
						dp[i][mask] = dp[j][prev];
						rem[mask][i] = rem[prev][j] - v[i];
					}
					else if(dp[i][mask] == dp[j][prev] && rem[mask][i] < rem[prev][j] - v[i])
					{
						rem[mask][i] = rem[prev][j] - v[i];
					}
				}
				else if(rem[prev][j] - v[i] < 0 )
				{
					if(dp[i][mask] > dp[j][prev] + 1)
					{
						dp[i][mask] = dp[j][prev] + 1;
						rem[mask][i] = w - v[i];
					}
					else if(dp[i][mask] == dp[j][prev]+1 && rem[mask][i] < w - v[i])
					{
						rem[mask][i] = w- v[i];
					}
				}
			}
		}
	}
	for(int i = 0;i<n;i++)
	{
		ans = min(ans,dp[i][total-1]);
	}
	cout<<ans<<endl;
	return 0;
}
