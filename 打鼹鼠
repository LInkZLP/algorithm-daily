#include <bits/stdc++.h>
using namespace std;
struct xyt{
	int x;
	int y;
	int t;
};
const int maxn = 1e4+5;
vector<xyt>v(maxn);
int n;
int m;
long long ans = 0;
//本题类似于最长上升子序列！！！！！ 
long long dist(int px,int py,int tx,int ty)
{
	return abs(px - tx) + abs ( ty - py);
}
int main()
{
	cin>>n>>m;
	for(int i = 1;i<=m;i++)
	{
		int tx;
		int ty;
		int tt;
		cin>>tt>>tx>>ty;
		v[i].t = tt;
		v[i].x = tx;
		v[i].y = ty;
	}
	vector<long long>f(m+1);
	for(int i = 1;i<=m;i++)
	{
		f[i] = 1; 
		for(int j = 1;j<i;j++)
		{
			if(dist(v[i].x,v[i].y,v[j].x,v[j].y) <= abs(v[i].t - v[j].t))
			{
				f[i] = max(f[i],f[j] + 1);
			}
		}
	}
	for(int i = 1;i<=m;i++)
	{
		ans = max(ans,f[i]);
	}
	cout<<ans<<endl;
	return 0;
}
