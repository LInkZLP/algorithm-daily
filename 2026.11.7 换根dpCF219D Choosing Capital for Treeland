#include <bits/stdc++.h>
using namespace std;
struct st{
	int ed;
	int di;
};
const int maxn = 2e5 + 5;
int n;
int m;
vector<int>ans(maxn);
vector<vector<st>>v(maxn);
vector<int>dp(maxn);
void dfs0(int u,int p)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		if(ed == p)
		{
			continue;
		}
		dfs0(ed,u);
		dp[u] += dp[ed] + (v[u][i].di == 0);
	}
	return;
}
void dfs1(int u,int p,int id)
{
	if(u != 1)
	{
		ans[u] = ans[p] - (id == 0) + (id == 1);//错误点，把dp换成ans，dp永远是旧的 
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		if(ed == p)
		{
			continue;
		}
		dfs1(ed,u,v[u][i].di);
	}
	return;
}
void solve()
{
	cin>>n;
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back({y,1});
		v[y].push_back({x,0});
	}
	dfs0(1,0);
	ans[1] = dp[1];
	dfs1(1,1,0);
	int mx = n + 10;
	for(int i = 1;i<=n;i++)
	{
	//	cout<<ans[i]<<endl;
		mx = min(ans[i],mx);
	}
	cout<<mx<<endl;
	for(int i = 1;i<=n;i++)
	{
		if(mx == ans[i])
		{
			cout<<i<<" ";
		}
	}
	cout<<endl;
	return;
}
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
	int t = 1;
	while(t--) 
	{
		solve();
	}
		
	return 0;
} 
