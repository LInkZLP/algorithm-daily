#include <bits/stdc++.h>
using namespace std;
const int maxn = 2e4+5;
int n;
int m;
vector<vector<int>>v(maxn);
vector<int>low(maxn);
vector<int>dfn(maxn);
vector<int>po(maxn);
int timer = 0;
int cnt = 0;
void tarjan(int u,int fa)
{
	timer ++;
	low[u] = dfn[u] = timer;
	int son = 0;
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i];
		if(nxt == fa)
		{
			continue;
		}
		if(!dfn[nxt])
		{
			son ++;
			tarjan(nxt,u);
			low[u] = min(low[u],low[nxt]);
			if(low[nxt] >= dfn[u])
			{
				if(fa != 0 || son >= 2)//如果当前不是根节点，或者（是根节点且儿子数≥2）
				{
					po[u] = 1;
					
				}
			}
		}
		else
		{
			low[u] = min(low[u],dfn[nxt]);
		}
	}
	
	return ;
}
int main()
{
	cin>>n>>m;
	while(m--)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	for(int i = 1;i<=n;i++)
	{
		if(!dfn[i])
		{
			tarjan(i,0);
		}
	}
	
	for(int i = 1;i<=n;i++)
	{
		if(po[i])
		{
			cnt++;
		}	
	}
	cout<<cnt<<endl;
	for(int i = 1;i<=n;i++)
	{
		if(po[i])
		{
			cout<<i<<" ";
		}	
	}
	cout<<endl; 
	return 0;
}
