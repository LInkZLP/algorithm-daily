#include <bits/stdc++.h>
using namespace std;

int main()
{
	int n;
	cin>>n;
	vector<long long>v(n+5);
	long long mod = 1e9+7;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	sort(v.begin()+1,v.begin()+1+n);
	long long ans = 1;
	for(int i = 1;i<=n;i++)
	{
		ans = (ans * (v[i] - i + 1)) % (mod);
	}
	cout<<ans<<endl;
	return 0;
}
