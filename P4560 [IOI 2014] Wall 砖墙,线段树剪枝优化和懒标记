#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 2e6 + 6;
vector<long long>mx(maxn<<2);
vector<long long>mi(maxn<<2);
vector<long long>add(maxn<<2,-1);
void up(int i)
{
	mi[i] = min(mi[i<<1],mi[i<<1|1]);
	mx[i] = max(mx[i<<1],mx[i<<1|1]);
	return;
}
void down(int i)
{
	if(add[i] != -1)
	{
		mx[i<<1] = add[i];
		mi[i<<1] = add[i];
		mx[i<<1|1] = add[i];
		mi[i<<1|1] = add[i];
		add[i<<1] = add[i];
		add[i<<1|1] = add[i];
		add[i] = -1;
	}
}
void change1(int l, int r,int i,int jobl,int jobr,long long va)
{
	if(l > jobr || r < jobl)
	{
		return;
	}
	if(mi[i] >= va)
	{
		return;
	}
	if(l >= jobl && r <=jobr && mx[i] < va)
	{
		add[i] = va;
		mx[i] = va;
		mi[i] = va;
		return;
	}
	if(l == r)
	{
		mi[i] = va;
		mx[i] = va;
		return;
	}
	int mid = (l + r) >>1;
	down(i);
	if(mid >= jobl)
	{
		change1(l,mid,i<<1,jobl,jobr,va);
	}
	if(mid + 1 <=jobr)
	{
		change1(mid + 1,r,i<<1|1,jobl,jobr,va);
	}
	up(i);
	return;
}
void change2(int l, int r,int i,int jobl,int jobr,long long va)
{
	if(l > jobr || r < jobl)
	{
		return;
	}
	if(mx[i] <= va)
	{
		return;
	}
	if(l >= jobl && r <=jobr && mi[i] > va)
	{
		add[i] = va;
		mx[i] = va;
		mi[i] = va;
		return;
	}
	if(l == r)
	{
		mi[i] = va;
		mx[i] = va;
		return;
	}
	down(i);
	int mid = (l + r) >>1;
	if(mid >= jobl)
	{
		change2(l,mid,i<<1,jobl,jobr,va);
	}
	if(mid + 1 <=jobr)
	{
		change2(mid + 1,r,i<<1|1,jobl,jobr,va);
	}
	up(i);
	return;
}
long long query(int l,int r,int i,int jobl,int jobr)
{
	if(l >= jobl && r <=jobr)
	{
		return mi[i];
	}
	int mid = (l + r)>>1;
	long long  ans = LLONG_MAX;
	down(i);
	if(mid >= jobl)
	{
		ans = min(ans,query(l,mid,i<<1,jobl,jobr));
	}
	if(mid + 1 <= jobr)
	{
		ans = min(ans,query(mid + 1,r,i<<1|1,jobl,jobr));
	}
	return ans;
}
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
	cin>>n>>m;
	for(int i = 1;i<=m;i++)
	{
		int op;
		int x;
		int y;
		long long va;
		cin>>op>>x>>y>>va;
		x ++;
		y ++;
		if(op == 1)
		{
			change1(1,n,1,x,y,va);
		}
		else
		{
			change2(1,n,1,x,y,va);
		}
	}
	for(int i = 1;i<=n;i++)
	{
		cout<<query(1,n,1,i,i)<<'\n';
	}
	return 0;
}
