#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int t;
const int maxn = 2e5 + 5;
vector<int>col(maxn);
vector<int>ans(maxn,INT_MIN);
vector<vector<int>>v(maxn);
vector<int>c1(maxn);
vector<int>sz(maxn);
vector<int>ss(maxn);
void dfs0(int u,int p)
{
	if(col[u] == 1)
	{
		ss[u] = 1;
		ans[u] = 1;
	}
	else
	{
		ss[u] = -1;
		ans[u] = -1;
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dfs0(ed,u);
		ss[u] = max(ss[u],ss[u] + ss[ed]);
	}
	return;
}
void dfs1(int u,int p)
{
	if(u != 1)
	{
		int dh = ss[u] > 0 ? ss[u] : 0;
		ans[u] = max(ss[u] + ans[p] - dh,ss[u]);
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dfs1(ed,u);
	}
	return;
}
void solve()
{
	cin>>n;
	for(int i = 1;i<=n;i++)
	{
		cin>>col[i];
	}
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	dfs0(1,0);
	ans[1] = ss[1];
	dfs1(1,0);
	for(int i = 1;i<=n;i++)
	{
		cout<<ans[i]<<" ";
	}
	cout<<endl;
	return;
}
int main()
{
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
}
