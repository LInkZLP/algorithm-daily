#include <bits/stdc++.h>
using namespace std;
int S;
int T;
int n;
int m;
struct st{
	int ed;
	int id;
	int w;
};
vector<int>dep;
vector<int>cur;
int maxn = 6005;
int INF = 1e8;
vector<vector<st>>v(maxn);
vector<vector<int>>mp(60,vector<int>(60,0));
int rk = 0;
int rc = 0;
vector<vector<int>>v1(60,vector<int>(60,0));
vector<vector<int>>v2(60,vector<int>(60,0));
bool bfs()
{
	queue<int>q;
	dep.assign(maxn,-1);
	q.push(S);
	dep[S] = 0;
	while(!q.empty())
	{
		int u = q.front();
		q.pop();
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i].ed;
			if(dep[ed] == -1 && v[u][i].w)
			{
				dep[ed] = dep[u] + 1;
				q.push(ed);
			}
		}
	}
	cur.assign(maxn,0);
	return dep[T] != -1;
}
int dfs(int u,int lim)
{
	if(u == T)
	{
		return lim;
	}
	for(int i = cur[u];i<v[u].size();i++)
	{
		int ed = v[u][i].ed;
		cur[u] = i;
		if(dep[ed] == dep[u] + 1 && v[u][i].w)
		{
			int res = dfs(ed,min(lim,v[u][i].w));
			if(res)
			{
				v[u][i].w -= res;
				v[ed][v[u][i].id].w += res;
				return res;
			}
			else
			{
				dep[ed] = -1;
			}
		}
	}
	return 0;
}
int dinic()
{
	int r = 0;
	int f = 0;
	while(bfs())
	{
		while(f = dfs(S,INF))
		{
			r += f;
		//	cout<<"ppp"<<endl;
		}
		//cout<<"pp"<<endl;
	}
	return r;
}
void add(int u,int x,int w)
{
	int sti = v[u].size();
	int edi = v[x].size();
	v[u].push_back({x,edi,w});
	v[x].push_back({u,sti,0});
	return ;
}
int main()
{
	cin>>n>>m;
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			char c;
			cin>>c;
			if(c == '*')
			{
				mp[i][j] = 1;
			}
		}
	}
	int hb = 0;
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			if(!hb && mp[i][j] == 1)
			{
				hb = 1;
				rc ++;
				v1[i][j] = rc;
			}
			else if(mp[i][j] == 1)
			{
				v1[i][j] = rc;
			}
			else
			{
				hb = 0;
			}
		}
		hb = 0;
	}
	hb = 0;
	for(int j = 1;j<=m;j++)
	{
		for(int i = 1;i<=n;i++)
		{
			if(!hb && mp[i][j] == 1)
			{
				hb = 1;
				rk ++;
				v2[i][j] = rk;
			}
			else if(mp[i][j] == 1)
			{
				v2[i][j] = rk;
			}
			else
			{
				hb = 0;
			}
		}
		hb = 0;
	}
	S = 0;
	T = 6001;
	for(int i = 1;i<=rc;i++)
	{
		add(S,i,1);
	}
	for(int i = 1;i<=rk;i++)
	{
		add(i + rc,T,1);
	}
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=m;j++)
		{
			if(mp[i][j] == 1)
			{
				add(v1[i][j],v2[i][j] + rc,1);
			}
		}
	}
	cout<<dinic()<<endl;
	return 0;
}
