#include <bits/stdc++.h>
using namespace std;

int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		//观察样例每次都是取最大和最小 
		vector<long long>v(n+5);
		vector<long long>a1;
		vector<long long>a2;
		int cnt = 0;
		long long p = LLONG_MAX;
		long long m = 0;
		for(int i = 1;i<=n;i++)
		{
			cin>>v[i];
			p = min(p,v[i]);
			m = max(m,v[i]);
		}
		if(n == 1 || m == p)
		{
			cout<<0<<endl;
			continue;
		}
		if(p == 1 && n != 1)
		{
			cout<<-1<<endl;		
			continue;
		}	
			
		while(1)
		{
			long long mxp = 0;
			long long mip = LLONG_MAX;
			int ux = 0;
			int ui = 0;
			for(int j = 1;j<=n;j++)
			{
				if(mip > v[j])
				{
					ui = j;
					mip = v[j];
				}
				if(mxp < v[j])
				{
					ux = j;
					mxp = v[j];
				}
			}
			if(mxp == mip)
			{
				break;
			}
			a1.push_back(ux);
			a2.push_back(ui);
			cnt++;
			if(mxp % mip == 0)
			{
				v[ux] = mxp / mip;
			}
			else
			{
				v[ux] = mxp / mip + 1;
			}
		}
		cout<<cnt<<endl;
		for(int i = 0;i<a1.size();i++)
		{
			cout<<a1[i]<<" "<<a2[i]<<endl;
		}
	}
	return 0;
} 
