#include <bits/stdc++.h>
using namespace std;
int n;
int m;
int k;
const int maxn = 1e3+5;
const int maxm = 1e4+5;
#define pli pair<long long,int>
vector<vector<pli>>v(maxn);
long long work(vector<vector<long long>>&dp)
{
	int sta = 1;
	dp[sta][k] = 0;
	priority_queue<pli,vector<pli>,greater<pli>>pq;
	pq.push({0,sta * (k + 1) + k});
	while(!pq.empty())
	{
		pli r = pq.top();
		pq.pop();
		int now = r.second/ (k + 1);
		int cnt = r.second % (k + 1);
		//cout<<"now: " <<now<<" "<<cnt<<" "<<dp[now][cnt]<<endl;
		for(int i = 0;i<v[now].size();i++)
		{
			int next = v[now][i].second;
			long long w = v[now][i].first;
			if(cnt >= 1 && dp[next][cnt-1] > dp[now][cnt])
			{
				dp[next][cnt-1] = dp[now][cnt];
				pq.push({dp[next][cnt-1],next * (k + 1) + cnt-1});
				//cout<<next<<" "<<cnt-1<<endl;
			}
			if(dp[next][cnt] > max(w,dp[now][cnt]))
			{
				dp[next][cnt] = max(w,dp[now][cnt]);
				pq.push({dp[next][cnt],next * (k + 1) + cnt});
				//cout<<next<<" "<<cnt<<endl;
			}
		}
	}
	long long ans = LLONG_MAX;
	for(int i = 0;i<=k;i++)
	{
		ans = min(ans,dp[n][i]);
	}
	return ans;
}
int main()
{
	cin>>n>>m>>k;
	vector<vector<long long>>dp(n+5,vector<long long>(k+5,LLONG_MAX));
	while(m--)
	{
		int x;
		int y;
		long long l;
		cin>>x>>y>>l;
		v[x].push_back({l,y});
		v[y].push_back({l,x});
	}
	long long res = work(dp);
	if(res == LLONG_MAX)
	{
		cout<<-1<<endl;
	}
	else
	{
		cout<<res<<endl;
	}
	return 0;
 } 
