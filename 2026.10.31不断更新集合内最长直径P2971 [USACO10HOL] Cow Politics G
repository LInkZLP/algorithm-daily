	}
	for(int i = LOG - 1;i>=0;i--)
	{
		if(up[a][i] != up[b][i])
		{
			a = up[a][i];
			b = up[b][i];
		}
	}
	return up[a][0];
}
int dist(int u,int x)
{
	return dep[u] + dep[x] - 2* dep[lca(u,x)];
}
