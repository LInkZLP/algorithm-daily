## 四、实现流程

```
① 读入 (A_i, P_i)，P_i = 0 是根；建无向邻接表，同时 col[A_i].push_back(i) 按颜色分组
② 迭代 BFS 建树：求 dep[] 和倍增表 up[LOG][*]（千万别用递归）
③ 距离：dist(u,v) = dep[u] + dep[v] - 2*dep[lca(u,v)]
④ 每种颜色：
     若点数 < 2 → 输出 0
     否则 s1 = 第1个, s2 = 第2个, cur = dist(s1,s2)
     从第3个点起：算 d1 = dist(x,s1)、d2 = dist(x,s2)
        if (d1 >= d2 && d1 > cur)  { cur = d1; s2 = x; }   // 新直径 (s1,x)，替换 s2
        else if (d1 < d2 && d2 > cur) { cur = d2; s1 = x; } // 新直径 (s2,x)，替换 s1
     输出 cur
```

### 完整代码（`cowpol/final.cpp`，已实测）

```cpp
#include <bits/stdc++.h>
using namespace std;
const int maxn = 2e5 + 5;
const int LOG = 23;
int n, k;
vector<vector<int>>v(maxn);
vector<vector<int>>col(maxn);
vector<int>dep(maxn);
int up[LOG][maxn];          // 静态数组: 比 vector<vector<int>> 更省更快
int ordv[maxn];

void build(int root)        // 迭代建树(BFS序): 链状数据不爆栈
{
	int head = 0, tail = 0;
	ordv[tail++] = root;
	up[0][root] = 0;
	while(head < tail)
	{
		int u = ordv[head++];
		for(int i = 1;i<LOG;i++) up[i][u] = up[i-1][up[i-1][u]];
		for(int i = 0;i<v[u].size();i++)
		{
			int ed = v[u][i];
			if(ed == up[0][u]) continue;
			up[0][ed] = u;
			dep[ed] = dep[u] + 1;
			ordv[tail++] = ed;
		}
	}
}
int lca(int a,int b)
{
	if(dep[a] < dep[b]) swap(a,b);
	int dh = dep[a] - dep[b];
	for(int i = LOG - 1;i>=0;i--) if(dh & (1 << i)) a = up[i][a];
	if(a == b) return a;
	for(int i = LOG - 1;i>=0;i--)
		if(up[i][a] != up[i][b]) { a = up[i][a]; b = up[i][b]; }
	return up[0][a];
}
int dist(int a,int b){ return dep[a] + dep[b] - 2 * dep[lca(a,b)]; }

int main()
{
	ios::sync_with_stdio(false); cin.tie(0);
	cin>>n>>k;
	int r = 1;
	for(int i = 1;i<=n;i++)
	{
		int a, p;
		cin>>a>>p;
		col[a].push_back(i);
		if(p == 0) r = i;
		else { v[p].push_back(i); v[i].push_back(p); }
	}
	build(r);
	for(int c = 1;c<=k;c++)
	{
		if(col[c].size() < 2) { cout<<0<<endl; continue; }
		int s1 = col[c][0], s2 = col[c][1];
		int cur = dist(s1,s2);
		for(int j = 2;j<col[c].size();j++)
		{
			int nxt = col[c][j];
			int d1 = dist(nxt,s1), d2 = dist(nxt,s2);
			if(d1 >= d2 && d1 > cur)     { cur = d1; s2 = nxt; }
			else if(d1 < d2 && d2 > cur) { cur = d2; s1 = nxt; }
		}
		cout<<cur<<endl;
	}
	return 0;
}
```

