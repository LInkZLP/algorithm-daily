void dfs(int u,int p)
{
	up[u][0] = p;
	for(int i = 1;i<=LOG - 1;i++)
	{
		up[u][i] = up[up[u][i - 1]][i - 1];
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dep[ed] = dep[u] + 1;
		dfs(ed,u);
	}
	return;
}
int lca(int a,int b)
{
	if(dep[a] < dep[b])
	{
		swap(a,b);
	}
	int dh = dep[a] - dep[b];
	for(int i = LOG - 1;i>=0;i--)
	{
		if(dh & ( 1<<i))
		{
			a = up[a][i];
		}
	}
	if(a == b)
	{
