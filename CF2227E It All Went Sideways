#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<long long>v(n+5);
	long long sum = 0;
	for(int i = 1;i<=n;i++)
	{
		cin>>v[i];
	}
	long long mx1 = 0;
	long long ans = 0;
	long long min1 = n + 1;
	for(int i = n;i >= 1;i--)
	{
		if(v[i] < min1)
		{
			mx1 = i;
		}
		min1 = min(min1,v[i]);
		ans += v[i] - min1;
		sum = max(sum,mx1 - i);
	}
	cout<<ans + sum<<endl;
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
