#include <bits/stdc++.h>
using namespace std;

int main()
{
	int q;
	long long v;
	cin>>q>>v;
	priority_queue<long long>pq;
	while(q--)
	{
		int op;
		int t;
		cin>>op>>t;
		if(op == 1)
		{
			int w;
			cin>>w;
			pq.push(w - t);
		}
		else
		{
			if(pq.empty())
			{
				cout<<-1<<endl;
			}
			else
			{
				cout<<min(v,pq.top() + t)<<"\n";
			}
			pq.pop();
		}
	}
	
	return 0;
}
