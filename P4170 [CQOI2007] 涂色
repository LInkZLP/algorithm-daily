#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 3e3+5;
void solve()
{
	string s;
	cin>>s;
	n = s.size();
	vector<char>v(n+5);
	vector<vector<int>>dp(n+5,vector<int>(n+5,INT_MAX));
	for(int i = 1;i<=n;i++)
	{
		v[i] = s[i-1];
		dp[i][i] = 1;
		dp[i][i-1] = 0;
	}
	for(int len  = 2;len <= n;len ++)
	{
		for(int i = 1;i + len - 1 <=n;i++)
		{
			int j = len + i - 1;
			if(v[i] == v[j])
			{
				dp[i][j] = min(dp[i+1][j],dp[i][j-1]);
			}
			else
			{
				for(int k = i;k<j;k++)
				{
					dp[i][j] = min(dp[i][j],dp[i][k] + dp[k+1][j]);
				}
			}
		}
	}
	cout<<dp[1][n]<<endl;
}
int main()
{
	int t;
	t = 1;
	while(t--)
	{
		solve();
	}
	return 0;
} 
