#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	cin>>n;
	vector<int>a(n+5);
	for(int i = 1;i<=n;i++)
	{
		cin>>a[i];
	}
	vector<int>diff(n+5);
	for(int k = 1;k<=n;k++)
	{
		long long l = 1LL*a[k] * k;
		long long r = l + k-1;
		if(l >= n)
		{
			continue;
		}
		if(r >= n)
		{
			r = n -1;
		}
		diff[l] ++;
		diff[r+1]--;
	}
	vector<int>b;
	int cur = 0;
	for(int i = 0;i<n;i++)
	{
		cur += diff[i];
		if(cur == 0)
		{
			b.push_back({i});
		}
	}
	cout<<b.size()<<endl;
	for(int i : b)
	{
		cout<<i<<" ";
	}
	cout<<endl;
	return;;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
