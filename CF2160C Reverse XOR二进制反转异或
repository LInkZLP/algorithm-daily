#include <bits/stdc++.h>
using namespace std;
void solve()
{
	long long n;
	cin>>n;
	string s1 = "";
	int p = n % 2;
	int tr = 0;
	int k = 0;
	if(n == 0)
	{
		cout<<"Yes"<<endl;
		return;
	}
	if((n & (n - 1)) == 0)
	{
		cout<<"NO"<<endl;
		return;
	}
	while(n)
	{
		if(n & 1)
		{
			s1 = "1" + s1;
			k = 1;
		}
		else
		{
			s1 = "0" + s1;
			if(!k)
			{
				tr ++;
			}
		}
		n >>= 1;
	}
	if(p == 0)
	{
		while(tr--)
		{
			s1 = "0" + s1;
		}
	}
//	cout<<s1<<endl;
	if (s1.size() % 2 == 1 && s1[s1.size() / 2] == '1') 
	{
	    cout << "NO" << endl;
	    return;
	}
	for(int i = 0;i<s1.size();i++)
	{
		int l = i;
		int r = s1.size() - 1- i;
		if(s1[l] != s1[r])
		{
			cout<<"No"<<endl;
			return;
		}
		if(l >= r)
		{
			break;	
		} 
	}
	cout<<"Yes"<<endl;
	return ;
}
int main()
{
	ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	return 0;
}
