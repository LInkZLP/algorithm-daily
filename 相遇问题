#include <bits/stdc++.h>
using namespace std;

// 定义别名：pair<long long, int>，用于优先队列（距离, 编码后的节点状态）
#define pli pair<long long, int>

int t;      // 测试用例数量
int n;      // 当前图的顶点数
int m;      // 边数
int h;      // 有马的顶点数

int main() {
    // 加速输入输出，避免大数据时超时
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> t;
    while (t--) {
        cin >> n >> m >> h;

        // 动态分配大小：n+5 比 n 稍大，防止越界
        int maxn = n + 5;

        // hor[i] 表示顶点 i 是否有马
        vector<bool> hor(maxn, false);
        for (int i = 1; i <= h; i++) {
            int x;
            cin >> x;
            hor[x] = true;
        }

        // 邻接表存图，每条边存储 (权值, 邻接点)
        vector<vector<pli>> v(maxn);
        for (int i = 1; i <= m; i++) {
            int x, y;
            long long w;    // 边权（偶数）
            cin >> x >> y >> w;
            v[x].push_back({w, y});
            v[y].push_back({w, x});
        }

        // dist1[u][0] : 从起点1出发，到达u时未骑马的最短时间
        // dist1[u][1] : 从起点1出发，到达u时已经骑马的最短时间
        // 同理 dist2 是从终点 n 出发（即 Robin 的视角）
        vector<vector<long long>> dist1(maxn, vector<long long>(2, LLONG_MAX));
        vector<vector<long long>> dist2(maxn, vector<long long>(2, LLONG_MAX));
        dist1[1][0] = 0;    // 起点1，未骑马，时间0
        dist2[n][0] = 0;    // 起点n，未骑马，时间0

        // 优先队列（小根堆），存储 (距离, 编码后的状态)
        // 编码方式：state = u*2 + horse  (horse = 0或1)
        priority_queue<pli, vector<pli>, greater<pli>> pq1;
        priority_queue<pli, vector<pli>, greater<pli>> pq2;

        // 初始化队列：若起点本身有马，则可以直接上马（距离0，状态为骑马）
        if (hor[1]) {
            dist1[1][1] = 0;
            pq1.push({0, 1 * 2 + 1});
        } else {
            pq1.push({0, 1 * 2 + 0});
        }
        if (hor[n]) {
            dist2[n][1] = 0;
            pq2.push({0, n * 2 + 1});
        } else {
            pq2.push({0, n * 2 + 0});
        }

        // ---------- 第一次 Dijkstra：从 Marian 的起点（1）出发 ----------
        while (!pq1.empty()) {
            pli r = pq1.top();
            pq1.pop();
            int now = r.second / 2;      // 当前顶点
            int x = r.second % 2;        // 当前骑马状态（0未骑，1已骑）
            long long d1 = r.first;

            // 如果当前取出的距离不是该状态的最新最短距离，跳过（经典优化）
            if (d1 > dist1[now][x])
                continue;

            // 遍历所有邻边
            for (size_t i = 0; i < v[now].size(); i++) {
                int nxt = v[now][i].second;
                long long w = v[now][i].first;

                if (x == 1) {
                    // 已经骑马：过边时间减半，且继续骑马
                    if (dist1[nxt][1] > dist1[now][1] + w / 2) {
                        dist1[nxt][1] = dist1[now][1] + w / 2;
                        pq1.push({dist1[nxt][1], nxt * 2 + 1});
                    }
                } else { // 未骑马
                    // 情况1：走到 nxt 且 nxt 有马 → 可以在 nxt 骑上马（上马不花时间），
                    //       状态变为骑马，时间增加 w（原价）
                    if (hor[nxt]) {
                        if (dist1[nxt][1] > dist1[now][0] + w) {
                            dist1[nxt][1] = dist1[now][0] + w;
                            pq1.push({dist1[nxt][1], nxt * 2 + 1});
                        }
                    }
                    // 情况2：走到 nxt 且仍然不骑马（无论 nxt 是否有马，都可以选择不骑）
                    //       这里注意：即使 nxt 有马，也可以选择不骑马继续，因此需要单独考虑
                    //       为了正确性，这个分支不能写在 else 里，应该无条件执行。
                    //       原代码中该分支写在 else 里，即仅当 hor[nxt]==false 时才更新 dist0，
                    //       这会导致如果 nxt 有马，不骑马的状态没有被更新。但实际中，因为题目允许不骑马，
                    //       所以这个更新也是必要的。不过由于你 AC 了，说明数据可能不依赖这种情况，
                    //       或者骑马总是更优，不会影响最终答案。为严谨，建议以后补上这个分支。
                    //       此处保持原样，但加注释说明。
                    if (!hor[nxt]) {   // 只有 nxt 没马时才考虑不骑马（原代码逻辑）
                        if (dist1[nxt][0] > dist1[now][0] + w) {
                            dist1[nxt][0] = dist1[now][0] + w;
                            pq1.push({dist1[nxt][0], nxt * 2 + 0});
                        }
                    }
                }
            }
        }

        // ---------- 第二次 Dijkstra：从 Robin 的起点（n）出发 ----------
        // 逻辑与第一次完全对称，只是队列和距离数组变为 dist2 和 pq2
        while (!pq2.empty()) {
            pli r = pq2.top();
            pq2.pop();
            int now = r.second / 2;
            int x = r.second % 2;
            long long d1 = r.first;
            if (d1 > dist2[now][x])
                continue;

            for (size_t i = 0; i < v[now].size(); i++) {
                int nxt = v[now][i].second;
                long long w = v[now][i].first;

                if (x == 1) {
                    if (dist2[nxt][1] > dist2[now][1] + w / 2) {
                        dist2[nxt][1] = dist2[now][1] + w / 2;
                        pq2.push({dist2[nxt][1], nxt * 2 + 1});
                    }
                } else {
                    if (hor[nxt]) {
                        if (dist2[nxt][1] > dist2[now][0] + w) {
                            dist2[nxt][1] = dist2[now][0] + w;
                            pq2.push({dist2[nxt][1], nxt * 2 + 1});
                        }
                    }
                    if (!hor[nxt]) {
                        if (dist2[nxt][0] > dist2[now][0] + w) {
                            dist2[nxt][0] = dist2[now][0] + w;
                            pq2.push({dist2[nxt][0], nxt * 2 + 0});
                        }
                    }
                }
            }
        }

        // ---------- 枚举汇合点（只能在顶点上相遇）----------
        long long minw = LLONG_MAX;
        for (int i = 1; i <= n; i++) {
            // 两人分别到达 i 的最短时间（可以选择骑马或不骑，取较小者）
            long long cost1 = min(dist1[i][0], dist1[i][1]);
            long long cost2 = min(dist2[i][0], dist2[i][1]);
            // 如果有一方无法到达，跳过
            if (cost1 == LLONG_MAX || cost2 == LLONG_MAX)
                continue;
            // 两人相遇的时间取决于后到达的人（先到的需要等待）
            long long cost = max(cost1, cost2);
            if (cost < minw)
                minw = cost;
        }

        // 输出答案，若无法相遇输出 -1
        if (minw == LLONG_MAX)
            cout << -1 << '\n';
        else
            cout << minw << '\n';
    }
    return 0;
}
