#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 205;
vector<vector<int>>mp(maxn,vector<int>(maxn,0));
vector<vector<int>>tar(maxn,vector<int>(maxn,0));
int mv = 2e4+5;
vector<vector<int>>v(mv);
vector<int>ml(mv);
vector<int>mr(mv);
vector<int>vis;
int bcnt = 0;
int wcnt = 0;
int dx[] = {-1,-2,1,2,-1,-2,1,2};
int dy[] = {-2,-1,-2,-1,2,1,2,1};
bool dfs(int u)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int nxt = v[u][i];
		if(!vis[nxt])
		{
			vis[nxt] = 1;
			if(!mr[nxt] || dfs(mr[nxt]))
			{
				ml[u] = nxt;
				mr[nxt] = u;
				return true;
			}
		}
	}
	return false;
}
int main()
{
	cin>>n;
	int tot = 0;
	for(int i = 1;i<=n;i++)
	{
		string s;
		cin>>s;
		for(int j = 0;j<s.size();j++)
		{
			mp[i][j + 1] = s[j] - '0';	
			if((i + j + 1) %2 != 0 && !mp[i][j+1])
			{
				bcnt++;
				tar[i][j+1] = bcnt;
				tot ++;
			}
			else if((i + j + 1) % 2 ==0 && !mp[i][j+1])
			{
				wcnt++;
				tot ++;
				tar[i][j+1] = wcnt;
			}
		}	
	}	
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=n;j++)
		{
			if(mp[i][j] == 1 || (i + j) % 2 == 0)
			{
				continue;
			}
			for(int k = 0;k<8;k++)
			{
				int nx = i + dx[k];
				int ny = j + dy[k];
				if(nx >= 1 && nx <= n && ny >= 1 && ny <= n)
				{
					if(mp[nx][ny])
					{
						continue;	
					} 
					v[tar[i][j]].push_back(tar[nx][ny]);
				}
			}
		}
	}
	int cnt = 0;
	for(int i = 1;i<=bcnt;i++)
	{
		vis.assign(wcnt + 2,0);
		if(dfs(i))
		{
			cnt++;
		}
	}
	cout<<tot - cnt<<endl;
	return 0;
}
