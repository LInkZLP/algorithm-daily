#include <bits/stdc++.h>
using namespace std;
int n;
int m;
const int maxn = 3e5+5;
vector<int>mp(1e6+5);
vector<int>val(maxn);
vector<long long>sum(maxn<<2);
vector<long long>mx(maxn<<2);
int ml = 0;
void init()
{
	for(int i = 1;i<1e6+5;i++)
	{
		for(int j = i;j<1e6+5;j+=i)
		{
			mp[j] ++;
		}
	}
	return;
}
void up(int i)
{
	sum[i] = sum[i<<1] + sum[i<<1|1];
	mx[i] = max(mx[i<<1],mx[i<<1|1]);
	return;
}
void build(int l,int r,int i)
{
	if(l == r)
	{
		sum[i] =mx[i]= val[l];
		return;
	}
	int mid = (l + r)>>1;
	build(l,mid,i<<1);
	build(mid + 1,r,i<<1|1);
	up(i);
	return;
}
void change(int l,int r,int i,int jobl,int jobr,long long jobv)
{
	if(mx[i] <= 2)
	{
		return;
	}
	if(l == r)
	{
		int nu = mp[mx[i]];
		sum[i] = mx[i] = nu;
		return;
	}
	int mid = (l + r)>>1;
	if(mid >= jobl)
	{
		change(l,mid,i<<1,jobl,jobr,jobv);
	}
	if(mid + 1 <=jobr)
	{
		change(mid + 1,r,i<<1|1,jobl,jobr,jobv); 
	}
	up(i);
	return;
}
long long query(int l,int r,int i,int jobl,int jobr)
{
	if(l >= jobl && r <=jobr)
	{
		return sum[i];
	}
	int mid = (l + r)>>1;
	long long ans = 0;
	if(mid >= jobl)
	{
		ans += query(l,mid,i<<1,jobl,jobr);
	}
	if(mid + 1 <=jobr)
	{
		ans += query(mid + 1,r,i<<1|1,jobl,jobr); 
	}
	return ans;
}
int main()
{
	ios::sync_with_stdio(false); cin.tie(nullptr);
	cin>>n>>m;
	for(int i = 1;i<=n;i++)
	{
		cin>>val[i];
		ml = max(val[i],ml);
	}
	init();
	build(1,n,1);
//	cout<<sum[1]<<endl;
	for(int i = 1;i<=m;i++)
	{
		int op;
		cin>>op;
		if(op == 1)
		{
			int l;
			int r;
			cin>>l>>r;
			change(1,n,1,l,r,0);
		}
		else
		{
			int l;
			int r;
			cin>>l>>r;
			cout<<query(1,n,1,l,r)<<endl;
		}
	}
	return 0;
}
