#include <bits/stdc++.h>
using namespace std;
void solve()
{
	int n;
	int k;
	cin>>n>>k;
	vector<string>v(k + 5);
	vector<int>mask(n + 5); 
	for(int i = 1;i<=k;i++)
	{
		cin>>v[i];
	}
	for(int i = 1;i<=n;i++)
	{
		for(int j = 1;j<=k;j++)
		{
			int p = v[j][i - 1] - 'a';
			mask[i] |= (1<<p);
		}
	}
	vector<int>fa;
	for(int i = 1;i * i <= n;i++)
	{
		if(n % i == 0)
		{
			fa.push_back(i);
			if(i != n / i)
			{
				fa.push_back(n/i);
			}
		}
	}
	sort(fa.begin(),fa.end());
	for(int d : fa)
	{
		bool pass = true;
		vector<char>ans(n + 5);
		if(n % d != 0)
		{
			continue;
		}
		for(int i = 1;i<=d;i++)
		{
			int p = (1<<27) - 1;
			for(int sta = i;sta <= n;sta +=d)
			{
				p &= mask[sta];
			}
			if(p == 0)
			{
				pass = false;
				break;
			}
			int cnt = 0;
			while(p)
			{
				if(p & 1)
				{
					break;
				}
				cnt++;
				p >>= 1;
			}
			for(int sta = i;sta<= n;sta +=d)
			{
				ans[sta] = 'a' + cnt;
			}
		}
		if(pass)
		{
			for(int i = 1;i<=n;i++)
			{
				cout<<ans[i];
			}
			cout<<endl;
			return;
		}
	}
	return;
}
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		solve();
	}
	
	return 0;
}
