#include <bits/stdc++.h>
using namespace std;
int n;
int k;
long long sum = 0;
unordered_map<int,int>mp;
const int maxn = 50005;
vector<int>dep(maxn);
vector<int>sz(maxn);
vector<int>son(maxn);
vector<vector<int>>v(maxn);
void query(int u,int p,int lca)
{
	int kt = k + 2 * dep[lca] - dep[u];
	if(mp.find(kt) != mp.end())
	{
		sum += mp[kt];
	}
	//cout<<u<<" "<<p<<" "<<lca<<" "<<mp[kt]<<" "<<sum<<endl;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		query(ed,u,lca);
	}
	return;
}
void add(int u,int p,int lca)
{
	mp[dep[u]] ++;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		add(ed,u,lca);
	}
	return;
}
void cancel(int u,int p)
{
	mp[dep[u]] --;
	if(mp[dep[u]] == 0)
	{
		mp.erase(dep[u]);
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		cancel(ed,u);
	}
	return;
}
void dfs1(int u,int p)
{
	sz[u] ++;
	int tar = 0;
	int mxl = 0;
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == p)
		{
			continue;
		}
		dep[ed] = dep[u] + 1;
		dfs1(ed,u);
		sz[u] += sz[ed];
		if(mxl < sz[ed])
		{
			mxl = sz[ed];
			tar = ed;
		}
	}
	son[u] = tar;
	return;
}
void dfs2(int u,int keep,int p,int lca)
{
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == son[u] || ed == p)
		{
			continue;
		}
		dfs2(ed,0,u,lca);
	}
	if(son[u] != 0)
	{
		dfs2(son[u],1,u,u);
	}
	for(int i = 0;i<v[u].size();i++)
	{
		int ed = v[u][i];
		if(ed == son[u] || ed == p)
		{
			continue;
		}
		query(ed,u,u);
		add(ed,u,u);
	}
	int kt = k + 2 * dep[u] - dep[u];
	if(mp.find(kt) != mp.end())
	{
		sum += mp[kt];
	}
	//cout<<u<<" "<<sum<<endl;
	mp[dep[u]] ++;
	if(keep == 0)
	{
		cancel(u,p);
	}
	return;
}
void solve()
{
	cin>>n>>k;
	for(int i = 1;i<=n - 1;i++)
	{
		int x;
		int y;
		cin>>x>>y;
		v[x].push_back(y);
		v[y].push_back(x);
	}
	dep[1] = 1;
	dfs1(1,0);
	dfs2(1,1,0,1);
	cout<<sum<<endl;
	return ;
}
int main()
{
	int t = 1;
	//cin>>t;
	while(t--)
	{
		solve();
	}	

	return 0;
}
