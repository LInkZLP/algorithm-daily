#include <bits/stdc++.h>
using namespace std;

void solve()
{
	int n;
	cin >> n;
	vector<int> v(n + 5);
	for(int i = 1; i <= n; i++)
	{
		cin >> v[i];
	}

	// 这题最大的坑：不能移动的人反而赢，和普通博弈是反的
	//
	// 我们定义 f(i) = 筹码在位置 i，轮到当前玩家动时，当前玩家能不能赢
	//   - 如果 i 左边没有比它小的数 → 动不了 → 不能动者赢 → f(i) = True
	//   - 如果 i 左边有比它小的数（有出边），当前玩家会挑一个走：
	//       只要存在一个出边 j 满足 f(j) = False（对手必败），那我就能赢
	//       如果所有出边都是 f(j) = True（对手必胜），那我必败 → f(i) = False
	//
	// Alice 先手放筹码，之后轮到 Bob 动。Alice 想赢，就得让 Bob 在 i 必败
	// 所以「幸运元素」= 所有 f(i) = False 的位置

	int mi_va = 1e7;   // 前缀最小值（判断"有没有出边"）
	int mi_f  = 1e7;   // 所有 f = False 的元素里，值最小的那个

	int sum = 0;       // 统计幸运元素个数

	for(int i = 1; i <= n; i++)
	{
		int x = v[i];

		// 情况一：x 是当前前缀里最小的 → 左边没有比 x 小的数
		// → 动不了 → f(i) = True → 不是幸运元素
		if(x < mi_va)
		{
			mi_va = x;
		}
		// 情况二：x 左边有比它小的数（有出边），要看出边里有没有 f = False
		//
		// 关键：出边都是"比 x 小的数"，而 mi_f 是 f = False 里值最小的那个
		//   - 如果 mi_f < x，说明存在一个 f = False 的出边，我能走上去 → f(i) = True
		//   - 如果 mi_f >= x，说明所有 f = False 的值都 >= x，x 够不到它们
		//     也就是所有出边都是 f = True，那我必败 → f(i) = False，是幸运元素
		else
		{
			if(mi_f >= x)
			{
				sum++;                          // 找到一个幸运元素
				mi_f = min(mi_f, x);            // 更新"必败元素中的最小值"
			}
		}
	}

	cout << sum << endl;
	return;
}

int main()
{
	int t;
	cin >> t;
	while(t--)
	{
		solve();
	}
	return 0;
}
