#include <bits/stdc++.h>
using namespace std;

/*
==================== 证明思路 ====================

1. 操作等价于总和比较
   初始硬币为 0。
   增加元素 1：消耗 1 硬币；减少元素 1：获得 1 硬币。
   设原保留数组总和为 S，最终理想数组总和为 S'。
   每次操作保持“元素总和 + 硬币数”不变，初始硬币为 0，所以
       S = S' + 最终硬币数 >= S'
   即 S' <= S。
   反过来，只要 S' <= S，一定可以做到：
   先把需要减小的元素减到目标值，获得足够硬币；
   再把需要增大的元素加到目标值。
   因为总获得 >= 总消耗，过程中不会欠硬币。
   因此：一个数组能变成理想数组 ⇔ 存在一个理想数组，其总和 <= 原数组总和。

2. 理想数组的最小总和是前 k 个质数之和
   若理想数组有 k 个元素，每个元素 >= 2，且两两互质。
   设这 k 个数从小到大为 c1 <= c2 <= ... <= ck。
   c1 >= 2，即第 1 个质数；
   c2 不能含有质因数 2，否则与 c1 不互质，所以 c2 >= 3，即第 2 个质数；
   c3 不能含有 2、3，所以 c3 >= 5；
   依此类推，ci >= 第 i 个质数。
   因此总和至少为 pre[k] = p1 + p2 + ... + pk。
   而前 k 个质数本身两两互质且都 >= 2，所以它们就是总和最小的理想数组。

3. 保留 k 个元素时，一定保留最大的 k 个
   固定要保留 k 个元素。为了让总和尽可能大，显然应选最大的 k 个。
   如果最大的 k 个之和都小于 pre[k]，那么任意 k 个之和更小，不可能满足条件。
   如果最大的 k 个之和 >= pre[k]，那么保留这 k 个，用前 k 个质数作为目标理想数组，
   总和 pre[k] 不超过保留总和，因此可行。
   所以：保留 k 个元素可行 ⇔ 最大的 k 个元素之和 >= pre[k]。

4. 枚举删除个数 i
   先将数组升序排序，前缀和 pp。
   删除最小的 i 个后，剩余的就是最大的 n-i 个，其总和为
       sum = pp[n] - pp[i]
   此时保留个数 k = n-i，需要检查 pre[n-i] <= sum。
   代码用二分找到最大的 tar，使得 pre[tar] <= sum。
   因为 pre 单调递增，所以如果 tar >= n-i，
   就说明 pre[n-i] <= pre[tar] <= sum，即可行。
   枚举 i 从 0 到 n，第一个满足的 i 就是最少删除数。

5. 为什么一定不会死循环或漏解
   i = n-1 时，剩余 1 个元素，其值 >= 2，而 pre[1] = 2，所以一定满足。
   因此最少删除数最多是 n-1。
   i 从小到大枚举，第一个满足的就是最小删除数。

6. 复杂度
   筛质数到 6e6：约 O(M log log M)，完全够用。
   每个测试用例排序：O(n log n)。
   每个 i 二分一次：O(log P)，P 为质数个数。
   总复杂度 O(Σ n log n + M log log M)，满足题目限制。

总结一句话：
   删除最小的 i 个后，剩余最大的 n-i 个总和最大；
   若这个总和 >= 前 n-i 个质数之和，就能变成理想数组。
   从 i=0 开始枚举，第一个满足的 i 就是答案。

=================================================
*/

vector<int> inv(6e6 + 6, 1);        // inv[i] = 1 表示 i 是质数（初始假设），筛法标记非质数
vector<long long> pl;               // 存储质数，pl[0] 占位，从 pl[1] 开始为第 1 个质数
int ss = 0;                         // 质数个数
vector<long long> pre(6e6);         // pre[i] = 前 i 个质数之和

// 筛质数并计算前缀和
void init()
{
    inv[1] = 0;                     // 1 不是质数
    pl.push_back(0);                // 占位，使 pl[1] 是第一个质数 2
    for (int i = 2; i <= 6e6; i++)
    {
        if (inv[i] == 0)            // 已被标记为合数
        {
            continue;
        }
        pl.push_back(i);            // i 是质数
        for (int j = 2; j * i <= 6e6; j++)
        {
            inv[i * j] = 0;         // 标记 i 的倍数为合数
        }
    }
    ss = pl.size() - 1;             // 质数总个数
    for (int i = 1; i <= ss; i++)
    {
        pre[i] = pre[i - 1] + pl[i]; // 前缀和：前 i 个质数之和
    }
    return;
}

void solve()
{
    int n;
    cin >> n;
    long long sum = 0;
    vector<long long> pp(n + 5);    // pp[i] = 前 i 个元素之和（排序后）
    vector<long long> v(n + 5);
    for (int i = 1; i <= n; i++)
    {
        cin >> v[i];
    }

    // 升序排序，方便取最大的 k 个元素
    sort(v.begin() + 1, v.begin() + 1 + n);

    // 计算前缀和
    for (int i = 1; i <= n; i++)
    {
        pp[i] = pp[i - 1] + v[i];
    }

    // 枚举删除的元素个数 i（删除最小的 i 个）
    // 剩余元素为最大的 n-i 个，总和为 pp[n] - pp[i]
    for (int i = 0; i <= n; i++)
    {
        int ans = i;                            // 当前删除个数
        sum = pp[n] - pp[i];                    // 剩余元素总和
        int l = 1;
        int r = ss;
        int tar = -1;                           // 最大的满足 pre[tar] <= sum 的 tar
        while (r >= l)
        {
            int mid = (r + l) >> 1;
            if (pre[mid] <= sum)                // 注意：<= 而不是 <
            {
                tar = mid;
                l = mid + 1;
            }
            else
            {
                r = mid - 1;
            }
        }
        // 如果前 n-i 个质数之和 <= 剩余总和，则保留 n-i 个可行
        if (tar >= n - i)
        {
            cout << ans << endl;                // 第一个满足的 i 就是最少删除数
            return;
        }
    }
    // 理论上不会执行到这里，因为 i = n-1 时一定满足（剩余 1 个元素 >= 2，pre[1] = 2）
    return;
}

int main()
{
    int t;
    cin >> t;
    init();                                     // 预处理质数前缀和
    while (t--)
    {
        solve();
    }
    return 0;
}
